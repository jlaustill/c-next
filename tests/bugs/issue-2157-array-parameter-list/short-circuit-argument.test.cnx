// test-execution
// #2161 review: a list passed for an array parameter is evaluated where it
// stands, as any argument is. Under `&&` and `?:` it is not evaluated when
// its operand is not, so `bump()` runs only where the call does.
mut u32 calls <- 0;

u8 bump() {
    calls <- calls + 1;
    return 1;
}

u32 sumTwo(u8[2] b) {
    return b[0] + b[1];
}

u32 probe(u32 i) {
    bool ok <- i < 2 && sumTwo([bump(), 0]) > 0;
    u32 t <- (i < 2) ? sumTwo([bump(), 0]) : 0;
    if (ok = true) {
        return t;
    }
    return 0;
}

u32 main() {
    u32 skipped <- probe(5);
    if (skipped != 0) {
        return 1;
    }
    if (calls != 0) {
        return 2;
    }
    u32 taken <- probe(1);
    if (taken != 1) {
        return 3;
    }
    if (calls != 2) {
        return 4;
    }
    return 0;
}
