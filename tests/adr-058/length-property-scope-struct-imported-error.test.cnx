// test-error
// test-adr: 058
// #1661 across ONE include hop -- matrix cell: scope method / imported direct.
// The scope-declared struct is in the included file, so the subject's type is
// found only through the include. When it was not, `.length` reached render's
// internal invariant and failed uncoded at 1:0 instead of E0886.

#include "length-scope-struct.cnx"

scope S {
    L.Cfg cfg;

    // THE ASSERTION.
    public u32 n() {
        return this.cfg.data.length;
    }

    // NEGATIVE CONTROL -- the right property on the imported field stays silent.
    public u32 ok() {
        return this.cfg.data.element_count;
    }
}
