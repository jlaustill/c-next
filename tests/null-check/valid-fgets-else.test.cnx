// ADR-046: Valid NULL check with else branch using c_ prefix
#include <stdio.h>

string<128> line;

void processLine() {
    cstring c_result <- fgets(line, line.size, stdin);
    if (c_result != NULL) {
        (void) printf("Read: %s", line);
    } else {
        (void) printf("No more input\n");
    }
}
