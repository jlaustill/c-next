mut u8 PIN_MUT <- 10;
u8 PIN_FIXED <- 11;

// NEGATIVE CONTROL -- a read-only argument is accepted.
Adafruit_MAX31856 okGlobal(PIN_FIXED);

Adafruit_MAX31856 badGlobal(PIN_MUT);
Adafruit_MAX31856 missingGlobal(PIN_NONE_GLOBAL);

scope Sensor {
    public Adafruit_MAX31856 okMember(PIN_FIXED);
    public Adafruit_MAX31856 badMember(PIN_MUT);
    public Adafruit_MAX31856 missingMember(PIN_NONE_MEMBER);

    public void init() {
        Adafruit_MAX31856 okMethodLocal(PIN_FIXED);
        Adafruit_MAX31856 badMethodLocal(PIN_MUT);
        Adafruit_MAX31856 missingMethodLocal(PIN_NONE_METHOD);
    }
}

void main() {
    Adafruit_MAX31856 okLocal(PIN_FIXED);
    Adafruit_MAX31856 badLocal(PIN_MUT);
    Adafruit_MAX31856 missingLocal(PIN_NONE_FUNCTION);
    Sensor.init();
