// test-execution
// #1760 review: `.type_bit_length` and `.type_byte_length` of an array whose dimension
// is a C macro were emitted as a literal 0, behind a comment naming the
// dimension; `.type_element_count` already kept the macro. The product is C's to
// fold now, in every dimension. A `bool` array's bits are no whole bytes, so
// its bytes round up (ADR-058). The fixed-size array is the control, whose
// lengths were already folded.
#include "sizes.h"

u8[BUF_SIZE] buf;
u16[2][BUF_SIZE] grid;
u8[4] fixed;
bool[BUF_SIZE] flags;

u32 main() {
    u32 bits <- buf.type_bit_length;
    u32 bytes <- buf.type_byte_length;
    u32 gridBits <- grid.type_bit_length;
    u32 gridBytes <- grid.type_byte_length;
    u32 rowBits <- grid[0].type_bit_length;
    u32 count <- buf.type_element_count;
    u32 fixedBits <- fixed.type_bit_length;
    u32 flagBits <- flags.type_bit_length;
    u32 flagBytes <- flags.type_byte_length;
    if (bits != 48) {
        return 1;
    }
    if (bytes != 6) {
        return 2;
    }
    if (gridBits != 192) {
        return 3;
    }
    if (gridBytes != 24) {
        return 4;
    }
    if (rowBits != 96) {
        return 5;
    }
    if (count != 6) {
        return 6;
    }
    if (fixedBits != 32) {
        return 7;
    }
    if (flagBits != 6) {
        return 8;
    }
    if (flagBytes != 1) {
        return 9;
    }
    return 0;
}
