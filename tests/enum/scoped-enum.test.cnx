// ADR-017: Scoped Enum Test
// Tests enums declared inside scopes with proper prefixing
u8 defaultValue <- 3;

scope Motor {
    public enum State {
        IDLE,
        RUNNING,
        STALLED
    }
    u8 defaultValue <- 1;
    public mut this.State current <- this.State.IDLE; // This is a default value
    public u8 start() {
        this.current <- this.State.RUNNING;

        return this.defaultValue;
    }
    public u8 stop() {
        this.current <- this.State.IDLE;

        return global.defaultValue;
    }
    public bool isRunning() {
        this.State currentState <- this.current;
        if (currentState = this.State.RUNNING) {
            return true;
        }
        return false;
    }
}

// Usage from outside the scope
mut Motor.State externalState <- Motor.State.IDLE;

void main() {
    (void)Motor.start();

    if (Motor.current = Motor.State.RUNNING) {
        externalState <- Motor.State.STALLED;
    }
}
