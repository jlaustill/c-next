// test-error
// Tests: a string literal does not land in an integer: a declaration, an
// assignment, an argument and a return are all rejected

u32 take(u32 v) {
    return v;
}

u32 give() {
    return "r";
}

u32 g <- "hello";

void main() {
    u32 x <- "hi";
    x <- "assign";
    u32 y <- take("arg");
}
