// test-error
// #1283 review: ADR-029 gives every element of a callback array its default
// function, so C-Next must know how many elements there are. A macro whose
// value C-Next cannot read (a sizeof) is rejected at the dimension -- with the
// dimension on either side of the name, and for a scope-nested struct with a
// default named bare (#1283 review: 2.1 and render resolve the same type).
#include "handler_sizes.h"

u32 onSample(u32 input) {
    return input + 1;
}

struct Bank {
    onSample[N_UNREADABLE] handlers;
    onSample spares[N_UNREADABLE];
}

scope Pump {
    public struct Stage {
        onSample handler;
    }

    Stage[N_UNREADABLE] stages;

    public u32 first() {
        u32 input <- 1;
        return this.stages[0].handler(input);
    }
}

// File scope: a local's read before assignment is E0381 (ADR-015, #1980),
// which 2.1 would report first
Bank b;

u32 main() {
    u32 input <- 1;
    return b.handlers[0](input);
}
