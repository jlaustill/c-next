// test-execution
// test-adr: 057
// Issue #1724, SINGLE-FILE CONTROL: motor-uses-ext.cnx with motor-config.cnx
// absent from the run. `Config` can only be the C typedef here, and it was
// already right before the fix -- the defect needed the sibling in the run.
//
// motor-uses-ext's generated files are shared with both sibling-declared-*
// fixtures, and the harness fails the suite when two fixtures generate one
// helper differently. So this entry also pins that helper's output to NOT
// depend on whether an unrelated file is in the same run.
#include "ext_config.h"
#include "motor-uses-ext.cnx"

i32 main() {
    Config theirs <- { a: 3, b: 4 };
    i32 fromTheirs <- Motor.useTheirs(theirs);
    if (fromTheirs != 3) {
        return 1;
    }

    return 0;
}
