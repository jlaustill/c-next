// test-error
// test-adr: 026
// Bug #1011: continue is not part of C-Next — use structured conditions
//
// NEGATIVE CONTROL -- the structured form: the skipped case is an `if`
// around the work, not an exit.
void structured() {
    for (u32 i <- 0; i < 10; i +<- 1) {
        if (i != 5) {
            u32 v <- i;
        }
    }
}

void demo() {
    for (u32 i <- 0; i < 10; i +<- 1) {
        if (i = 5) {
            continue;
        }
    }
}

scope Worker {
    public void run() {
        for (u32 i <- 0; i < 10; i +<- 1) {
            if (i = 5) {
                continue;
            }
        }
    }
}
