// test-error
// test-adr: 024
// E0891 in the SAME file -- matrix cells: same file, in all four contexts.
// A float reaches an integer only through a cast (#1800).

f32 floatLocal <- 2.5;

// NEGATIVE CONTROL -- the explicit cast, which saturates.
u32 castAtFileScope <- (u32)floatLocal;

// ASSERTION -- global variable context.
u32 atFileScope <- floatLocal;

void f() {
    // ASSERTION -- top-level function context.
    u32 local <- floatLocal;
}

scope S {
    f32 scale <- 1.5;

    // ASSERTION -- scope member context.
    u32 member <- this.scale;

    public void method() {
        // ASSERTION -- scope method context.
        u32 inside <- this.scale;
    }
}
