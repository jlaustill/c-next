// test-execution
// test-adr: 071
// ADR-071 Decision 3: a `mut` parameter's C signature follows its
// declaration, never its body. `onPoke` and `lazy` never write `p`,
// `viaMember` writes it only through a member passed to a `mut` parameter,
// and `forward` only hands it to a callback. Each keeps `Point*`, matching
// `onPoke_fp`, so the C and C++ compile and every write reaches the caller.
struct Point {
    u32 x;
    u32 y;
}

void onPoke(mut Point p) {
}

void impl(mut Point p) {
    p.x <- 1;
}

void lazy(mut Point p) {
}

struct Handler {
    onPoke poke;
}

void bump(mut u32 v) {
    v <- v + 1;
}

void viaMember(mut Point p) {
    bump(p.x);
}

void forward(Handler hh, mut Point p) {
    hh.poke(p);
}

u32 main() {
    mut Handler h;
    h.poke <- lazy;
    h.poke <- impl;
    mut Point pt <- {x: 0, y: 0};
    forward(h, pt);
    if (pt.x != 1) {
        return 1;
    }
    viaMember(pt);
    if (pt.x != 2) {
        return 2;
    }
    return 0;
}
