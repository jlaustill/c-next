// test-execution
// #1664 box 7: a const is bound where it is used. `first()` declares a local
// `const N <- 2`; `second()` sizes an array by the GLOBAL `N`, 8. The render
// walk wrote the local into one flat map and never restored the global, so
// `second()` emitted `uint8_t buf[2]` and wrote past it.
const u32 N <- 8;

u32 first() {
    const u32 N <- 2;
    u32 x <- N;
    return x;
}

u32 second() {
    u8[N] buf;
    buf[7] <- 7;
    u32 n <- buf.element_count;
    u32 last <- buf[7];
    return n + last;
}

u32 main() {
    u32 local <- first();
    if (local != 2) {
        return 1;
    }
    u32 n <- second();
    if (n != 15) {
        return 2;
    }
    return 0;
}
