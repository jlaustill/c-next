// test-adr: 051
// test-error
// #1770: a compound division or modulo by a compile-time zero is the same
// division by zero as the binary operator (ADR-051 section 1). At a2f390fdf
// each flagged row exited 0 and emitted x /= 0U or x %= 0U.
//
// NEGATIVE CONTROLS: x /<- 2, x %<- 3, y /<- 2.0, x /<- (2 - 1) stay silent.

const u32 ZERO <- 0;

u32 literal() {
    u32 x <- 10;
    x /<- 0;
    x %<- 0;
    x /<- 2;
    x %<- 3;
    return x;
}

u32 named() {
    u32 x <- 10;
    x /<- ZERO;
    x %<- ZERO;
    return x;
}

u32 header() {
    u32 x <- 10;
    for (x /<- 0; x < 5; x %<- ZERO) {
        x +<- 1;
    }
    return x;
}

f32 floating() {
    f32 y <- 10.0;
    y /<- 0.0;
    y /<- -0.0;
    y /<- 2.0;
    return y;
}

u32 folded() {
    u32 x <- 10;
    x /<- (1 - 1);
    x %<- (u32)0;
    x /<- (2 - 1);
    return x;
}
