// test-error
// #1863 review: a member an enum does not have was reported by nothing --
// E0427 reports a bare undeclared name. The header dropped the enum's members
// at exit 0. It is E0909 at the member. A divisor that is zero only once
// computed is E0800's (ADR-051), in enum-zero-divisor.test.cnx.
//
// NEGATIVE CONTROL: `C`, which names a member F has.

enum F {
    X
}
enum E {
    A,
    B <- F.NOPE,
    C <- (i32)F.X + 1
}

void main() {}
