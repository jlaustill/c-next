// test-error
// test-adr: 025
// #2051: ADR-025 admits only constants as case labels. A label naming a
// variable, a function or a scope reached the C as a name gcc rejects, at
// exit 0, in every spelling. Each flagged label sits beside a const, an enum
// member and a literal in the same switch, which stay silent. A label naming
// a type (#2069) or a const with no C constant value (a string) is E0717 too,
// as is a chain through a struct or a bitmap (#2072) in any spelling, and
// through a scope's struct, bitmap or register reached from outside it
// (#2108), beside `Panel.State.STOPPED`, a scope's enum, which stays silent.
u8 counter <- 2;
const u8 REAL <- 1;

enum EMode {
    IDLE,
    RUN
}

struct Pt {
    u8 x;
}

bitmap8 Bits {
    a,
    b,
    c,
    d,
    e,
    f,
    g,
    h
}

scope Panel {
    u8 level <- 1;
    const u8 OWN <- 3;
    public const string<4> S <- "ab";

    public enum State {
        STOPPED,
        GOING
    }

    bitmap8 Flags {
        a,
        b,
        c,
        d,
        e,
        f,
        g,
        h
    }

    public u8 helper() {
        return 1;
    }

    public u32 rooted(u8 s) {
        switch (s) {
            case this.OWN || global.REAL || 9 {
                return 1;
            }
            case this.helper {
                return 2;
            }
            case this.level {
                return 3;
            }
            case global.counter {
                return 4;
            }
            case global.Panel {
                return 5;
            }
            default {
                return 0;
            }
        }
    }

    public u32 typed(u8 s) {
        switch (s) {
            case this.OWN || global.REAL || 7 {
                return 1;
            }
            case this.State {
                return 2;
            }
            case global.EMode || global.Pt {
                return 3;
            }
            case this.Flags {
                return 4;
            }
            case this.S {
                return 5;
            }
            case global.Pt.x || this.Flags.a {
                return 6;
            }
            default {
                return 0;
            }
        }
    }

    public u32 bare(u8 s) {
        switch (s) {
            case OWN || REAL || 'a' {
                return 1;
            }
            case level || helper || counter {
                return 2;
            }
            default {
                return 0;
            }
        }
    }
}

u32 qualified(u8 s, u8 p) {
    u8 m <- 2;
    switch (s) {
        case Panel.level {
            return 1;
        }
        case p || m {
            return 2;
        }
        case REAL || 0x10 {
            return 3;
        }
        default {
            return 0;
        }
    }
}

u32 typedOutside(u8 s) {
    switch (s) {
        case Panel.OWN || REAL || 8 {
            return 1;
        }
        case Panel.State || EMode || Pt {
            return 2;
        }
        case Panel.S {
            return 3;
        }
        case EMode.RUN || Pt.x || Bits.a {
            return 4;
        }
        default {
            return 0;
        }
    }
}

scope Board {
    public struct Spot {
        u8 x;
    }

    public bitmap8 Pins {
        a,
        b,
        c,
        d,
        e,
        f,
        g,
        h
    }

    public register GPIO @ 0x40000000 {
        DR: u32 rw @ 0x00,
    }
}

u32 throughScope(u8 s) {
    switch (s) {
        case REAL {
            return 1;
        }
        case Board.Spot.x || Board.Pins.a || Board.GPIO.DR {
            return 2;
        }
        default {
            return 0;
        }
    }
}

u32 throughScopeEnum(Panel.State st) {
    switch (st) {
        case Panel.State.STOPPED {
            return 1;
        }
        default(1) {
            return 0;
        }
    }
}

u32 onState(Panel.State st) {
    switch (st) {
        case Panel.State.STOPPED {
            return 1;
        }
        case Panel.State.GOING {
            return 2;
        }
    }
    return 0;
}

u32 onEnum(EMode e) {
    switch (e) {
        case EMode.IDLE {
            return 1;
        }
        case RUN {
            return 2;
        }
    }
    return 0;
}

u32 main() {
    u32 a <- Panel.rooted(1);
    u32 b <- Panel.bare(1);
    u32 c <- qualified(1, 2);
    u32 d <- onEnum(EMode.IDLE);
    u32 t <- Panel.typed(1);
    u32 o <- typedOutside(1);
    u32 q <- onState(Panel.State.STOPPED);
    u32 g <- throughScope(1);
    u32 h <- throughScopeEnum(Panel.State.GOING);
    return a + b + c + d + t + o + q + g + h;
}
