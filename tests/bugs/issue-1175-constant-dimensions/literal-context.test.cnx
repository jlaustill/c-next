// test-execution
// #1863 review / ADR-044 "Integer Literals" (owner ruling, 2026-10-03): a
// literal takes the smallest type that fits its context at compile time.
// `i64 big <- 2147483647 + 1` was written as `2147483647 + 1` -- int overflow
// in C, exit 1 -- once render's fold moved onto the evaluator, which typed
// the literals i32; main wrote 2147483648. A const settles at its declared
// type, so `3000000000 + 1` in a u32 has a value (main sized `b` 3, the PR
// rejected it), and a u64 const keeps its value past 2^53.
//
// NEGATIVE CONTROL: `small`, whose literals fit i32 anyway.

const u32 BIG <- 3000000000 + 1;
u8[BIG / 1000000000] b;
const u64 MASK <- 0xFFFFFFFFFFFFFFFF;

u32 main() {
    // A local const: at file scope C rejects `TOP = MASK >> 60` (#1735)
    const u64 TOP <- MASK >> 60;
    u8[TOP] fifteen;
    i64 big <- 2147483647 + 1;
    i64 prod <- 65536 * 65536;
    i32 small <- 2 + 3;
    if (big != 2147483648) {
        return 1;
    }
    if (prod != 4294967296) {
        return 2;
    }
    if (small != 5) {
        return 3;
    }
    b[0] <- 1;
    if (b.element_count != 3) {
        return 4;
    }
    fifteen[0] <- 1;
    if (fifteen.element_count != 15) {
        return 5;
    }
    return 0;
}
