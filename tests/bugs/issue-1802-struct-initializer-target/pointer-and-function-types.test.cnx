// test-error
// #1760 second review: E0358 asked "is this type known NOT to be a struct?",
// so a type with no category passed: a header's pointer typedef, a header's
// function-pointer typedef, and an ADR-029 function type. Each emitted a
// designated initializer C rejects. It now asks "is this a struct?". A
// header union, and a typedef whose struct is recorded under its tag, still
// take a field list: those are the controls.
#include "handle-types.h"

void handler() {}

u32 main() {
    Handle h <- { a: 1 };
    cb_t cb <- { a: 1 };
    handler hc <- { a: 1 };
    Num n <- { i: 1 };
    Tagged t <- { a: 1 };
    return 0;
}
