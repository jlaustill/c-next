// test-execution
// test-adr: 057
// #2011 control: the same local one block deeper is shadowing, which C allows
u32 total <- 7;

u32 shadowing(u32 total) {
    u32 result <- total;
    if (total > 0) {
        u32 total <- 3;
        result <- total + global.total;
    }
    return result;
}

u32 main() {
    u32 got <- shadowing(1);
    if (got != 10) {
        return 1;
    }
    return 0;
}
