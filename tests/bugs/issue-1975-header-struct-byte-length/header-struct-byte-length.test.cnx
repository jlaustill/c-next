// test-execution
// Issue #1975 (owner ruling): cnx has no `sizeof`, so a struct from a C
// header answers ADR-058's length properties by cnx's rule: its fields'
// sizes summed, without C padding. `Cfg` is 5 (gcc's `sizeof` is 8), and
// `Outer` is 5 + 6 + 4 = 15 through a nested header struct and an array field.
// The type answers the same as a value of it.
//
// #1867: a length property reads no value, so measuring a field of a local
// that was never written is not a use before initialization (it was E0381).
//
// #1975 review: a header typedef (`word_t`) and a C primitive spelling
// (`uint32_t`) are types too, and size an array dimension the same; and the
// #1867 rule holds for a cnx struct's array field, in `main` and in a
// scope's function. A header struct's `.type_element_count` is its field count, as
// a cnx struct's is, and a length is a case label's number.
//
// #1975 review (owner ruling): a header bit-field is its declared width, as a
// cnx bitmap field is -- `BF.a.type_bit_length` is 3, not its `uint32_t`'s 32 --
// as a value, a dimension and a case label.
//
// NEGATIVE CONTROL: `Point`, a cnx struct, sized by the same rule; and
// `Wrap`, a cnx struct with a header struct's field, sized by it too.
#include "shapes.h"

struct Point {
    u32 x;
    u8 y;
}

// #1975 review: a cnx struct with a header struct's field is sized by the
// one rule, its fields' sizes together: 5 + 1
struct Wrap {
    Cfg c;
    u8 b;
}

u8[Wrap.type_byte_length] wrapBytes;

enum Gear {
    LOW,
    HIGH
}

struct Slots {
    u8[3] f;
}

u8[word_t.type_byte_length] wordBytes;
u8[Gear.type_byte_length] gearBytes;
u8[BF.b.type_bit_length] bfBits;

scope Box {
    public u32 count() {
        Slots s;
        return s.f.type_element_count;
    }
}

u32 sizeName(u32 n) {
    switch (n) {
        case Point.type_byte_length {
            return 1;
        }
        case Gear.type_byte_length {
            return 2;
        }
        case BF.a.type_bit_length {
            return 3;
        }
        default {
            return 0;
        }
    }
}

u32 main() {
    Cfg c;
    Outer o;
    if (Cfg.type_byte_length != 5) {
        return 1;
    }
    if (c.type_byte_length != 5) {
        return 2;
    }
    if (Cfg.type_bit_length != 40) {
        return 3;
    }
    if (Outer.type_byte_length != 15) {
        return 4;
    }
    if (o.arr.type_byte_length != 6) {
        return 5;
    }
    if (o.inner.b.type_byte_length != 1) {
        return 6;
    }
    if (c.a.type_byte_length != u32.type_byte_length) {
        return 7;
    }
    if (Point.type_byte_length != 5) {
        return 8;
    }
    if (Point.x.type_byte_length != 4) {
        return 9;
    }
    if (Wrap.type_byte_length != Cfg.type_byte_length + 1) {
        return 10;
    }
    if (wrapBytes.type_element_count != 6) {
        return 11;
    }
    if (word_t.type_byte_length != 2) {
        return 12;
    }
    if (wordBytes.type_element_count != 2) {
        return 13;
    }
    if (uint32_t.type_byte_length != 4) {
        return 14;
    }
    if (gearBytes.type_element_count != 1) {
        return 15;
    }
    Slots s;
    if (s.f.type_element_count != 3) {
        return 16;
    }
    u32 counted <- Box.count();
    if (counted != 3) {
        return 17;
    }
    u32 named <- sizeName(5);
    if (named != 1) {
        return 18;
    }
    if (Cfg.type_element_count != 2) {
        return 19;
    }
    BF bf;
    if (BF.a.type_bit_length != 3) {
        return 20;
    }
    if (bf.b.type_bit_length != 5) {
        return 21;
    }
    if (bfBits.type_element_count != 5) {
        return 22;
    }
    u32 bitNamed <- sizeName(3);
    if (bitNamed != 3) {
        return 23;
    }
    return 0;
}
