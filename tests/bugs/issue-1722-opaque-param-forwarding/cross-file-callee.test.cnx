// test-execution
// test-no-warnings
// test-link: dev_impl.c
// Issue #1722: the callee is declared in an included `.cnx`, so the call site
// reads its parameter from the symbol table rather than from this file's own
// signatures. Forwarding an opaque-handle parameter still emitted
// `aPoke((*d))` and `Poker__poke((*d))`.
//
// Not marked `test-adr: 030`, unlike its siblings. The one ADR-030 site this
// fixture records is `configure`'s own parameter, in this file, but the matrix
// would credit it to the `direct` row through this file's include depth
// (#1402) -- an occupancy that would move when #1402 is fixed.
#include "dev.h"
#include "poker.cnx"

void configure(Dev d) {
    aPoke(d);
    Poker.poke(d);
}

i32 main() {
    Dev d <- dev_create();

    configure(d);
    i32 pokes <- dev_pokes(d);
    if (pokes != 2) {
        return 1;
    }

    return 0;
}
