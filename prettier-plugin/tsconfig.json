{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "lib": ["ES2020"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "moduleResolution": "node",

    // esbuild produces dist/, not tsc. This config exists only to typecheck.
    // `rootDir` is deliberately unset: the plugin imports the generated parser
    // from ../../src, which no rootDir under prettier-plugin/ can contain.
    "noEmit": true
  },
  "include": ["src/**/*", "tests/**/*"],
  "exclude": ["node_modules", "dist"]
}
