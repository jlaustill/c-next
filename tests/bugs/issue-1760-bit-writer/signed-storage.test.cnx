// test-execution
// #1760 second review: a bit write's operators promote, and the result is
// unsigned, so a signed target takes the MISRA C:2012 Rule 10.3 cast back to
// its type at every width. An `i32` or `i64` target took none.
u32 main() {
    i8 a <- -1;
    a[0, 4] <- 0;
    if (a != -16) return 1;
    i16 b <- -1;
    b[0, 4] <- 0;
    if (b != -16) return 2;
    i32 c <- -1;
    c[0, 4] <- 0;
    if (c != -16) return 3;
    i64 d <- -1;
    d[0, 4] <- 0;
    if (d != -16) return 4;
    i32 e <- 0;
    e[3] <- true;
    if (e != 8) return 5;
    return 0;
}
