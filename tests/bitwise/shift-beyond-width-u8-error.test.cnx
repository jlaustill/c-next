// test-error
// test-coverage: 5.5-shift-beyond-width-error
// Test u8 shift beyond width - should be ERROR (MISRA C:2012 Rule 12.2, E0873)
// Coverage: Section 5.5-5.6 error case - shift beyond type width
//
// #1322 relocated this from `output/`, where it reported `1:0`.
void testU8ShiftBeyondWidth() {
    u8 a <- 1;
    // NEGATIVE CONTROL -- one below the width is the last legal amount.
    u8 ok <- a << 7;
    // u8 is 8 bits, so shifting by 8 or more is undefined/error
    u8 bad_shift <- a << 8; // ERROR: shift amount >= type width
}
