// Issue #1130: bare scope-local type names must be qualified in the .h too.
//
// This reproduction is deliberately MULTI-FILE. When headers are generated,
// only the entry file's symbols are current, so a header layer that resolves
// type names against that shared state emits the bare name for every other
// file — producing a .h that disagrees with its own .c and does not compile.
// A single-file test cannot see that class of bug.
//
// Before the fix, sensors.h emitted:
//     typedef struct Sensors__Reading { uint8_t value; Status status; }
//     extern Status Sensors__current;
//     Status Sensors__pick(void);
// i.e. bare `Status` → "error: unknown type name 'Status'".

enum Mode { idle, busy }

scope Sensors {
    public enum Status { ok, fault }

    // Bare scope-local enum as a struct field type
    public struct Reading { u8 value; Status status; }

    // A field written as global.Mode must NOT be captured by the scope,
    // even though a bare Mode would resolve to a scope-local type elsewhere.
    public struct Tagged { global.Mode mode; u8 id; }

    // Scope variable of a scope-local enum type
    public Status current <- Status.ok;

    // NOTE: a bare scope-local struct *parameter* is deliberately absent here.
    // Cross-file struct parameters are broken independently of #1130 — the .h
    // drops the auto-const and the call site omits the address-of (see #1139).
    // That position is covered single-file by
    // tests/scope/issue-1130-scope-type-qualification.test.cnx instead.

    // Bare scope-local enum as a return type
    public Status pick() {
        return Status.fault;
    }
}
