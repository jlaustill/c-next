// test-adr: 014
// ADR-014: a `for` header's declaration is one of the positions that supplies a
// struct literal's type. Exercised in compiling code, so the generated C is
// snapshotted and validated rather than merely "no diagnostic fired".
//
// The members are UNSIGNED on purpose, and that is a limitation rather than a
// preference. With `i32` members the emitted loop trips MISRA C:2012 Rule 14.2
// -- `for (Point p = (Point){...}; p.x < 7; p.x += 1)` initializes the STRUCT in
// its first clause while the counter is `p.x`, one of its members -- and 14.2 is
// deliberately absent from `scripts/misra-baseline.mjs`'s BASELINE, so a
// compiling fixture in that shape would fail `validate:c` on an enforced rule
// class. #1539 carries that with its reproduction and the three ways it could be
// resolved.
//
// By the letter of 14.2 the unsigned spelling is equally non-well-formed;
// cppcheck reports only the signed one. So this fixture covers the POSITION,
// and #1539 covers the emitted loop's shape. Neither is a substitute for the
// other, which is why both exist.

struct Point {
    u32 x;
    u32 y;
}

u32 main() {
    u32 total <- 0;
    for (Point p <- { x: 0, y: 3 }; p.x < 4; p.x +<- 1) {
        total <- total + p.y;
    }
    if (total != 12) return 1;
    return 0;
}
