{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/lib/parseWithSymbols.ts",
    "scripts/*.ts",
    "prettier-plugin/src/index.ts",
    "prettier-plugin/tests/**/*.test.ts"
  ],
  "project": [
    "src/**/*.ts",
    "scripts/**/*.ts",
    "prettier-plugin/src/**/*.ts",
    "prettier-plugin/tests/**/*.ts"
  ],
  "ignore": [
    "tests/**",
    "src/transpiler/logic/parser/grammar/**",
    "src/transpiler/logic/parser/c/grammar/**",
    "src/transpiler/logic/parser/cpp/grammar/**",
    "src/transpiler/output/codegen/generators/expressions/PostfixExpressionGenerator.ts",
    "src/transpiler/output/codegen/helpers/CppModeHelper.ts",
    "src/transpiler/output/codegen/analysis/StringLengthCounter.ts",
    "src/transpiler/output/headers/types/IHeaderSymbol.ts",
    "prettier-plugin/src/index.ts"
  ],
  "ignoreBinaries": ["jscpd", "jq", "dot"],
  "include": ["classMembers"],
  "ignoreMembers": [
    "generateAtomicRMW",
    "generateFloatBitWrite",
    "analyzeMemberChainForBitAccess",
    "getSymbol"
  ],
  "includeEntryExports": true
}
