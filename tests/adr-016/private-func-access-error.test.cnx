// test-error
// test-adr: 016
// Test: Calling private scope function from outside should error
// This should fail with a visibility error per ADR-016
// Functions are public by default, so we need explicit 'private' keyword

scope Service {
    private void internalHelper() {} // private with explicit keyword
}

// NEGATIVE CONTROL -- a public function of the same scope, called the same way.
void main() {
    Service.internalHelper(); // ERROR: calling private function
}
