// test-error
// test-adr: 024
// E0869 on a COMPOSITE source in a declaration -- category from the first
// integer operand, width from the widest -- and the one place the rule is
// deliberately silent.
//
// Codegen typed a composite on a declaration's initializer and never on an
// assignment statement, and nine fixtures assert the lax path. The relocation
// keeps that divergence rather than closing it: ADR-024 does not say how a
// composite is typed, and rejecting `arr[i] <- i * 10 + j` would be a behavior
// change on code the corpus treats as valid. Raised, not decided.

u32 wide <- 1000;
u8 byte <- 7;

// NEGATIVE CONTROL -- a composite whose widest operand fits.
u32 okWidth <- byte + 1;

// NEGATIVE CONTROL -- a ternary source has literal branches and no declared
// type; a `test-no-warnings` execution fixture asserts this form is fine.
i32 okTernary <- (wide > 0) ? 1 : -1;

// THE ASSERTION -- global variable context. A conversion happens wherever a
// value meets a typed target, and an initializer at file scope is one.
u8 narrowGlobal <- wide;

u32 main() {
    // NEGATIVE CONTROL -- the SAME composite through an assignment statement,
    // which codegen never typed. Kept silent on purpose; see above.
    u8[4] cells;
    cells[0] <- wide + 1;

    // THE ASSERTION -- the composite in a declaration is typed u32, and u32 into
    // u8 is narrowing.
    u8 narrow <- wide + 1;
    return narrow;
}
