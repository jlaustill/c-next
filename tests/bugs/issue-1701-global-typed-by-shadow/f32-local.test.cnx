// test-execution
// #1701: a `u32` global behind an `f32` local is still clamped as a u32. It
// was emitted `x += 1000;` and wrapped to 999.
u32 x <- 4294967295;

f32 f() {
    f32 x <- 1.0;
    global.x +<- 1000;
    return x;
}

u32 main() {
    f32 local <- f();
    if (local != 1.0) {
        return 2;
    }
    if (global.x != 4294967295) {
        return 1;
    }
    return 0;
}
