// test-execution
// test-no-warnings
// test-adr: 029
// #1283 review: a callback array sized by a C macro still holds the default
// function in every element. C-Next reads the macro's integer value from the
// header, so it can spell each element; the dimension stays the macro.
#include "handler_sizes.h"

u32 onSample(u32 input) {
    return input + 1;
}

struct Inner {
    onSample handler;
}

struct Bank {
    onSample[N_HANDLERS] handlers;
    Inner[N_INNERS] inners;
}

Bank globalBank;

// Read through a global: a local's default cannot be read before it is
// assigned (ADR-015, #1980); the local forms are asserted by the snapshots.
Bank b;

u32 main() {
    u32 r <- 0;
    u32 input <- 0;
    input <- 1;
    r <- b.handlers[2](input);
    if (r != 2) {
        return 1;
    }
    input <- 2;
    r <- b.inners[1].handler(input);
    if (r != 3) {
        return 2;
    }
    input <- 3;
    r <- globalBank.handlers[2](input);
    if (r != 4) {
        return 3;
    }
    return 0;
}
