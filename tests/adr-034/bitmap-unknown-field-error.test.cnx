// test-error
// test-adr: 034
// ADR-034: a bitmap is addressed by the fields it declares. Until #1322 this
// was a codegen throw reached only through expression generation, so it
// reported `1:0` and named no position.

bitmap8 Flags {
    Active[1],
    Ready[1],
    Level[3],
    Reserved[3]
}

Flags f <- 0;

// CONTEXT: a global variable's initializer, control then assertion.
u8 okGlobal <- f.Level;
u8 badGlobal <- f.NotAField;

u8 main() {
    // NEGATIVE CONTROLS -- every declared field, read and written, plus the
    // ADR-058 shape properties, which describe the type rather than name a
    // field and must not be reported as unknown.
    f.Active <- 1;
    f.Level <- 5;
    u8 lvl <- f.Level;
    u8 bits <- f.bit_length;
    u8 bytes <- f.byte_length;
    if (lvl != 5) return 1;
    if (bits != 8) return 2;
    if (bytes != 1) return 3;

    // ASSERTIONS -- a read and a write of a field the bitmap does not declare.
    u8 nope <- f.Missing;
    f.AlsoMissing <- 1;
    return 0;
}
