// test-c-only
// #958 (#1668): a variable of an opaque C typedef struct is a pointer,
// declared that way whatever initializes it -- here nothing does. Only the
// create-call form was in the corpus, and there #895's arm reaches the same
// answer, so dropping #958's arm reddened nothing. An opaque type has no size,
// so the non-pointer declaration is one C rejects.
#include "opaque.h"

widget_t gw;

void f() {
    widget_t w;
    w <- widget_create();
    widget_use(w);
    gw <- w;
}
