// test-error
// ADR-013: Error - compound assignment to const i64
// Tests: cannot use compound modulo on const i64 variable
// test-adr: 013

// NEGATIVE CONTROL -- a mutable sibling assigned and passed the same way
// the const one is; only the const target below is reported.
mut u8 ctlMutable <- 0;
void ctlTake(mut u8 v) {
    v <- 1;
}
void ctlAssign() {
    ctlMutable <- 1;
    ctlMutable +<- 1;
    ctlTake(ctlMutable);
}
i64 VALUE <- 1000;

void main() {
    VALUE %<- 7; // ERROR: cannot assign to const variable
}
