// test-error
// test-coverage: 5.5-shift-beyond-width-error
// Test u64 shift beyond width - should be ERROR (MISRA C:2012 Rule 12.2, E0873)
// Coverage: Section 5.5-5.6 error case - shift beyond type width
//
// #1322 relocated this from `output/`, where it reported `1:0`.
void testU64ShiftBeyondWidth() {
    u64 a <- 1;
    // NEGATIVE CONTROL -- one below the width is the last legal amount.
    u64 ok <- a << 63;
    // u64 is 64 bits, so shifting by 64 or more is undefined/error
    u64 bad_shift <- a << 64; // ERROR: shift amount >= type width
}
