// test-execution
// test-no-warnings
// #1737: a write to one element of a struct's string-array field copies into
// that element with the field's string<N> capacity, terminated like every
// string write (#1731)
// #1569: the field is declared char items[3][9], each element string<8>
struct Config {
    string<8>[3] items;
    u32 count;
}

i32 main() {
    mut Config cfg;
    cfg.count <- 3;

    cfg.items[0] <- "hi";
    cfg.items[1] <- "seven c";
    cfg.items[2] <- "";

    if (cfg.items[0] != "hi") {
        return 1;
    }
    if (cfg.items[1] != "seven c") {
        return 2;
    }
    if (cfg.items[2].value_char_count != 0) {
        return 3;
    }
    if (cfg.items[0].value_char_count != 2) {
        return 4;
    }
    if (cfg.items[1].value_char_count != 7) {
        return 5;
    }
    if (cfg.count != 3) {
        return 6;
    }
    if (cfg.items.type_element_count != 3) {
        return 7;
    }

    return 0;
}
