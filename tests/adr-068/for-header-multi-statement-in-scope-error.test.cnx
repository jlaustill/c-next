// test-error
// test-adr: 068
// #1647: E0715 inside a SCOPE METHOD, through `this.` and `global.` targets.
atomic u32 shared <- 0;

scope Link {
    string<8> label <- "a";
    u8[8] frame;
    atomic u32 ticks <- 0;
    f32 level <- 1.0;

    // NEGATIVE CONTROL -- a clamped compound stays legal in a header, and an
    // atomic member or string member is written in the body.
    public void controls() {
        u8 n <- 0;
        for (n <- 0; n < 2; n +<- 1) {
            this.ticks <- 0;
            this.label <- "b";
        }
    }

    // ASSERTIONS 1-6 -- string member, slice member, atomic member (ADR-049
    // Q7 makes `this.ticks +<- 1` atomic; #1179 tracks that it is not yet),
    // a `global.` atomic, a bit write on a float member, and a plain store to
    // an atomic member.
    public void offenders() {
        u8 n <- 0;
        for (this.label <- "x"; n < 2; n +<- 1) {
            n +<- 1;
        }
        for (this.frame[0, 2] <- 0; n < 4; this.ticks +<- 1) {
            n +<- 1;
        }
        for (n <- 0; n < 2; global.shared +<- 1) {
            n +<- 1;
        }
        for (this.level[31] <- true; n < 2; n +<- 1) {}
        for (this.ticks <- 0; n < 2; n +<- 1) {}
    }
}
