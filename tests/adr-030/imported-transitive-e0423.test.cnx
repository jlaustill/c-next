// test-error
// test-adr: 030
// ADR-030 E0423 in every context it can fire in, at include depth 2.

#include "adr-030-relay.cnx"

void top(u32 n) {
    u32 seen <- libValue() + RELAY_LIMIT;
    if (n = 0) {
        return;
    }
    top(n - 1);
}

u32 count(u32 n) {
    for (u32 i <- count(n - 1); i < 3; i +<- 1) {
        u32 c <- i;
    }
    return n;
}

scope S {
    public void go(u32 n) {
        u32 seen <- libValue() + RELAY_LIMIT;
        if (n = 0) {
            return;
        }
        this.go(n - 1);
    }
}
