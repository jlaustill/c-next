// test-execution
// Issue #1997: Render reports each form it emits (here a designated
// initializer) as a per-file fact, and 2.2 Plan decides what it costs. The
// helper emits one; this file does not. If TranspileState.reset() kept the
// helper's fact, this file's C++ banner would claim "Requires: C++20." and the
// designated-initializer extension for code it does not contain -- the #1143
// leak, moved from Render's requirement map to its form facts.
#include "lib/origin.cnx"

u32 main() {
    i32 x <- originX();
    if (x != 0) {
        return 1;
    }
    return 0;
}
