{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "moduleResolution": "node",

    // Matches the root tsconfig: the plugin typechecks 1.2's sources from
    // ../../src, and one file must not be held to two library levels.
    // esbuild produces dist/, not tsc. This config exists only to typecheck.
    // `rootDir` is deliberately unset: the plugin imports the generated parser
    // from ../../src, which no rootDir under prettier-plugin/ can contain.
    "noEmit": true
  },
  "include": ["src/**/*", "tests/**/*"],
  "exclude": ["node_modules", "dist"]
}
