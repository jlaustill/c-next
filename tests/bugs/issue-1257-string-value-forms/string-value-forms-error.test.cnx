// test-error
// Tests: #2191 - E0864 checks an assignment as a declaration; a fitting assignment is the control
struct Cfg {
    string<8> name;
}

void f() {
    string<8> a <- "ab";
    string<8> b <- "cd";
    mut string<3> t <- "";
    t <- a + b;
    t <- a;
    t <- "toolong";
    t <- "ok";
    Cfg c <- { name: "xy" };
    string<6> y <- c.name + "z";
}
