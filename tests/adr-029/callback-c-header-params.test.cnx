// test-c-only
// test-adr: 029
// ADR-029 in C: a function a C header declares, with the exact C signature of the
// callback type it fills, is accepted in every parameter shape: a scalar by
// value, a mut scalar and a mut struct through a pointer, a struct, an array
// and a string through a const pointer (#1619). A pointer typedef counts its
// own `*`s, and a 2-D array keeps its inner dimension. A function-pointer
// parameter, written or typedef'd, is a shape the header lowering does not
// carry, so it is accepted here and gcc is the check. uint_least32_t is the
// compiler's own type for it, and a typedef's const reaches its pointee,
// whether the typedef or its use spells the `*`. A type name that merely
// contains `const` or `volatile` is not qualified.
#include "callback-c-header-params.h"

void valueSlot(u32 v) {
    (void)v;
}

void mutSlot(mut u32 v) {
    v <- 1;
}

void sampleSlot(Sample s) {
    i32 x <- s.value;
}

void mutSampleSlot(mut Sample s) {
    s.value <- 1;
}

void bytesSlot(u8[4] bytes) {
    u8 b <- bytes[0];
}

void textSlot(string<8> text) {
    u32 n <- text.value_char_count;
}

f32 mixSlot(f64 d, bool b, i8 i) {
    return 0.0;
}

u32 tickSource() {
    return 0;
}

void tickSink(tickSource t) {
    u32 n <- t();
}

void cfgSlot(mut nonvolatile_cfg_t c) {
    c.v <- 1;
}

void consSlot(mut constraint_t c) {
    c.v <- 1;
}

void gridSlot(u8[4][4] g) {
    u8 b <- g[0][0];
}

struct Slots {
    valueSlot value;
    mutSlot mutValue;
    sampleSlot sample;
    mutSampleSlot mutSample;
    bytesSlot bytes;
    textSlot text;
    mixSlot mix;
    mutSampleSlot mutSampleRef;
    mutSlot mutRef;
    tickSink tick;
    tickSink clockFn;
    gridSlot grid;
    tickSource least;
    bytesSlot cbytes;
    bytesSlot cbytePtr;
    textSlot name;
    cfgSlot cfg;
    consSlot cons;
}

Slots slots <- {
    value: onValue,
    mutValue: onMut,
    sample: onSample,
    mutSample: onMutSample,
    bytes: onBytes,
    text: onText,
    mix: onMix,
    mutSampleRef: onMutSampleRef,
    mutRef: onMutRef,
    tick: onTick,
    clockFn: onClockFn,
    grid: onGrid,
    least: leastClock,
    cbytes: onCBytes,
    cbytePtr: onCBytePtr,
    name: onName,
    cfg: onCfg,
    cons: onCons
};
