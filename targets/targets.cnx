// The C-Next target catalog (ADR-049, "Named targets").
//
// Every named target is one `const TargetDescription` here, and every other
// name for the same platform is one `const TargetAlias`. This file is a C-Next
// program, and it is the only list of targets: the compiler reads it, so adding
// a target means adding one initializer below.
//
// Rules a compiler enforces when it reads this file:
//   - TARGET_SCHEMA_VERSION names the schema; an unknown version is rejected.
//   - TargetDescription's members are exactly the schema's fields.
//   - Every value is a literal: an unsigned decimal integer, true or false, or
//     a string. No expression and no reference to another constant.
//   - Every field is given, except toolchain_triple and toolchain_cpu, which
//     only select a compiler to check generated code against.
//   - Names are unique, and an alias names a description, never another alias.
//   - Names match exactly, with no case folding.

const u8 TARGET_SCHEMA_VERSION <- 1;

struct TargetDescription {
    string<24> name;
    u8 word_size;
    bool ldrex_strex;
    bool basepri;
    u8 char_bits;
    bool char_signed;
    u8 short_bits;
    u8 int_bits;
    u8 long_bits;
    u8 long_long_bits;
    u8 size_t_bits;
    u8 pointer_bits;
    u8 float_bits;
    u8 double_bits;
    u8 long_double_bits;
    bool big_endian;
    u16 external_identifier_chars;
    u16 internal_identifier_chars;
    string<32> toolchain_triple;
    string<16> toolchain_cpu;
}

struct TargetAlias {
    string<24> name;
    string<24> target;
}

// ARMv7E-M
const TargetDescription CORTEX_M7 <- {
    name: "cortex-m7",
    word_size: 32,
    ldrex_strex: true,
    basepri: true,
    char_bits: 8,
    char_signed: false,
    short_bits: 16,
    int_bits: 32,
    long_bits: 32,
    long_long_bits: 64,
    size_t_bits: 32,
    pointer_bits: 32,
    float_bits: 32,
    double_bits: 64,
    long_double_bits: 64,
    big_endian: false,
    external_identifier_chars: 31,
    internal_identifier_chars: 63,
    toolchain_triple: "thumbv7em-none-eabi",
    toolchain_cpu: "cortex-m7"
};

const TargetAlias TEENSY41 <- { name: "teensy41", target: "cortex-m7" };
const TargetAlias TEENSY40 <- { name: "teensy40", target: "cortex-m7" };

