// Helper (not a test): a scope with a private and a public member, for the
// cross-file ADR-016 fixtures. Visibility is a property of the DECLARATION,
// which lives here, so the private rule has to reach across the include.
scope Config {
    const u32 SECRET_BAUD <- 115200;
    public const u32 BAUD <- 9600;
}

const u32 ACCESS_MARKER <- 1;
