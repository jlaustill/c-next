// test-error
// Issue #1336: a register name used in a TYPE position.
//
// ADR-004 (Implemented) defines a register as a memory-mapped binding, not a type.
// ADR-111 would make a register name a type, but is Status: Research, and its own
// header states that while it is Research "a register is still not a type".
//
// Before the fix this transpiled at exit 0 and emitted `Control c = {0};`,
// referencing a type that is never emitted -- gcc: unknown type name 'Control'.
//
// `Point p` below is a LIVE negative control. UndeclaredTypeAnalyzer collects every
// type-position error in a single walk, so a change that also rejected a genuine
// type would add a second line to the .expected.error and fail this fixture.
//
// The VALUE-position control is register-value-position.test.cnx, and it cannot
// live here: runAnalyzers stops at the first analyzer that returns errors, and
// UndeclaredTypeAnalyzer is registered immediately before UndeclaredValueAnalyzer.
// The E0429 below therefore means the value analyzer never runs on this file, and
// any control for it placed here would be inert whatever it asserted.
register Control @ 0x40000000 {
    DR: u32 rw @ 0x00,
}

struct Point {
    u32 x;
}

u32 main() {
    Point p <- { x: 1 };
    Control c;
    return p.x;
}
