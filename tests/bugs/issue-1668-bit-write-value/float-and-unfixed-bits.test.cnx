// test-execution
// test-target-xfail: atmega328p #1709
// #1760 review: a bit write is decided by the value whose bits it writes.
// A float element's, a float field's and a header float element's bits were
// written as plain subscript stores that C rejects: a float variable was the
// only float that reached the union. An integer the target gives no width, a
// header's `int_fast16_t`, is a `long` on a 64-bit host, and a 32-bit `1U`
// mask cleared its upper half; it is now written in `uintmax_t` and cast back
// (owner ruling). The u32 field and the float variable are controls that were
// already right.
#include "fast_bits.h"

struct Gauge {
    f32 level;
    u32 flags;
}

f32[2] fa <- [1.5, 2.0];
Gauge gs;
f32 lone <- 4.0;

u32 main() {
    fa[1][31] <- true;
    if (fa[1] != -2.0) return 1;
    fa[0][0, 23] <- 0;
    if (fa[0] != 1.0) return 2;
    gs.level <- 3.0;
    gs.level[31] <- true;
    if (gs.level != -3.0) return 3;
    hfa[1][31] <- true;
    if (hfa[1] != -5.0) return 4;
    hf[3] <- true;
    if (hf != -8) return 5;
    hf[0, 4] <- 0;
    if (hf != -16) return 6;
    gs.flags[31] <- true;
    if (gs.flags != 0x80000000) return 7;
    lone[31] <- true;
    if (lone != -4.0) return 8;
    return 0;
}
