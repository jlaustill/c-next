// test-error
// ADR-013: Error - assigning to const f32 variable
// Tests: cannot assign to const variable
// test-adr: 013

// NEGATIVE CONTROL -- a mutable sibling assigned and passed the same way
// the const one is; only the const target below is reported.
mut u8 ctlMutable <- 0;
void ctlTake(mut u8 v) {
    v <- 1;
}
void ctlAssign() {
    ctlMutable <- 1;
    ctlMutable +<- 1;
    ctlTake(ctlMutable);
}
f32 PI <- 3.14159;

void main() {
    PI <- 3.0; // ERROR: cannot assign to const variable
}
