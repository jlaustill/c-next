// FAILS: a qualified const from another scope is a parse error.
// Error: missing IDENTIFIER at ')'
// The constructor-argument grammar accepts only a bare IDENTIFIER, so the
// standard "AppConfig holds every pin" pattern cannot feed a constructor.
#include <FakeSensor.h>

scope AppConfig {
    const u8 SENSOR_CHIP_SELECT_PIN <- 10;
}

scope Fails {
    FakeSensor sensor(AppConfig.SENSOR_CHIP_SELECT_PIN);

    bool start() { return sensor.begin(); }
}
