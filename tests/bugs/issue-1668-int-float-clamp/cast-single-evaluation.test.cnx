// test-execution
// #1668 (C26): a saturating float-to-integer cast evaluates its operand once.
// The bounded ternary ADR-024 lowers a cast to reads its operand up to three
// times, so a side-effecting operand -- a call, a callback, an element whose
// index calls -- ran its side effect three times for an in-range value.
u32 calls <- 0;
f32[4] readings <- [100.0, 1.0, 2.0, 3.0];

u32 nextIndex() {
    calls +<- 1;
    return 0;
}

f32 measure() {
    calls +<- 1;
    return 100.0;
}

struct Sensor {
    measure read;
}

u32 main() {
    Sensor s <- { read: measure };

    u8 a <- (u8)s.read();
    if (a != 100) return 1;
    if (calls != 1) return 2;

    u8 b <- (u8)readings[nextIndex()];
    if (b != 100) return 3;
    if (calls != 2) return 4;

    // NEGATIVE CONTROL: a pure operand keeps the inline form and its value
    f32 k <- 300.0;
    u8 c <- (u8)k;
    if (c != 255) return 5;

    return 0;
}
