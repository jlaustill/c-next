// test-error
// test-adr: 006
// ADR-006: inside a scope method, a literal passed to a same-file `mut`
// parameter gets E0916 -- through `this.` and to a top-level function
// (#1203). CONTROL: a `mut` scope member passed by `this.` stays silent.

void bumpShared(mut u32 value) {
    value +<- 1;
}

scope Counter {
    mut u32 total <- 0;

    void bump(mut u32 value) {
        value +<- 1;
    }

    public void run() {
        this.bump(5);
        bumpShared(7);
        this.bump(this.total);
    }
}
