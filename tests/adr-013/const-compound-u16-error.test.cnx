// test-error
// ADR-013: Error - compound assignment to const u16
// Tests: cannot use compound assignment on const u16 variable
// test-adr: 013

// NEGATIVE CONTROL -- a mutable sibling assigned and passed the same way
// the const one is; only the const target below is reported.
mut u8 ctlMutable <- 0;
void ctlTake(mut u8 v) {
    v <- 1;
}
void ctlAssign() {
    ctlMutable <- 1;
    ctlMutable +<- 1;
    ctlTake(ctlMutable);
}
u16 COUNTER <- 100;

void main() {
    COUNTER +<- 1; // ERROR: cannot assign to const variable
}
