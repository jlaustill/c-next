// test-error
// test-adr: 068
// Coverage: ADR-068 / #1075 - always-true do-while literal condition (E0707)
void run() {
    u8 state <- 0;
    // NEGATIVE CONTROL -- a do-while on a variable.
    do {
        state +<- 1;
    } while (state < 3);
    do {
        state <- 1;
    } while (1 = 1);
}
