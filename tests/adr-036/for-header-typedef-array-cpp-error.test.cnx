// test-error
// test-cpp-only
// test-adr: 036
// #1823: a `for` header declares one scalar loop variable. A header typedef
// can name an array, which only the symbols can tell, so 2.1 reports it as
// E0917, as 1.2 does an array written as one.
// The C++ twin of for-header-typedef-array-error.test.cnx.

#include "for-header-typedef.h"

u32 main() {
    mut u32 n <- 0;
    // NEGATIVE CONTROL -- a header typedef of a scalar.
    for (mut Byte k <- 0; k < 3; k <- k + 1) {}

    for (mut Buf b; n < 1; n <- n + 1) {}
    // Through a second typedef.
    for (mut Bufs bs; n < 2; n <- n + 1) {}
    return 0;
}
