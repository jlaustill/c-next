// test-execution
// Tests: a struct literal declared in a for header resolves its fields' bare enum members (#1991 review)
enum Color {
    RED,
    GREEN
}
struct Pt {
    Color c;
    u8 x;
}

u32 main() {
    u8 i <- 0;
    u8 seen <- 0;
    for (Pt p <- { c: GREEN, x: 1 }; i < 2; i +<- 1) {
        if (p.c = Color.GREEN) {
            seen +<- p.x;
        }
    }
    if (seen != 2) {
        return 1;
    }
    return 0;
}
