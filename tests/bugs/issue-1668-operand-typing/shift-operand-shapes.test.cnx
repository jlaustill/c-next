// test-error
// #1668: E0805 and E0873 type every operand with the one operand typer and
// read every assignment site. Before, the signed rule read only a bare
// variable's declared type, an amount only a literal or a scope/file const,
// and a compound shift only as a statement (#1726).
struct Sample {
    i32 v;
    u8 small;
}

void main() {
    Sample p <- { v: 4, small: 2 };
    u8 a <- 1;
    u32 w <- 1;
    const u8 NINE <- 9;

    // NEGATIVE CONTROLS -- in range, and a leading-zero amount, whose value
    // the emitted C and the transpiler disagree on (#1728), is not judged.
    u8 ok1 <- a << 7;
    u32 ok2 <- w << 037;
    for (u32 i <- 0; i < 3; i +<- 1) {
        a <<<- 1;
    }

    // ASSERTIONS
    i32 e1 <- p.v << 2;
    u8 e2 <- a << NINE;
    for (u32 j <- 0; j < 3; a <<<- 9) {
        j +<- 1;
    }
    for (u32 k <- 0; k < 3; p.v <<<- 1) {
        k +<- 1;
    }
}
