// test-error
// test-adr: 030
// Issue #1643: a declaration is defined once it closes, so an initializer
// naming the variable it declares names nothing yet -- E0427 (ADR-030). Each
// control names a different variable of the same type and stays silent.

scope S {
    u32 a <- 0;
    u32 b <- a + 1; // control
    u32 x <- x + 1; // ERROR: reads itself
    u32 y <- this.y + 1; // ERROR: reads itself

    public u32 get() {
        u32 a <- this.a + 1; // control: names the member, not this local
        u32 w <- w + 1; // ERROR: reads itself
        return a + w + this.b + this.x;
    }
}

u8 main() {
    return 0;
}
