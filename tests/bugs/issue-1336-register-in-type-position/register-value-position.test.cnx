// Issue #1336: the NEGATIVE CONTROL for the type/value position split.
//
// A register name is a legal VALUE -- `Control.DR` reads and writes memory at an
// address (ADR-004) -- while not being a type. `NameExistence.isValueName` is what
// holds those two answers apart, and this fixture is what proves the split is
// load-bearing rather than decorative.
//
// Collapse `isValueName` into `isTypeName` -- the "one-line fix" of simply dropping
// registers from the type predicate -- and this file reddens with
// `E0427: 'Control' is not defined`, along with ten fixtures under tests/register,
// tests/scope, tests/postfix-chains and tests/bitmap.
//
// This assertion cannot be made in register-in-type-position.test.cnx: that fixture
// errors in an EARLIER analyzer, and runAnalyzers stops at the first one that
// returns errors, so the value analyzer never runs on it.
register Control @ 0x40000000 {
    DR: u32 rw @ 0x00,
}

u32 main() {
    Control.DR <- 0x01;
    u32 seen <- Control.DR;
    return seen;
}
