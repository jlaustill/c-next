// test-execution
// Tests .type_byte_length property for strings (ADR-058)
// type_byte_length = capacity, no terminator (ADR-058); the buffer with its
// terminator is the memory row: string<64> = 64 type bytes, 65 memory bytes

string<64> globalStr <- "Hello";

struct TestStruct {
    string<32> name;
}

i32 main() {
    if (globalStr.memory_byte_length != 65) {
        return 10;
    }
    if (globalStr.type_byte_length != 64) {
        return 1;
    }

    // string<32> = 32 bytes
    string<32> localStr <- "World";
    if (localStr.type_byte_length != 32) {
        return 2;
    }

    // string<16> = 16 bytes
    string<16> smallStr <- "";
    if (smallStr.type_byte_length != 16) {
        return 3;
    }

    // Test struct member string<32> = 32 bytes
    mut TestStruct ts;
    ts.name <- "Test";
    if (ts.name.type_byte_length != 32) {
        return 4;
    }

    return 0;
}
