// test-execution
// test-adr: 024
// #1268 review: a bit range's width may be a float cast to an integer type,
// which truncates (ADR-024): `x[0, (u32)4.5]` is the low 4 bits, a mask fixed
// at compile time. Main built the mask at run time from the cast.
//
// CONTROL: `(u32)3.99` is 3 bits -- the cast truncates, it does not round.

u32 main() {
    u8 x <- 0xFF;
    u8 four <- x[0, (u32)4.5];
    if (four != 15) {
        return 1;
    }
    u8 three <- x[0, (u32)3.99];
    if (three != 7) {
        return 2;
    }
    return 0;
}
