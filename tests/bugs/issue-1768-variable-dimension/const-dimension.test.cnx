// test-execution
// Issue #1768 NEGATIVE CONTROL: variable-dimension.test.cnx's two shapes with a
// const in place of the variable transpile, compile and keep their size.

u32 GY <- 2;
mut u8[GY] gok;

u32 main() {
    u32 y <- 2;
    mut u8[y] ok <- [0*];
    ok[1] <- 7;
    gok[1] <- 9;
    if (ok[1] != 7) {
        return 1;
    }
    if (ok.type_element_count != 2) {
        return 2;
    }
    if (gok[1] != 9) {
        return 3;
    }
    if (gok.type_element_count != 2) {
        return 4;
    }
    return 0;
}
