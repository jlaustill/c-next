// test-error
// test-adr: 049
// E0889 in a scope method: a local declaration carrying both atomic and
// volatile is rejected as a file-scope one is
#pragma target stm32f4

scope Worker {
    public void run() {
        atomic volatile mut u8 y <- 0;
        y +<- 1;
    }
}

void main() {
    Worker.run();
}
