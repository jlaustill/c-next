// test-error
// test-adr: 049
// #2233: atomic implies mut, so ADR-071's E0899 still rejects an atomic
// local or private scope member that nothing writes, and asks for atomic to
// go. The written local and member, and the global and public member C code
// may write, are controls that stay silent.
#pragma target stm32f4

atomic u32 shared <- 0;

scope Sensor {
    atomic u8 idle <- 0;
    atomic u8 count <- 0;
    public atomic u8 exported <- 0;

    public u8 read() {
        this.count +<- 1;
        return this.idle + this.count + this.exported;
    }
}

u32 main() {
    atomic u32 unused <- 0;
    atomic u32 used <- 0;
    used +<- 1;
    return unused + used + shared + Sensor.read();
}
