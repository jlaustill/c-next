// test-error
// test-adr: 023
// ADR-023 (#1975, owner ruling): cnx has no `sizeof`. A type's or a
// value's size in bytes is its ADR-058 `.type_byte_length`, the sum of its fields'
// sizes with no padding, so `sizeof` is rejected with that spelling as help --
// whatever its operand: a type, a value, or a call (once E0601/E0602's).

struct Frame {
    u8 id;
    u32 stamp;
}

mut u32 counter <- 0;

u32 increment() {
    counter <- counter + 1;
    return counter;
}

void takesArray(u8[8] data) {
    // NEGATIVE CONTROLS -- every size sizeof used to give, as .type_byte_length
    u8[8] local;
    u32 okLocal <- local.type_byte_length;
    u32 okParameter <- data.type_byte_length;
    u32 okType <- u32.type_byte_length;
    u32 okStruct <- Frame.type_byte_length;
    u32 okField <- Frame.stamp.type_byte_length;

    // ASSERTIONS -- a type, a value, and a call
    u32 badType <- sizeof(u32);
    u32 badValue <- sizeof(local);
    u32 badCall <- sizeof(increment());
}

u32 main() {
    u8[8] buffer;
    takesArray(buffer);
    return 0;
}
