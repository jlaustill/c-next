// test-error
// test-adr: 007
// Tests: Issue #234 - Runtime slice offsets are now compile-time errors
// Slice assignment requires compile-time constant offset and length
// to ensure bounds safety at compile time.

// NEGATIVE CONTROL -- the same shape with `const` offset AND length. Both must
// fold, and both do here; the assertion below differs only in that they are
// mutable locals. A check that rejected every non-literal subscript would fail
// this one.
u32 OFF <- 0;
u32 LEN <- 4;

u32 constBoth() {
    mut u8[8] ok;
    u32 v <- 0x11223344;
    ok[OFF, LEN] <- v;
    return 0;
}

u32 main() {
    mut u8[8] buffer;
    mut u32 offset <- 0;
    mut u8 length <- 4;
    offset +<- 1;
    length -<- 1;

    // This should fail at compile time because offset is a runtime variable
    u32 value1 <- 0x11223344;
    buffer[offset, length] <- value1;

    return 0;
}
