// test-execution
// Issue #1967: a scope member named bare is measured under its scope-qualified
// C name, whole and through a member, as every other bare identifier is.
// Written with `sizeof` then; ADR-058's `.byte_length` since #1975. Controls:
// the `this.` form, and a local that shadows the member, which measures the
// local.

struct Pair {
    u8 a;
    u32 b;
}

scope S {
    u8[16] buf;
    Pair cfg;

    public u32 measureBuf() {
        return buf.byte_length;
    }

    public u32 measureField() {
        return cfg.b.byte_length;
    }

    public u32 measureThis() {
        return this.buf.byte_length;
    }

    public u32 measureShadow() {
        u8[4] buf <- [0, 0, 0, 0];
        return buf.byte_length;
    }
}

u32 main() {
    u32 whole <- S.measureBuf();
    if (whole != 16) {
        return 1;
    }
    u32 field <- S.measureField();
    if (field != 4) {
        return 2;
    }
    u32 viaThis <- S.measureThis();
    if (viaThis != 16) {
        return 3;
    }
    u32 shadowed <- S.measureShadow();
    if (shadowed != 4) {
        return 4;
    }
    return 0;
}
