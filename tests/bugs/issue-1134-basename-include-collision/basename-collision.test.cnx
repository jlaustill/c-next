// test-execution
// Issue #1134: two included .cnx files sharing a basename.
//
// Include resolution keyed on basename instead of the resolved path, so the
// second file was judged already-included and dropped from the compilation
// entirely. The transpiler exited 0, never generated uart/config.c or
// uart/config.h, and emitted the C-Next source form `UartConfig.baudRate()`
// verbatim into the C output.
//
// This test also covers ADR-063 include guards: with both files compiling, the
// two generated headers must carry distinct guards, or the preprocessor skips
// the second and UartConfig__baudRate is only implicitly declared.
#include "can/config.cnx"
#include "uart/config.cnx"

u32 main() {
    u8 canRate <- CanConfig.bitRate();
    u8 uartRate <- UartConfig.baudRate();

    if (canRate != 5) return 1;
    if (uartRate != 9) return 2;

    return 0;
}
