// test-error
// #1863 review: a member a scope does not have sized a struct field `f[0]`,
// which GNU C accepts -- a silently different layout. It is E0909. The
// computed zero divisor this file also held is E0800 since #1268; it is in
// dimension-zero-divisor.test.cnx.
//
// NEGATIVE CONTROL: `ok`, sized by a member the scope has.

scope S {
    public u8 MAX <- 4;
}

struct T {
    u8[S.NOPE] f;
    u8[S.MAX] ok;
}

void main() {}
