// test-error
// test-adr: 068
// Coverage: ADR-068 / #1075 - always-true for-loop literal condition (E0707)
void run() {
    u8 state <- 0;
    // NEGATIVE CONTROL -- an ordinary counted loop.
    for (u8 j <- 0; j < 4; j +<- 1) {
        state <- j;
    }
    for (u8 i <- 0; 1 = 1; i +<- 1) {
        state <- 1;
    }
}
