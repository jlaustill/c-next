// test-error
// test-adr: 057
// ADR-057: `global.X` cannot be used where a local variable X shadows the
// global. C has no syntax for reaching a shadowed global from inside the
// shadowing scope, so the program is rejected rather than mis-compiled.

u32 count <- 1000;

scope Test {
    // Negative control: nothing local shadows `count` here, so `global.count`
    // is legal and must stay silent. A check that fired on every `global.`
    // access would report THIS line instead of the one below.
    public u32 fine() {
        return global.count;
    }

    public u32 broken() {
        u32 count <- 10;
        u32 x <- global.count;
        return x;
    }
}
