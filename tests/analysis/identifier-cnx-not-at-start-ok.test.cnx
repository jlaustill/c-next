// test-execution
// Tests: the reserved-prefix rule is PREFIX-ONLY (ADR-063)
// `cnx_` is reserved only in the leading position, because a prefix is all that
// is needed to make the two namespaces disjoint. An identifier that merely
// contains the sequence stays legal, and this test fails if E0202 is ever
// implemented as a substring check rather than a prefix check.

u8 my_cnx_buffer <- 1;
u8 buffer_cnx <- 2;

u32 main() {
    if (my_cnx_buffer != 1) return 1;
    if (buffer_cnx != 2) return 2;
    return 0;
}
