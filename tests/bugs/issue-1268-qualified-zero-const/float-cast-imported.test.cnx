// test-execution
// test-adr: 024
// #1268 review: a float-cast const from an included file is worth the
// truncated value (ADR-024), so it sizes an array in the including file as a
// same-file one does (ADR-044). So does a cast of an included float const.
//
// CONTROL: Lim.M, from (u32)3.99, is 3 -- the cast truncates, it does not round.
#include "float-cast-limits.cnx"

u8[N] two;
u8[Lim.M] three;
u8[(u32)F] fromFloat;

u32 main() {
    if (two.type_element_count != 2) {
        return 1;
    }
    if (three.type_element_count != 3) {
        return 2;
    }
    if (fromFloat.type_element_count != 2) {
        return 3;
    }
    return 0;
}
