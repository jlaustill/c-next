// test-error
// test-adr: 024
// #1618: ADR-024's literal range (E0868) holds at every position a value
// lands in a typed target. 300 and -1 reached a u8 through a return, an
// argument, an array element, a struct field initializer and a ternary's arm,
// each at exit 0; an element and a field assignment, a compound and a
// composite operand are here too. The
// controls stay silent: an in-range literal at each.

#include "conversion-consts.cnx"

u32 WIDE <- 0x10000;

struct P {
    u8 x;
}

void take(u8 v) {}

u8 give() {
    return 300;
}

u8 giveInRange() {
    return 255;
}

void positions(u32 c) {
    take(300);
    take(-1);
    u8[2] list <- [300, 0];
    P p <- { x: 300 };
    u8 t <- (c = 1) ? 300 : 0;
    mut u8[2] arr <- [0, 0];
    arr[0] <- 300;
    mut P r <- { x: 0 };
    r.x <- 300;
    mut u8 a <- 0;
    a +<- 300;
    a <- a + 300;
    a +<- (100 + 200);
    u16 negated <- -(300);
    a <- a | 0x100;
    a ^<- 0x1FF;
    a &<- (a + 300);
    a <- a / (a + 300);
    u32 wraps <- 0x10000 * 0x10000;
    u32 wrapsNamed <- WIDE * WIDE;
    u32 wrapsImported <- IMPORTED_WIDE * IMPORTED_WIDE;
    a +<- ((c = 1) ? 300 : 1);
    a <- a + ((~0x00) * 2);

    take(255);
    u8[2] fits <- [255, 0];
    P q <- { x: 0 };
    arr[1] <- 255;
    r.x <- 255;
    a +<- 255;
    a <- a + 255;
    i8 minimum <- -(128);
    a +<- (100 + 155);
    a <- a / 300;
    a %<- 300;
    a <- a & 0x1FF;
    a ^<- 0xFF;
    mut i16 m <- 0;
    m &<- ~0x8000;
    a <- a & (a | 0x1FF);
    u32 fitsU32 <- 0x8000 * 0x10000;
    u64 fitsU64 <- 0x100000000 * 2;
    u32 fitsNamed <- WIDE * 0x8000;
    a <- a | ~0x0F;
    u8 inverted <- ~0x01;
    (void)list;
    (void)p;
    (void)t;
    (void)fits;
    (void)q;
}
