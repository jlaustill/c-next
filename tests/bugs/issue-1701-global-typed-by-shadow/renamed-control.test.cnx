// test-execution
// #1701 CONTROL: the same program with the local named `y`, which nothing
// shadows. This was right before the fix.
u32 x <- 0;

void f() {
    u8 y <- 1;
    global.x +<- 1000;
    u8 local <- y;
    local <- local;
}

u32 main() {
    f();
    if (global.x != 1000) return 1;
    return 0;
}
