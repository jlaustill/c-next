// test-execution
// Issue #139: Test assigning string variable to another string variable
mut string<64> source <- "Original";

mut string<64> dest <- "";

void copyString() {
    dest <- source;
}

u32 main() {
    copyString();
    if (dest.value_char_count != 8) {
        return 1;
    }

    // Change source and copy again
    source <- "NewValue";
    dest <- source;
    if (dest.value_char_count != 8) {
        return 2;
    }

    // Local variable to variable copy
    string<32> localSrc <- "LocalSource";
    mut string<32> localDst <- "";
    localDst <- localSrc;
    if (localDst.value_char_count != 11) {
        return 3;
    }

    return 0;
}
