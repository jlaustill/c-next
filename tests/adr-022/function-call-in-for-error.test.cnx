// Issue #254: Function calls in for conditions are not allowed (E0702)
// test-adr: 022
// MISRA C:2012 Rule 13.5 - Short-circuit evaluation may skip function calls

u32 getLimit() {
    return 10;
}

// NEGATIVE CONTROL -- the same call, hoisted out of the condition.
void okHoisted() {
    u32 limit <- getLimit();
    for (u32 i <- 0; i < limit; i +<- 1) {}
}

void test() {
    for (u32 i <- 0; i < getLimit(); i +<- 1) {
        // body
    }
}
