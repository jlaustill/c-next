// test-cpp-only
// #1991: a C++ enum class value passed to an included function's u8
// parameter is written static_cast<uint8_t>(c) (#304). The cast is the
// file's only fixed-width type, so 2.2 must plan it for the file to
// include <stdint.h>.
#include "cpp-colors.hpp"
#include "imported-values.cnx"

void paintRed() {
    Color c <- Color.Red;
    paint(c);
}
