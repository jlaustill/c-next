// test-execution
// test-adr: 030
// test-adr: 057
// #1643 review: a private member is not defined above its declaration either,
// so the method above it writes the global. The method below it is the
// control: there the member is defined, and the bare name means it.

mut u32 y <- 5;

scope S {
    public void set() {
        y <- 300;
    }

    u8 y <- 1;

    public u8 member() {
        return y;
    }
}

u32 main() {
    S.set();
    if (y != 300) {
        return 1;
    }
    u8 member <- S.member();
    if (member != 1) {
        return 2;
    }
    return 0;
}
