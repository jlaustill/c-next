// Helper for issue #1133 — shares a basename with alpha/module.cnx.
//
// The return type is deliberately u64. If beta's header is skipped because its
// include guard collides with alpha's, this function is only implicitly
// declared, C assumes it returns int, and the value truncates. A u8 return
// would survive that truncation and the test would pass while still broken.
scope BetaModule {
    public u64 big() {
        return 4294967296;
    }
}
