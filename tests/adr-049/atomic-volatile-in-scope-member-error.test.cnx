// test-error
// test-adr: 049
// E0889 on a scope member: a member declaration carrying both atomic and
// volatile is rejected as a file-scope one is. The atomic-only and
// volatile-only members are controls that stay silent.
#pragma target stm32f4

scope Timer {
    atomic volatile u8 pending <- 0;
    atomic u8 fired <- 0;
    volatile mut u8 raw <- 0;

    public void tick() {
        this.pending +<- 1;
        this.fired +<- 1;
        this.raw +<- 1;
    }
}

void main() {
    Timer.tick();
}
