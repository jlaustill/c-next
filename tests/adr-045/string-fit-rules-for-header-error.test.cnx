// test-error
// test-adr: 045
// The capacity rules inside a `for` header's declaration (#1620): E0864 and
// E0865 on an argument written into a `string<8>` parameter by the loop
// variable's initializer, with the source declared in this file. A string
// cannot be the loop variable itself (E0917), so an argument is how a header
// writes one.

string<16> source <- "wide";

u32 take(string<8> s) {
    return 0;
}

u32 fromFunction() {
    mut u32 total <- 0;

    // NEGATIVE CONTROL -- a substring that is within its source and fits.
    for (mut u32 okWithin <- take(source[8, 8]); okWithin < 1; okWithin +<- 1) {
        total +<- okWithin;
    }

    // ASSERTION 1 -- E0864, for header: string<16> passed to string<8>.
    for (mut u32 narrow <- take(source); narrow < 1; narrow +<- 1) {
        total +<- narrow;
    }

    // ASSERTION 2 -- E0865, for header: [12, 8] runs past string<16>.
    for (mut u32 outOfBounds <- take(source[12, 8]); outOfBounds < 1; outOfBounds +<- 1) {
        total +<- outOfBounds;
    }
    return total;
}

u32 main() {
    return 0;
}
