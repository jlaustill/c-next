// test-execution
// test-adr: 058
// #1535: a struct's .type_element_count is its field count, and its .type_bit_length /
// .type_byte_length are its fields' sizes together, without C padding (ADR-058
// resolved question 7). C stores P in 8 bytes on x86-64; its .type_byte_length is 5.

struct P {
    u32 x;
    u8 y;
}

struct Nested {
    P p;
    u16[3] arr;
    string<7> s;
    bool b;
}

// ADR-058's ### Struct Examples block, as written there
struct SensorReading {
    u32 timestamp;
    f32 temperature;
    u16 humidity;
    u8 status;
}

SensorReading reading;
u32 bits <- reading.type_bit_length;
u32 bytes <- reading.type_byte_length;
u32 fields <- reading.type_element_count;
SensorReading[100] readings;

P p;
P[3] ps;
Nested n;
// #1175: a dimension sized by a property is the number the property reads as
u8[p.type_byte_length] sized;
// A string field's symbol carries its C buffer as a last dimension; read
// as the typer reads it, its .type_byte_length is 8 here too, not 8 x 8
u8[n.s.type_byte_length] sizedByString;

i32 main() {
    if (p.type_bit_length != 40) {
        return 1;
    }
    if (p.type_byte_length != 5) {
        return 2;
    }
    if (p.type_element_count != 2) {
        return 3;
    }
    // 40 + 3 * 16 + 7 * 8 + 1: a string<7> is its 7 chars, a bool 1 bit
    if (n.type_bit_length != 145) {
        return 4;
    }
    if (n.type_byte_length != 19) {
        return 5;
    }
    if (n.type_element_count != 4) {
        return 6;
    }
    if (n.p.type_byte_length != 5) {
        return 7;
    }
    // An array of structs follows the array rule
    if (ps.type_byte_length != 15) {
        return 8;
    }
    if (ps.type_element_count != 3) {
        return 9;
    }
    if (ps[0].type_byte_length != 5) {
        return 10;
    }
    if (sized.type_element_count != 5) {
        return 11;
    }
    if (sizedByString.type_element_count != 7) {
        return 12;
    }
    if (bits != 88) {
        return 13;
    }
    if (bytes != 11) {
        return 14;
    }
    if (fields != 4) {
        return 15;
    }
    // C stores this array in 1200 bytes; its .type_byte_length is 1100
    if (readings.type_byte_length != 1100) {
        return 16;
    }
    return 0;
}
