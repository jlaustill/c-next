// test-execution
// test-adr: 014
// ADR-014 / ADR-006 (#1530): a struct literal passed as a call argument takes
// its type from the parameter, and reaches the function by reference: in C the
// address of a compound literal, in C++ a temporary bound to `const T&`,
// parenthesized or not. Only a read-only parameter: one the callee writes
// (`mut`) cannot take a temporary (#1203).
// Before #1530 the C passed the literal by value against the pointer
// parameter, and gcc rejected the call at transpile exit 0.

struct Point {
    u32 x;
    u32 y;
}

struct Line {
    Point a;
    Point b;
}

u32 sum(Point p) {
    return p.x + p.y;
}

u32 span(Line l) {
    return (l.b.x - l.a.x) + (l.b.y - l.a.y);
}

u32 weighted(u32 k, Point p) {
    return k * p.x + p.y;
}

u32 main() {
    // A literal argument
    u32 v <- sum({ x: 1, y: 2 });
    if (v != 3) {
        return 1;
    }

    // A literal argument whose fields are themselves literals
    u32 s <- span({ a: { x: 1, y: 2 }, b: { x: 4, y: 7 } });
    if (s != 8) {
        return 2;
    }

    // A literal beside a by-value argument
    u32 w <- weighted(10, { x: 3, y: 4 });
    if (w != 34) {
        return 3;
    }

    // A literal argument inside a larger expression
    u32 t <- sum({ x: 20, y: 22 }) + 1;
    if (t != 43) {
        return 4;
    }

    u32 p <- sum(({ x: 5, y: 6 }));
    if (p != 11) {
        return 5;
    }

    return 0;
}
