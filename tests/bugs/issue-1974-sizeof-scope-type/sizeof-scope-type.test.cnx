// test-execution
// Issue #1974: a scope's own struct, enum or bitmap is measured as the type
// its C name declares -- `S__Cfg`, `S__Mode`, `S__Flags` -- as every other
// type position reads it. Before, `sizeof` emitted the source spelling, which
// C does not declare; since #1975 the size is ADR-058's `.type_byte_length`. A
// global type is the control: `Pair.type_byte_length`.

struct Pair {
    u8 a;
    u32 b;
}

scope S {
    struct Cfg {
        u8 a;
        u32 b;
    }

    enum Mode {
        A,
        B
    }

    bitmap8 Flags {
        f0,
        f1,
        f2,
        f3,
        f4,
        f5,
        f6,
        f7
    }

    public u32 cfgSize() {
        return Cfg.type_byte_length;
    }

    public u32 cfgValueSize() {
        Cfg c;
        return c.type_byte_length;
    }

    public u32 modeSize() {
        return Mode.type_byte_length;
    }

    public u32 modeValueSize() {
        Mode m <- Mode.A;
        return m.type_byte_length;
    }

    public u32 flagsSize() {
        return Flags.type_byte_length;
    }

    public u32 pairSize() {
        return Pair.type_byte_length;
    }
}

u32 main() {
    u32 cfg <- S.cfgSize();
    u32 cfgValue <- S.cfgValueSize();
    if (cfg != cfgValue) {
        return 1;
    }
    u32 mode <- S.modeSize();
    u32 modeValue <- S.modeValueSize();
    if (mode != modeValue) {
        return 2;
    }
    u32 flags <- S.flagsSize();
    if (flags != 1) {
        return 3;
    }
    u32 pair <- S.pairSize();
    if (pair != Pair.type_byte_length) {
        return 4;
    }
    return 0;
}
