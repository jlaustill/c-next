// #2003: a function registered as a C callback inside `forever` takes the
// typedef's pointer parameters, so the registration compiles under -Werror
#include "../issue-895-callback-pointer-params/widget.h"

void my_flush(widget_t w, rect_t area, u8 buf) {
    global.widget_flush_area_x <- area.x;
}

void run() {
    widget_t w <- global.widget_create();
    forever {
        global.widget_set_flush_cb(w, my_flush);
    }
}
