// test-execution
// Issue #1127: an array dimension that names an enum must resolve to the same
// C identifier in the .c and the .h, for struct fields as well as variables.
//
// The rule lived only in HeaderSymbolAdapter.resolveArrayDimension() and served
// variables. Struct fields had no path to it at all: TSymbolInfoAdapter filtered
// non-numeric dimensions out, so `u8[EColor.COUNT] slots` reached the header as
// a scalar and the body as a bit-indexed value.
//
//   .c decl:  uint8_t slots[EColor__COUNT];   (via the AST fallback)
//   .c body:  p.slots = (p.slots & ~(1U << 2)) | ...;
//   .h:       uint8_t slots;
//
// The rule now lives on QualifiedCName.resolveDimensionName and is applied once,
// in a second pass over the collected symbols -- after every enum is known, so
// the answer does not depend on whether the enum is declared above the struct.
enum EColor { RED, GREEN, BLUE, COUNT }

struct Palette {
    u8[EColor.COUNT] slots;
}

u8[EColor.COUNT] globalSlots;

// EColor.COUNT is 3, so both arrays hold 3 elements and index 2 is the last
// valid one. An earlier draft of this test indexed [3] and overflowed the
// struct; the transpiler did not reject it, because a dimension that stays
// symbolic ("EColor__COUNT") gives TypeValidator.checkArrayBounds nothing
// numeric to compare against -- even though the enum value is known at compile
// time. That gap is #1174, and is not addressed here.
i32 main() {
    Palette p;
    p.slots[0] <- 10;
    p.slots[2] <- 40;
    globalSlots[2] <- 40;

    if (p.slots[0] != 10) return 1;
    if (p.slots[2] != 40) return 2;
    if (globalSlots[2] != 40) return 3;
    return 0;
}
