// test-execution
// test-no-warnings
// test-link: pts_impl.c
// A whole array of COMPLETE structs passed to a C function whose parameter is
// a pointer to one element. C decays the array to that pointer, so the
// argument is the bare array. It was emitted with an `&` instead: `&(*p)` for
// a parameter in C, which compiles only because the `(*p)` -- the parameter's
// first element -- and the `&` cancel; `&p`, a `CPoint**`, for the same
// parameter in C++; and `&l`, a `CPoint (*)[2]`, for a local, a global, a scope
// member and a struct member alike. The transpiler exited 0 each time.
//
// Controls, which keep their `&`: one ELEMENT of the array is a value passed
// by address (`&p[1U]`), and so is a single struct parameter. A primitive
// array never took an `&` (`u32s_bump2(n)`).
#include "pts.h"

CPoint[2] gpts;

struct Bag {
    CPoint[2] inner;
}

scope Keeper {
    CPoint[2] kept;

    public void bump() {
        global.pts_bump2(this.kept);
    }

    public u32 total() {
        return this.kept[0].x + this.kept[1].x;
    }
}

// The defect: a struct-array parameter passed whole.
void bumpParam(CPoint[2] p) {
    pts_bump2(p);
}

// Control: one element is a value, passed by address.
void bumpSecond(CPoint[2] p) {
    pts_bump1(p[1]);
}

// Control: a single struct parameter is passed by address.
void bumpOne(CPoint one) {
    pts_bump1(one);
}

// Control: a primitive array never took an `&`.
void bumpNums(u32[2] n) {
    u32s_bump2(n);
}

i32 main() {
    // A local, passed whole.
    CPoint[2] l;
    pts_bump2(l);
    if (l[0].x != 1) {
        return 1;
    }
    if (l[1].x != 2) {
        return 2;
    }

    // A parameter, passed whole.
    bumpParam(l);
    if (l[0].x != 2) {
        return 3;
    }
    if (l[1].x != 4) {
        return 4;
    }

    // A file-scope variable, passed whole.
    pts_bump2(gpts);
    if (gpts[0].x != 1) {
        return 5;
    }
    if (gpts[1].x != 2) {
        return 6;
    }

    // A scope member, passed whole.
    Keeper.bump();
    u32 kept <- Keeper.total();
    if (kept != 3) {
        return 7;
    }

    // A struct member, passed whole.
    Bag bag;
    bag.inner[0].x <- 10;
    bag.inner[1].x <- 20;
    pts_bump2(bag.inner);
    if (bag.inner[0].x != 11) {
        return 8;
    }
    if (bag.inner[1].x != 22) {
        return 9;
    }

    // Controls.
    bumpSecond(l);
    if (l[0].x != 2) {
        return 10;
    }
    if (l[1].x != 5) {
        return 11;
    }

    CPoint single <- { x: 7 };
    bumpOne(single);
    if (single.x != 8) {
        return 12;
    }

    u32[2] nums;
    bumpNums(nums);
    if (nums[0] != 1) {
        return 13;
    }
    if (nums[1] != 2) {
        return 14;
    }

    return 0;
}
