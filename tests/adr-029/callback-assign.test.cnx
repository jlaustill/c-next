// ADR-029: Test callback assignment
// test-adr: 029
struct Message {
    u32 id;
}

void onReceive(Message msg) {
    // default: no-op
}

// User's custom handler (same signature, not used as a type)
void myHandler(Message msg) {
    // custom implementation
}

struct Controller {
    onReceive _handler;
}

void test() {
    mut Controller c;
    c._handler <- myHandler;
}
