// test-execution
// test-no-warnings
// #1863 review: a parameter sized by an earlier one was settled twice, so
// the .c wrote `b[4]` and the .h `b[0]` -- gcc's -Warray-parameter fails it
// under -Werror. The frame settles it once, and both files write 4.
//
// NEGATIVE CONTROL: `a`, sized by a const.

const u32 N <- 4;

u32 sum(u8[N] a, u8[a.element_count] b) {
    u32 total <- a[0];
    total +<- b[3];
    return total;
}

u32 main() {
    u8[4] x <- [1, 2, 3, 4];
    u8[4] y <- [5, 6, 7, 8];
    u32 s <- sum(x, y);
    if (s != 9) {
        return 1;
    }
    return 0;
}
