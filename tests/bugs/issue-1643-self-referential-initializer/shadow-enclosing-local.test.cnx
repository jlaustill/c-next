// test-execution
// test-adr: 030
// test-adr: 057
// #1643 review: an initializer that names the enclosing local or parameter its
// declaration shadows reads that one (ADR-030). C scopes the new local from
// its declarator, before the initializer, so the new one gets its own C name
// (ADR-057). Each case returns a distinct code if the C reads the new local.

struct Point {
    u32 p;
    u32 y;
}

u32 point(u32 p) {
    // NEGATIVE CONTROL -- `p:` names a field, not the parameter, so the
    // local keeps its plain C name
    if (p = 1) {
        Point p <- { p: 5, y: 6 };
        return p.p;
    }
    return 0;
}

u32 bump(u32 p) {
    if (p = 1) {
        u32 p <- p + 1;
        return p;
    }
    return 0;
}

u32 replace(u32 q) {
    // NEGATIVE CONTROL -- shadows the parameter without reading it
    if (q = 1) {
        u32 q <- 7;
        return q;
    }
    return 0;
}

u8 main() {
    u32 bumped <- bump(1);
    if (bumped != 2) {
        return 1;
    }
    u32 replaced <- replace(1);
    if (replaced != 7) {
        return 2;
    }
    u32 N <- 2;
    if (N = 2) {
        u32 N <- N + 1;
        u8[N] buf <- [7*];
        if (buf.type_element_count != 3) {
            return 3;
        }
        if (N != 3) {
            return 4;
        }
    }
    u32 k <- 1;
    if (k = 1) {
        u32 k <- k + 1;
        if (k = 2) {
            u32 k <- k + 1;
            if (k != 3) {
                return 5;
            }
        }
    }
    if (N != 2) {
        return 6;
    }
    u32 i <- 3;
    mut u32 total <- 0;
    if (i = 3) {
        for (mut u32 i <- i; i < 5; i +<- 1) {
            total +<- i;
        }
    }
    if (total != 7) {
        return 7;
    }
    mut u32 count <- 0;
    if (i = 3) {
        // NEGATIVE CONTROL -- shadows `i` without reading it
        for (mut u32 i <- 0; i < 2; i +<- 1) {
            count +<- 1;
        }
    }
    if (count != 2) {
        return 8;
    }
    u32 field <- point(1);
    if (field != 5) {
        return 9;
    }
    return 0;
}
