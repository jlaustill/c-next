// test-execution
// test-adr: 045
// Issue #139: Test local string variable reassignment in function body
u32 main() {
    mut string<32> local <- "Initial";
    if (local.value_char_count != 7) {
        return 1;
    }

    // Reassign local string
    local <- "Updated";
    if (local.value_char_count != 7) {
        return 2;
    }

    // Reassign to shorter string
    local <- "Short";
    if (local.value_char_count != 5) {
        return 3;
    }

    // Reassign to longer string
    local <- "This is a longer string";
    if (local.value_char_count != 23) {
        return 4;
    }

    return 0;
}
