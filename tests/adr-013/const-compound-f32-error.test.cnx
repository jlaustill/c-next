// test-error
// ADR-013: Error - compound assignment to const f32
// Tests: cannot use compound addition on const f32 variable
// test-adr: 013

// NEGATIVE CONTROL -- a mutable sibling assigned and passed the same way
// the const one is; only the const target below is reported.
u8 ctlMutable <- 0;
void ctlTake(u8 v) {
    v <- 1;
}
void ctlAssign() {
    ctlMutable <- 1;
    ctlMutable +<- 1;
    ctlTake(ctlMutable);
}
const f32 SCALE <- 1.0;

void main() {
    SCALE +<- 0.5; // ERROR: cannot assign to const variable
}
