// test-execution
// #1664 review of C11: a const's compile-time value is the value its C
// computes. `A - 3` on a u8 is `cnx_clamp_sub_u8(A, 3U)` (ADR-044), which
// is 0, but the fold did unbounded integer arithmetic and said -1. So the
// analyzers reported a false E0800 (`12 / C`, C folded to 0), a false E0873
// (a shift by -1) and a false E0854 (index -1, and index 148 from a
// `200 + 200` the C saturates at 255). A result a typed operand cannot
// hold is not folded.
u32 main() {
    const u8 A <- 2;
    const u8 B <- A - 3;
    const u8 C <- B + 1;
    u32 q <- 12 / C;
    if (q != 12) return 1;
    u32 s <- 1 << B;
    if (s != 1) return 2;
    u8[4] arr <- [5, 6, 7, 8];
    u8 first <- arr[B];
    if (first != 5) return 3;
    const u8 E <- 200;
    const u8 F <- E + E;
    u8 last <- arr[F - 252];
    if (last != 8) return 4;
    // No declaration in between: a subscript that is arithmetic on a typed
    // const is clamped too, `arr[cnx_clamp_sub_u8(A, 3U)]`, element 0
    u8 direct <- arr[A - 3];
    if (direct != 5) return 6;
    // NEGATIVE CONTROL: a fold every operand's type holds still folds
    const u8 G <- A + 3;
    u8[G] five;
    if (five.element_count != 5) return 5;
    return 0;
}
