// test-execution
// test-adr: 030
// test-adr: 057
// #1643 review: a local whose initializer spells an outer global or member
// bare reads the outer one, in cnx and in the C. Each case returns a
// distinct code if the C reads the new, uninitialized local instead.

u32 g <- 10;

scope S {
    u32 a <- 20;

    public u32 bump() {
        u32 a <- a + 1;
        return a;
    }
}

u32 fromGlobal() {
    u32 g <- g + 1;
    return g;
}

u8 main() {
    u32 fromG <- fromGlobal();
    if (fromG != 11) {
        return 1;
    }
    u32 fromA <- S.bump();
    if (fromA != 21) {
        return 2;
    }
    // NEGATIVE CONTROL -- the outer declarations are unchanged
    if (g != 10) {
        return 3;
    }
    return 0;
}
