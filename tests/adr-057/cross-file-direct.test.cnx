// test-execution
// test-adr: 057, 016
// ADR-057 resolution in a fixture that INCLUDES another file (depth 1).
//
// No ADR-057 fixture had an `#include` at all, so the `imported direct` and
// `imported transitive` columns had no fixture -- the rule was tested only
// where every declaration sat in one file. A check that holds in one context
// routinely fails in another (#1219), and the include boundary is exactly the
// axis this matrix exists to watch.

#include "cross-file-provider.cnx"

scope Gauge {
    u32 total <- 0;
    u32 step <- 2;

    // #1241: a scope MEMBER declaration whose initializer resolves a bare name
    // (scope-member context, as distinct from the scope-method cases above).
    const u32 SEED <- 3;
    u32 primed <- SEED;

    u32 bump() {
        return step;
    }

    public void accumulate() {
        // Bare names resolving scope-first while another scope's members are
        // in scope from the include.
        total <- total + bump();
    }

    public u32 readTotal() {
        return total;
    }
}

// A top-level function with a shadowing local: ADR-057 with no enclosing scope,
// in a fixture that reaches another file. `shadow-outside-any-scope` covers this
// same-file; the include boundary is a separate matrix column.
u32 spare <- 40;

u32 detached() {
    u32 spare <- 6;
    return spare;
}

u32 main() {
    Sensor.refresh();
    u32 sensorValue <- Sensor.value();
    if (sensorValue != 10) return 1;

    Gauge.accumulate();
    Gauge.accumulate();
    u32 gaugeTotal <- Gauge.readTotal();
    if (gaugeTotal != 4) return 2;

    u32 detachedValue <- detached();
    if (detachedValue != 6) return 3;
    if (spare != 40) return 4;

    return 0;
}
