// test-execution
// test-adr: 017
// Issue #1669: a member's value names a const from an INCLUDED file. A fold that
// consulted only the file it was reading would find no value for LIB_BASE.

#include "const-lib.cnx"

enum EReg {
    CTRL <- LIB_BASE,
    STATUS,
    DATA <- LIB_BASE + 4
}

u32 main() {
    if ((u32)EReg.CTRL != 64) {
        return 1;
    }
    if ((u32)EReg.STATUS != 65) {
        return 2;
    }
    if ((u32)EReg.DATA != 68) {
        return 3;
    }
    return 0;
}
