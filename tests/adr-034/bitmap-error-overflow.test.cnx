// test-error
// test-adr: 034
// ADR-034: a value written to a bitmap field must fit the field's width.

bitmap8 Flags {
    Mode[3],
    Enable[1],
    Reserved[4]
}

Flags f <- 0;
// #1760 second review: a const is its value, folded by the one binder. The
// field write read the literal text, so `f.Mode <- BIG` stored 4 silently.
const u8 FITS <- 7;
const u8 BIG <- 20;

void main() {
    // NEGATIVE CONTROLS -- declared before the assertions. The widest value
    // each field holds, in each literal base, and a runtime value the rule
    // cannot and must not judge.
    f.Mode <- 7;
    f.Mode <- 0x7;
    f.Mode <- 0b111;
    f.Enable <- 1;
    f.Reserved <- 15;
    f.Mode <- FITS;

    // ASSERTIONS -- one over the maximum, in each base.
    f.Mode <- 8;
    f.Mode <- 0x8;
    f.Mode <- 0b1000;
    f.Enable <- 2;
    f.Reserved <- 16;
    f.Mode <- BIG;
    f.Mode <- FITS + 1;
}
