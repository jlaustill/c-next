// Neither half detects an order leak alone; only the pair does. That is the
// lesson of #1430, where UndeclaredValueAnalyzer was order-dependent and
// nothing in the corpus would have noticed it becoming so.
#include <value-consumer.cnx>
#include <value-source.cnx>

u32 main() {
    return 0;
}
