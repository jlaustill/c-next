// test-execution
// #1701: an `f32` global behind a `u8` local takes float arithmetic. It was
// emitted `x = (uint8_t)(x + 1.5);`.
f32 x <- 0.0;

u8 f() {
    u8 x <- 1;
    global.x +<- 1.5;
    return x;
}

u32 main() {
    u8 local <- f();
    if (local != 1) return 2;
    if (global.x != 1.5) return 1;
    return 0;
}
