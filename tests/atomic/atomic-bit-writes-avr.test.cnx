#pragma target atmega328p
// test-adr: 049
// Issue #2200: a bit, a bit range and a bitmap field written to an atomic
// value are read-modify-writes, made atomic as a compound write to the value
// is, in every spelling: a variable, a bitmap, a scope member through the
// scope's name and through this.

bitmap8 Flags {
    A,
    B,
    Mode[3],
    C,
    D,
    E
}

atomic mut u8 word;
atomic mut u16 wide;
atomic mut Flags flags;
mut u8 plain;

scope Sc {
    public atomic mut Flags paf;

    public void viaThis() {
        this.paf.Mode <- 2;
    }
}

void set(bool on) {
    word[1] <- true;
    word[2, 3] <- 5;
    word[0] <- on;
    wide[9, 4] <- 11;
    flags.Mode <- 3;
    flags.A <- on;
    Sc.paf.B <- true;
    plain[1] <- true;
}

void main() {
    set(true);
    Sc.viaThis();
}
