// test-execution
// #1538: each scope folds an array dimension with its OWN const. Two sibling
// scopes declaring `N` shared one bare key, the last written won, and
// `Small.t` was sized by `Big.N`. Declared Small first: it emitted [10].
scope Small {
    public const u8 N <- 2;
    public u8[N] t;
}

scope Big {
    public const u8 N <- 10;
    public u8[N] b;
}

u32 main() {
    u32 small <- Small.t.element_count;
    if (small != 2) return 1;
    // NEGATIVE CONTROL: the other scope keeps its own size
    u32 big <- Big.b.element_count;
    if (big != 10) return 2;
    return 0;
}
