// test-execution
// #1760 second review: a bitmap-field write built its target from the
// source spelling, not the renderer's. A local shadowing a global wrote the
// global, and in C a bitmap parameter or a field reached through a struct
// parameter was not dereferenced.
bitmap8 Sm {
    A,
    B[3],
    C[4]
}

struct Holder {
    Sm s;
}

Sm fl <- 0;

void wf(Sm s) {
    s.A <- true;
}

void wp(Holder p) {
    p.s.C <- 0xF;
}

scope Sc {
    public u8 method() {
        Sm fl <- 0;
        fl.C <- 5;
        return fl.C;
    }
}

u32 main() {
    Sm fl <- 0;
    fl.C <- 5;
    u8 local <- fl.C;
    if (local != 5) return 1;
    u8 outer <- global.fl.C;
    if (outer != 0) return 2;

    Sm[2] fa <- [0*];
    fa[1].A <- true;
    if (fa[1].A != true) return 3;

    u8 inScope <- Sc.method();
    if (inScope != 5) return 4;

    Sm byRef <- 0;
    wf(byRef);
    if (byRef.A != true) return 5;

    Holder h <- { s: 0 };
    wp(h);
    if (h.s.C != 0xF) return 6;
    return 0;
}
