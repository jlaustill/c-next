// test-error
// Issue #1183 review, round 2: the scope-qualified spelling of the same call.
// Its key is the transpiled C name (Sensors__isReady), not the source-qualified
// one, so it must be built with QualifiedCName rather than by hand (CLAUDE.md).
scope Sensors {
    public bool isReady() {
        return false;
    }
}

u8 n <- 10;

void main() {
    u8 c <- n / Sensors.isReady(); // E0807
}
