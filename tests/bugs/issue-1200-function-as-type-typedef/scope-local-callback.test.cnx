// test-adr: 029, 057
// #1200 / #1207 "what is not fixed" item 2: a function-as-type declared INSIDE
// the scope, referenced bare from a struct in that same scope.
//
// scope-nested-struct.test.cnx covers the global-function case and passes. It
// cannot see this one: registration keys the callback on its qualified name
// (Timing__tickSource) while the field records the bare text (tickSource), so
// the two never match and no _fp typedef is emitted. The header then carries a
// raw `tickSource` that is not a type.
//
// Declaration order is deliberately function-then-struct here;
// scope-local-callback-declared-after.test.cnx swaps them, because order was
// the competing explanation and neither fixture can see the other.
scope Timing {
    public u32 tickSource() {
        return 0;
    }

    public struct Config {
        u32 base;
        tickSource tick;
    }

    public u32 read(const Config timer) {
        return timer.tick();
    }
}
