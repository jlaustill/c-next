// Issue #1127: every qualification form must produce the same identifier in the
// .c and the .h, for struct fields as well as variables. Snapshot test so the
// two files can be compared directly for all four forms.
enum Top {
    A,
    B,
    COUNT
}

scope Motor {
    enum State {
        IDLE,
        RUN,
        COUNT
    }

    // #1300: `public` so this struct stays in the .h. ADR-016 makes an unmarked
    // scope type PRIVATE, and a private type is defined in the .c only -- which
    // would silently delete the ".h, for struct fields" half of what this
    // fixture exists to compare. It was in the header before only because
    // visibility was ignored for scope types.
    public struct Info {
        u8[State.COUNT] viaBare;
        u8[this.State.COUNT] viaThis;
        u8[global.Top.COUNT] viaGlobal;
    }

    public u8[State.COUNT] varBare;
    public u8[this.State.COUNT] varThis;
    public u8[global.Top.COUNT] varGlobal;
}

i32 main() {
    return 0;
}
