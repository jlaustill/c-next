// test-error
// test-adr: 007
// test-transpile-only
// A float bit-range READ needs a shadow variable, which needs function scope,
// so it cannot appear in a file-scope initializer.
//
// #1322: this diagnostic had a second, unreachable copy in
// `helpers/CodeGenErrors.ts`, called only from the wholly dead
// `helpers/ArrayAccessHelper.ts`. Deleting the copy loses no coverage because
// there was none -- the LIVE site in `PostfixExpressionGenerator` had no
// fixture either. This is it, written before the duplicate was removed so the
// deletion is a proven no-op rather than an assumed one.

f32 value <- 1.5;
f32 other <- 2.5;

// NEGATIVE CONTROL -- the same construct inside a function must stay silent.
// It is declared first, and a throw aborts at the first occurrence.
//
// It deliberately uses a DIFFERENT variable and range from the assertion below.
// An earlier version reused `value[0, 8]` here, and the message interpolates
// the identifier and bounds -- so an over-broad check that rejected every float
// bit range produced a byte-identical message and this fixture stayed GREEN.
// A control whose failure is indistinguishable from success is not a control.
u32 inFunction() {
    return other[4, 12];
}

// NEGATIVE CONTROL -- a single bit INDEX at file scope. A single bit is read
// with a mask and a shift, not through a union, so it needs no statement and
// no function to sit in. Only a RANGE is restricted. Without this line, a rule
// that treated any subscript as a range passed every fixture.
bool topBit <- value[31];

// THE ASSERTION -- a float bit range at file scope.
u32 bits <- value[0, 8];
