// test-execution
// #2157: an array parameter given a list receives an array of the
// parameter's full shape (ADR-014: an array's whole value is ADR-035's list,
// a parameter included). A list argument was emitted as a one-element
// compound literal of the element type, which the callee read past.
#include "readers.cnx"

struct S {
    u32 a;
}

u8 third(u8[4] buf) {
    return buf[2];
}

u8 corner(u8[2][2] grid) {
    return grid[1][1];
}

u32 second(S[2] items) {
    return items[1].a;
}

u32 main() {
    u8 t <- third([1, 2, 3, 4]);
    if (t != 3) {
        return 1;
    }
    u8 filled <- third([7*]);
    if (filled != 7) {
        return 2;
    }
    u8 c <- corner([[1, 2], [3, 4]]);
    if (c != 4) {
        return 3;
    }
    u32 s <- second([{ a: 5 }, { a: 6 }]);
    if (s != 6) {
        return 4;
    }
    u32 total <- sumFour([1, 2, 3, 4]);
    if (total != 10) {
        return 5;
    }
    u8[4] src <- [9, 8, 7, 6];
    u8 fromArray <- third(src);
    if (fromArray != 7) {
        return 6;
    }
    return 0;
}
