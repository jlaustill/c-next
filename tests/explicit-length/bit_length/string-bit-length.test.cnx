// test-execution
// Tests .type_bit_length property for strings (ADR-058)
// type_bit_length = capacity x 8, no terminator (ADR-058); the buffer with its
// terminator is the memory row: string<64> = 512 type bits, 520 memory bits

string<64> globalStr <- "Hello";

struct TestStruct {
    string<32> name;
}

i32 main() {
    if (globalStr.memory_bit_length != 520) {
        return 10;
    }
    if (globalStr.type_bit_length != 512) {
        return 1;
    }

    // string<32> = 256 bits
    string<32> localStr <- "World";
    if (localStr.type_bit_length != 256) {
        return 2;
    }

    // string<16> = 128 bits
    string<16> smallStr <- "";
    if (smallStr.type_bit_length != 128) {
        return 3;
    }

    // Test struct member string<32> = 256 bits
    TestStruct ts;
    ts.name <- "Test";
    if (ts.name.type_bit_length != 256) {
        return 4;
    }

    return 0;
}
