// test-execution
// Tests: Const variable declarations and usage
// Demonstrates: const primitives, const in expressions

// Module-level constants
u32 MAX_VALUE <- 100;
u8 VERSION_MAJOR <- 1;
u8 VERSION_MINOR <- 2;
f32 PI <- 3.14159;
bool ENABLED <- true;

u32 main() {
    // Use module-level constants
    if (MAX_VALUE != 100) {
        return 1;
    }
    if (VERSION_MAJOR != 1) {
        return 2;
    }
    if (VERSION_MINOR != 2) {
        return 3;
    }
    if (ENABLED != true) {
        return 4;
    }

    // Local constants
    u32 LOCAL_LIMIT <- 50;
    if (LOCAL_LIMIT != 50) {
        return 5;
    }

    // Constants in expressions
    u32 result <- MAX_VALUE + LOCAL_LIMIT;
    if (result != 150) {
        return 6;
    }

    // Constant used in array operations
    u32[3] data <- [1, 2, 3];
    u32 EXPECTED_LENGTH <- 3;
    if (data.type_element_count != EXPECTED_LENGTH) {
        return 7;
    }

    // Constant in loop bound
    mut u32 sum <- 0;
    u32 ITERATIONS <- 5;
    for (mut u32 i <- 0; i < ITERATIONS; i <- i + 1) {
        sum <- sum + 1;
    }
    if (sum != 5) {
        return 8;
    }

    // Float constant precision
    f32 radius <- 2.0;
    f32 circumference <- 2.0 * PI * radius;
    if (circumference < 12.5 || circumference > 12.6) {
        return 9;
    }

    return 0;
}
