// E0800, as in a statement or an array dimension (ADR-051 §1); it was E0909.
//
// NEGATIVE CONTROL: `B`, whose computed divisor is nonzero.

enum E {
    A <- 4 / (2 - 2),
    B <- 4 / (3 - 2)
}

