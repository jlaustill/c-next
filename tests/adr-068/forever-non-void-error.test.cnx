// test-error
// test-adr: 068
// Coverage: ADR-068 - forever loop only allowed in void functions (E0705)
//
// NEGATIVE CONTROL -- the same loop in a void function is the intended form.
void loopsForever() {
    u8 state <- 0;
    forever {
        state <- 1;
    }
}

u8 alwaysLoops() {
    u8 state <- 0;
    forever {
        state <- 1;
    }
}
