// test-error
// test-adr: 068
// Coverage: ADR-068 / #1075 - always-true relational literal condition (E0707)
void run() {
    u8 state <- 0;
    // NEGATIVE CONTROL -- an always-FALSE literal comparison is #1076's, not
    // this rule's; it must stay silent here.
    while (3 > 5) {
        state <- 2;
    }
    while (5 > 3) {
        state <- 1;
    }
}
