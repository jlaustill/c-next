// test-error
// test-adr: 035
// #2196: a fill-all repeats one value in every slot, and C has no initializer
// that does that for a size it is not told. A dimension that is a C macro does
// not fold in cnx, so `u8[NDIM] a <- [5*]` reached C as `{5U}` and set only
// a[0]. C zero-fills what an initializer leaves out, so a zero fill is right
// for any size; any other fill needs a size cnx can fold (E0866).
// A declaration is asked before the other positions, so it is its own file:
// fill-error.test.cnx holds an assignment target, a field and an argument.
#include "dims.h"

u32 COUNT <- 4;
u8 ZERO <- 0;

// NEGATIVE CONTROL -- zero however it is spelled zero-fills any size, and a
// folded size expands.
u8[NDIM] zeros <- [0*];
u8[NDIM] hexZeros <- [0x0*];
u8[NDIM] constZeros <- [ZERO*];
bool[NDIM] flags <- [false*];
string<4>[NDIM] names <- [""*];
u8[COUNT] fives <- [5*];
u8[4] sevens <- [7*];

// ASSERTION 1 -- a non-zero fill-all for a macro size, at file scope.
u8[NDIM] a <- [5*];

// ASSERTION 2 -- a string array's non-empty fill.
string<4>[NDIM] words <- ["ab"*];

scope Lab {
    // ASSERTION 3 -- a scope member.
    u8[NDIM] rows <- [6*];
}

void f() {
    // ASSERTION 4 -- the same in a function.
    u8[NDIM] b <- [9*];
}
