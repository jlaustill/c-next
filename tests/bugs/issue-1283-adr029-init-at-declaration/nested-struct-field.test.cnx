// test-execution
// test-adr: 029
// #1570: a field whose type is a struct with an ADR-029 default holds that
// default -- for a scalar field and every element of an array field.
u32 onSample(u32 input) {
    return input + 1;
}

struct Inner {
    onSample handler;
    u8 v;
}

struct Outer {
    Inner inner;
    Inner[2] inners;
}

Outer globalOuter;

// Read through a global: a local's default cannot be read before it is
// assigned (ADR-015, #1980); the local forms are asserted by the snapshots.
Outer o;

u32 main() {
    u32 r <- 0;
    u32 input <- 0;
    input <- 1;
    r <- o.inner.handler(input);
    if (r != 2) {
        return 1;
    }
    input <- 2;
    r <- o.inners[1].handler(input);
    if (r != 3) {
        return 2;
    }
    input <- 3;
    r <- globalOuter.inner.handler(input);
    if (r != 4) {
        return 3;
    }
    input <- 4;
    r <- globalOuter.inners[1].handler(input);
    if (r != 5) {
        return 4;
    }
    return 0;
}
