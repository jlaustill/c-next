// test-adr: 029, 057
// ADR-057 kind-awareness, corrected for ADR-029.
//
// `Config` names BOTH a global struct and a scope function. Inside the scope,
// a bare `Config` at a type position resolves to the scope's -- local -> scope
// -> global, and ADR-029 makes the function a type. Before this, the scope
// function was invisible at type positions and the global struct captured the
// name.
//
// Its negative control is scope-variable-does-not-shadow-global-type.test.cnx:
// the same collision with a VARIABLE instead of a function must still resolve
// to the global struct, because a variable is not a type. Together they pin the
// rule as kind-aware rather than "scope always wins".
struct Config {
    u32 marker;
}

scope Timing {
    public u32 Config() {
        return 7;
    }

    public struct Holder {
        Config source;
    }

    public u32 read(const Holder holder) {
        return holder.source();
    }
}
