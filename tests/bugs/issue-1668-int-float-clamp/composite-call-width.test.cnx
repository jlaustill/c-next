// test-execution
// #1668 (C6b, S11): a composite's clamp helper is sized by every value leaf
// the one operand typer types -- a scope method's result included. Before,
// 2.2 typed only the variable, so `small + Meter.reading()` saturated at
// u8's 255 though the sum is a u32.
scope Meter {
    public u32 reading() {
        return 100;
    }

    public u32 doubled(u8 small) {
        return small + this.reading();
    }
}

u32 main() {
    u8 small <- 200;
    u32 r <- small + Meter.reading();
    if (r != 300) {
        return 1;
    }
    u32 d <- Meter.doubled(small);
    if (d != 300) {
        return 2;
    }
    return 0;
}
