// test-execution
// Issue #1175: a dimension the transpiler could not fold was copied into the
// generated C as source text with its spacing removed. Each shape below did:
// `(LOCAL)` named a cnx const C cannot see, `1 - -1` became `1--1` (C's
// decrement) in the .h while the .c folded it to 2, and `(u32)EColor.COUNT + 1`
// put the cnx type name `u32` into the header. Every dimension is now folded
// once, and the .c and the .h carry the same number.
//
// ADR-044: `wide` adds at u16, so it is 400; the same sum at u8 is E0910
// (overflow-dimension.test.cnx), where main's .c clamped it to 255.
//
// NEGATIVE CONTROL: `plain` is a single literal, which was always right.

u8 LOCAL <- 8;
u8 BIG <- 200;

enum EColor {
    RED,
    GREEN,
    COUNT
}

struct Info {
    u8[(LOCAL)] parens;
    u8[(LOCAL) * 2] scaled;
}

u8[1 - -1] neg;
u8[(u32)EColor.COUNT + 1] counted;
u8[1 + 2 + 3] three;
u8[1 << 3] shifted;
u8[4] plain;
u8[(u16)BIG + (u16)BIG] wide;

// File scope, not a local: a local struct's field reads as uninitialized
// even for `.type_element_count`, which is a constant (#1867).
Info info;

u32 main() {
    if (info.parens.type_element_count != 8) {
        return 1;
    }
    if (info.scaled.type_element_count != 16) {
        return 2;
    }
    if (neg.type_element_count != 2) {
        return 3;
    }
    if (counted.type_element_count != 3) {
        return 4;
    }
    if (three.type_element_count != 6) {
        return 5;
    }
    if (shifted.type_element_count != 8) {
        return 6;
    }
    if (plain.type_element_count != 4) {
        return 7;
    }
    if (wide.type_element_count != 400) {
        return 8;
    }
    return 0;
}
