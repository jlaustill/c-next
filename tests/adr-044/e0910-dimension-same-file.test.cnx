// test-error
// test-adr: 044
// ADR-044 "Values fixed at compile time": an array's size is fixed at compile
// time, so arithmetic in it that overflows its operands' width is E0910 rather
// than a silently clamped size. Exercised in all four structural contexts, in the same file.
//
// NEGATIVE CONTROL: each wide array adds at u16, where 400 fits, and must stay
// silent.

u8 LIMIT <- 200;
u8[LIMIT + LIMIT] fileBuf;
u8[(u16)LIMIT + (u16)LIMIT] fileWide;

void run() {
    u8[LIMIT + LIMIT] localBuf;
    u8[(u16)LIMIT + (u16)LIMIT] localWide;
    localBuf[0] <- 1;
    localWide[0] <- 1;
}

scope Holder {
    u8[LIMIT + LIMIT] memberBuf;
    u8[(u16)LIMIT + (u16)LIMIT] memberWide;

    public void fill() {
        u8[LIMIT + LIMIT] methodBuf;
        u8[(u16)LIMIT + (u16)LIMIT] methodWide;
        methodBuf[0] <- 1;
        methodWide[0] <- 1;
    }
}

void main() {}
