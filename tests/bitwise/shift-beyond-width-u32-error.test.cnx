// test-error
// test-coverage: 5.5-shift-beyond-width-error
// Test u32 shift beyond width - should be ERROR (MISRA C:2012 Rule 12.2, E0873)
// Coverage: Section 5.5-5.6 error case - shift beyond type width
//
// #1322 relocated this from `output/`, where it reported `1:0`.
void testU32ShiftBeyondWidth() {
    u32 a <- 1;
    // NEGATIVE CONTROL -- one below the width is the last legal amount.
    u32 ok <- a << 31;
    // u32 is 32 bits, so shifting by 32 or more is undefined/error
    u32 bad_shift <- a << 32; // ERROR: shift amount >= type width
}
