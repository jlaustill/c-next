// test-error
// Tests: #2191, #2237 - E0864 checks an assignment as a declaration, and a concatenation part by the whole-string rule; a fitting write is the control
struct Cfg {
    string<8> name;
}

void f() {
    string<8> a <- "ab";
    string<8> b <- "cd";
    mut string<3> t <- "";
    t <- a + b;
    t <- a;
    t <- "toolong";
    t <- "ok";
    Cfg c <- { name: "xy" };
    string<6> y <- c.name + "z";
    string<9> y2 <- c.name + "z";
}

// A part of unknown length still leaves the measured parts to fit (#2160 review)
void g(string p) {
    string<8> s <- "abcdefgh";
    string<4> x <- s[0, 8] + p;
    string<12> x2 <- s[0, 8] + p;
}
