// Helper file: Various const types at file scope
// Tests that all const type variants get extern in generated .c

// Basic integer const
u8 BYTE_CONST <- 42;
u16 WORD_CONST <- 1000;
u32 DWORD_CONST <- 100000;

// Bounded string const
string<16> STRING_CONST <- "Hello";

// Const array
u8[4] BYTE_ARRAY <- [1, 2, 3, 4];

// Const string array
string<8>[3] STRING_ARRAY <- ["one", "two", "three"];
