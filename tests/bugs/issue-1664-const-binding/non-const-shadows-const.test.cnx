// test-execution
// #1664 review of C11: a name that binds to something other than a folded
// const -- a parameter, a local variable, a `for` variable, a const local
// whose value is only known at run time, a float const -- has no
// compile-time value. The const views added only the folded consts, so each
// of these read the file-scope const of the same name instead: a false
// E0854 (`10 >= 4`, `7 >= 4`) or a false E0800 (the global `D` is 0).
const u32 N <- 10;
const u32 i <- 7;
const u32 D <- 0;

u8 viaParameter(u32 N) {
    u8[4] arr <- [5, 6, 7, 8];
    return arr[N];
}

u8 viaLocal() {
    u8[4] arr <- [5, 6, 7, 8];
    u32 N <- 1;
    return arr[N];
}

u8 viaFor() {
    u8[4] arr <- [5, 6, 7, 8];
    u8 last <- 0;
    for (u32 i <- 0; i < 4; i +<- 1) {
        last <- arr[i];
    }
    return last;
}

u32 viaRuntimeConst(u32 a) {
    const u32 D <- a + 1;
    return 100 / D;
}

f32 viaFloatConst() {
    const f32 D <- 2.5;
    return 10.0 / D;
}

u32 main() {
    u8 p <- viaParameter(2);
    if (p != 7) return 1;
    u8 l <- viaLocal();
    if (l != 6) return 2;
    u8 f <- viaFor();
    if (f != 8) return 3;
    u32 r <- viaRuntimeConst(4);
    if (r != 20) return 4;
    f32 fl <- viaFloatConst();
    if (fl != 4.0) return 5;
    // NEGATIVE CONTROL: the file-scope consts still fold where they are the
    // names in view
    u8[4] arr <- [5, 6, 7, 8];
    u32 q <- N - i;
    if (arr[q] != 8) return 6;
    return 0;
}
