// test-execution
// Comprehensive .type_bit_length test for u32 type across all contexts (ADR-058)
// Tests: .type_bit_length returns 32 for u32 in every possible scope and access pattern
u32 globalVar <- 100000;

scope TestScope {
    public u32 getGlobalBitLength() {
        return global.globalVar.type_bit_length;
    }
    u32 scopeMember <- 100000;
    public u32 getMemberBitLength() {
        return this.scopeMember.type_bit_length;
    }
    public u32 publicMember <- 100000;
}

u32 checkParamBitLength(u32 param) {
    return param.type_bit_length;
}

scope U32BitLen {
    public struct TestStruct {
        u32 member;
    }
}

i32 main() {
    if (globalVar.type_bit_length != 32) {
        return 1;
    }

    u32 result <- TestScope.getGlobalBitLength();
    if (result != 32) {
        return 2;
    }

    result <- TestScope.getMemberBitLength();
    if (result != 32) {
        return 3;
    }

    if (TestScope.publicMember.type_bit_length != 32) {
        return 4;
    }

    u32 localVar <- 100000;
    if (localVar.type_bit_length != 32) {
        return 5;
    }

    u32 testVal <- 100000;
    result <- checkParamBitLength(testVal);
    if (result != 32) {
        return 6;
    }

    U32BitLen.TestStruct ts;
    ts.member <- 100000;
    if (ts.member.type_bit_length != 32) {
        return 7;
    }

    u32[4] arr;
    arr[0] <- 100000;
    if (arr[0].type_bit_length != 32) {
        return 8;
    }

    return 0;
}
