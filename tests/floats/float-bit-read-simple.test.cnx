// test-execution
// test-target-xfail: atmega328p #1709 "Float bit indexing requires 64-bit double"
// Simple test for float bit read inside function

u32 main() {
    f32 testVal <- 1.0;
    u8 byte3 <- testVal[24, 8];
    // For IEEE-754 float, 1.0 = 0x3F800000, byte3 should be 0x3F
    if (byte3 != 0x3F) {
        return 1;
    }
    return 0;
}
