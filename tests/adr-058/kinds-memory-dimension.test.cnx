// test-execution
// test-adr: 058
// The memory row sizes an array (#1975, owner ruling A): cnx writes
// sizeof for the C compiler to answer, as it leaves a header macro's
// dimension to C. Each array then holds exactly its subject's memory, at
// file scope, in a function, for a cnx struct, a header struct, a header
// struct holding a pointer, a string array, and in bits.
#include "kinds-layouts.h"

struct Cfg {
    u32 a;
    u8 b;
}

string<8>[2] names;

mut u8[Cfg.memory_byte_length] raw;
u8[KCfg.memory_byte_length] headerRaw;
u8[KOdd.memory_byte_length] pointerRaw;
u8[names.memory_byte_length] nameBytes;
u8[Cfg.memory_bit_length + 1] cfgBits;

u32 main() {
    mut u8[Cfg.memory_byte_length] local;
    local[0] <- 7;
    raw[0] <- local[0];
    if (raw[0] != 7) {
        return 1;
    }
    if (raw.type_element_count != Cfg.memory_byte_length) {
        return 2;
    }
    if (local.type_element_count != Cfg.memory_byte_length) {
        return 3;
    }
    if (headerRaw.type_element_count != KCfg.memory_byte_length) {
        return 4;
    }
    if (pointerRaw.type_element_count != KOdd.memory_byte_length) {
        return 5;
    }
    if (nameBytes.type_element_count != 18) {
        return 6;
    }
    if (cfgBits.type_element_count != Cfg.memory_bit_length + 1) {
        return 7;
    }
    return 0;
}
