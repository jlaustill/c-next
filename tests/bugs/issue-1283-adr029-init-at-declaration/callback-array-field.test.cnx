// test-execution
// test-no-warnings
// test-adr: 029
// #1565: every element of a callback array field holds the default function,
// not element 0 only. test-no-warnings: the old `.handlers = onSample` was a
// -Wmissing-braces warning that still compiled.
u32 onSample(u32 input) {
    return input + 1;
}

struct Bank {
    onSample[3] handlers;
}

Bank globalBank;

u32 main() {
    u32 r <- 0;
    u32 input <- 0;
    Bank b;
    input <- 1;
    r <- b.handlers[0](input);
    if (r != 2) {
        return 1;
    }
    input <- 2;
    r <- b.handlers[1](input);
    if (r != 3) {
        return 2;
    }
    input <- 3;
    r <- b.handlers[2](input);
    if (r != 4) {
        return 3;
    }
    input <- 4;
    r <- globalBank.handlers[2](input);
    if (r != 5) {
        return 4;
    }
    return 0;
}
