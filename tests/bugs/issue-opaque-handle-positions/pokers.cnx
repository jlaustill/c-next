// The callees for `callback-typedef-cross-file`, one include hop away. Their
// prototypes are right either way: `Dev* d` and `Dev* ds[2]`. What was wrong is
// the callback typedef the INCLUDER builds from their symbols.
#include "dev.h"

void remotePoke(Dev d) {
    dev_poke(d);
}

void remotePokeBoth(Dev[2] ds) {
    dev_poke(ds[0]);
    dev_poke(ds[1]);
}
