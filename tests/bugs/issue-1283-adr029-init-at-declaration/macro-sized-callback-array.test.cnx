// test-execution
// test-no-warnings
// test-adr: 029
// #1283 review: a callback array sized by a C macro still holds the default
// function in every element. C-Next reads the macro's integer value from the
// header, so it can spell each element; the dimension stays the macro.
#include "handler_sizes.h"

u32 onSample(u32 input) {
    return input + 1;
}

struct Inner {
    onSample handler;
}

struct Bank {
    onSample[N_HANDLERS] handlers;
    Inner[N_INNERS] inners;
}

Bank globalBank;
Inner[N_HANDLERS] globalInners;

u32 main() {
    u32 r <- 0;
    Bank b;
    r <- b.handlers[2](1);
    if (r != 2) return 1;
    r <- b.inners[1].handler(2);
    if (r != 3) return 2;
    r <- globalBank.handlers[2](3);
    if (r != 4) return 3;
    r <- globalInners[2].handler(4);
    if (r != 5) return 4;
    Inner[N_INNERS] locals;
    r <- locals[1].handler(5);
    if (r != 6) return 5;
    return 0;
}
