{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/lib/parseWithSymbols.ts",
    "scripts/*.ts",
    "prettier-plugin/src/index.ts",
    "!**/*.test.ts"
  ],
  "project": [
    "src/**/*.ts",
    "scripts/**/*.ts",
    "prettier-plugin/src/**/*.ts",
    "!**/__tests__/**",
    "!**/*.test.ts",
    "!**/__testUtils__/**"
  ],
  "ignore": [
    "tests/**",
    "src/PARSE/2-Parse/grammar/**",
    "src/PARSE/2-Parse/c/grammar/**",
    "src/PARSE/2-Parse/cpp/grammar/**"
  ],
  "ignoreBinaries": ["jscpd", "jq", "dot"],
  "include": ["classMembers"],
  "includeEntryExports": true,
  "vitest": false,
  "ignoreDependencies": ["yaml"]
}
