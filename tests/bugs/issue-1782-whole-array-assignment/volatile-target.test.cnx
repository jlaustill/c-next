// test-execution
// #2161 review: a row of a volatile array, picked by a call, is written
// through a pointer so the call runs once. The pointer kept only the element
// type and dropped `volatile`, which C rejects under -Werror and which would
// turn each register write into a plain store.
volatile mut u8[2][2] regs;
atomic u8[2] flags;
mut u32 rowCalls <- 0;

u32 row() {
    rowCalls +<- 1;
    return 1;
}

u32 main() {
    regs[row()] <- [5, 6];
    if (rowCalls != 1) {
        return 1;
    }
    u8 first <- regs[1][0];
    u8 second <- regs[1][1];
    if (first != 5) {
        return 2;
    }
    if (second != 6) {
        return 3;
    }
    flags <- [1, 0];
    u8 flag <- flags[0];
    if (flag != 1) {
        return 4;
    }
    return 0;
}
