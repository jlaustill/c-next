// test-error
// ADR-013: Error - assigning to const u16 parameter
// Tests: cannot modify const parameter
// test-adr: 013

// NEGATIVE CONTROL -- a mutable sibling assigned and passed the same way
// the const one is; only the const target below is reported.
mut u8 ctlMutable <- 0;
void ctlTake(mut u8 v) {
    v <- 1;
}
void ctlAssign() {
    ctlMutable <- 1;
    ctlMutable +<- 1;
    ctlTake(ctlMutable);
}
void setPort(u16 port) {
    port <- 9090; // ERROR: cannot assign to const parameter
}
