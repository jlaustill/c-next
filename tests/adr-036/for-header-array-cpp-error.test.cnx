// test-error
// test-cpp-only
// test-adr: 036
// #1823: a `for` header declares a scalar loop variable. An array declared
// there, in either spelling, or a string, is E0917; declare it before the loop.
// The C++ twin of for-header-array-error.test.cnx: the same program under --cpp.

u32 main() {
    // NEGATIVE CONTROL -- a scalar loop variable, plain and volatile.
    for (mut u32 i <- 0; i < 3; i <- i + 1) {}
    for (volatile mut u8 k <- 0; k < 3; k <- k + 1) {}

    mut u32 total <- 0;
    for (u8[3] v <- [1, 2, 3]; total < 3; total <- total + 1) {
        if (v[2] != 3) {
            return 1;
        }
    }
    for (u8[][2] m <- [[1, 2], [3, 4]]; total < 6; total <- total + 1) {}
    for (u32 c[2]; total < 9; total <- total + 1) {}
    // #1646's two programs: the prefix form with no initializer, and a modifier on each spelling.
    for (volatile mut u32[2] a; a[0] < 1; a[0] +<- 1) {}
    for (volatile mut u32 b[2]; b[0] < 1; b[0] +<- 1) {}
    // A string is a char array in C, so it is not a scalar loop variable either.
    for (string<8> s <- "ab"; total < 12; total <- total + 1) {}
    for (string t <- "ab"; total < 15; total <- total + 1) {}
    for (string<4>[2] w; total < 18; total <- total + 1) {}
    return 0;
}
