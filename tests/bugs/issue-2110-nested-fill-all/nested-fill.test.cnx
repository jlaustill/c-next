// test-execution
// test-adr: 035
// #2110: a fill-all expands to one value per slot at every level of a whole
// array's list. A fill-all row was emitted as C's `{v}`, which sets only its
// first slot, so the rest read 0 with no warning.
#include "shapes.cnx"

u8 ROWS <- 2;

u32[2][3] globalGrid <- [[1*], [2*]];
u8[ROWS][3] constRows <- [[4*], [5*]];

scope Lab {
    u8[2][2] cells <- [[6*], [7*]];

    public u8 cell() {
        return this.cells[1][1];
    }
}

u8 corner(u8[2][4] g) {
    return g[1][3];
}

u32 main() {
    u32[2][3] grid <- [[1*], [2*]];
    u32[3] row <- [2*];
    u32[2][2][2] cube <- [[[1*], [2*]], [[3*], [4*]]];
    u8[2][3] mixed <- [[1, 2, 3], [9*]];
    mut u8[2][4] local <- [[0*], [0*]];
    local <- [[5*], [6*]];
    Frame f <- { buf: [7*], rows: [[8*], [9*]] };
    u8 passed <- corner([[3*], [4*]]);
    u8 scoped <- Lab.cell();
    // Every slot, not only each row's first
    if (globalGrid[1][2] != 2) {
        return 1;
    }
    if (constRows[1][2] != 5) {
        return 2;
    }
    if (scoped != 7) {
        return 3;
    }
    if (cube[1][1][1] != 4) {
        return 4;
    }
    if (mixed[1][2] != 9) {
        return 5;
    }
    if (local[1][3] != 6) {
        return 6;
    }
    if (f.buf[3] != 7) {
        return 7;
    }
    if (f.rows[1][2] != 9) {
        return 8;
    }
    if (passed != 4) {
        return 9;
    }
    if (grid[1][2] != 2) {
        return 10;
    }
    // NEGATIVE CONTROL -- a spelled-out row and a 1-D fill are unchanged.
    if (mixed[0][2] != 3) {
        return 11;
    }
    if (row[2] != 2) {
        return 12;
    }
    return 0;
}
