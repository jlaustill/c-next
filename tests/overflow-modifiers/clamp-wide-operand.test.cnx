// test-execution
// Tests: clamp with the largest operand a type holds
// Issue #94: Prevents silent truncation when operand exceeds type bounds
// #1618: a literal operand past the type's range is E0868, not a clamp, so
// each test below uses the type's own maximum.
// ADR-044: Per-variable overflow semantics
u32 main() {
    // === U8 TESTS (operands > 255) ===

    // Test 1: u8 subtraction with operand > 255
    mut clamp u8 val8 <- 200;
    val8 -<- 255;
    if (val8 != 0) {
        return 1;
    }

    // Test 2: u8 addition with operand > 255
    val8 <- 100;
    val8 +<- 255;
    if (val8 != 255) {
        return 2;
    }

    // Test 3: u8 multiplication with operand > 255
    val8 <- 10;
    val8 *<- 255;
    if (val8 != 255) {
        return 3;
    }

    // Test 4: u8 subtraction past zero with the type's maximum
    val8 <- 100;
    val8 -<- 255;
    if (val8 != 0) {
        return 4;
    }

    // === U16 TESTS (operands > 65535) ===

    // Test 5: u16 subtraction with operand > 65535
    mut clamp u16 val16 <- 1000;
    val16 -<- 65535;
    if (val16 != 0) {
        return 5;
    }

    // Test 6: u16 addition with operand > 65535
    val16 <- 1000;
    val16 +<- 65535;
    if (val16 != 65535) {
        return 6;
    }

    // === U32 TESTS (operands > UINT32_MAX) ===

    // Test 7: u32 subtraction with operand > 4294967295
    mut clamp u32 val32 <- 1000;
    val32 -<- 4294967295;
    if (val32 != 0) {
        return 7;
    }

    // Test 8: u32 addition with large operand
    val32 <- 4000000000; // 4 billion
    val32 +<- 4294967295; // Would overflow
    if (val32 != 4294967295) {
        return 8;
    }

    // === SIGNED TYPE TESTS ===

    // Test 9: i8 subtraction with operand > 127
    // -50 - 127 = -177 < -128, should clamp to -128
    mut clamp i8 vali8 <- -50;
    vali8 -<- 127;
    if (vali8 != -128) {
        return 9;
    }

    // Test 10: i8 addition with operand > 127
    // 50 + 127 = 177 > 127, should clamp to 127
    vali8 <- 50;
    vali8 +<- 127;
    if (vali8 != 127) {
        return 10;
    }

    // Test 11: i16 subtraction with operand > 32767
    mut clamp i16 vali16 <- -1000;
    vali16 -<- 32767; // Would underflow
    if (vali16 != -32768) {
        return 11;
    }

    // === EDGE CASES ===

    // Test 12: Operand at exact boundary still works
    val8 <- 10;
    val8 +<- 255; // Exactly at max, should clamp to 255
    if (val8 != 255) {
        return 12;
    }

    // Test 13: Normal operations still work correctly
    val8 <- 100;
    val8 +<- 50; // Normal addition within bounds
    if (val8 != 150) {
        return 13;
    }

    // Test 14: Zero operand works
    val8 <- 100;
    val8 -<- 0;
    if (val8 != 100) {
        return 14;
    }

    // The truncation boundary values #94 regressed on (256, 257, 300, 512,
    // 65536, 65537) are literals past the type's range: E0868 since #1618.

    // All tests passed
    return 0;
}
