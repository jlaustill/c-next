// test-execution
// test-adr: 016
// Issue #1333: a scope may be REOPENED. Declaring `scope Lib` again adds members
// to it; it does not redefine it.
//
// ADR-002:256 stated this ("one namespace can span files"). ADR-002 was rejected
// for TERMINOLOGY, not behavior, and ADR-016 superseded it while never restating
// the rule -- so the requirement existed nowhere that governed, and was
// unimplemented. A second declaration was rejected as a duplicate symbol, in one
// file as well as across files.
//
// This is the same-file half. A bare name in the second block resolves against
// the WHOLE scope, not the block: `Point` and `Mode` are declared in the first
// block and used bare in the second.

scope Lib {
    public enum Mode {
        ALPHA <- 1,
        BETA <- 2
    }

    public struct Point {
        u32 x;
        u32 y;
    }
}

scope Lib {
    public u32 useBoth() {
        Mode m <- Mode.BETA;
        Point p <- { x: 3, y: 4 };
        return p.x + p.y + m;
    }
}

u32 main() {
    u32 result <- Lib.useBoth();
    if (result != 9) return 1;
    return 0;
}
