// Helper for issue #1139 — a scope function taking a struct parameter, in a
// file the consumer #includes.
//
// readValue never modifies its parameter, so ADR-006 auto-const applies and
// both the .c definition and the .h prototype must say `const Sample*`.
// bump does modify it, so it must stay non-const — the two together prove the
// auto-const decision is per-parameter and not a blanket qualifier.
struct Sample { u8 value; }

scope Sensors {
    public u8 readValue(Sample sample) {
        return sample.value;
    }

    public void bump(Sample sample) {
        sample.value <- sample.value + 1;
    }
}
