// test-execution
// Tests: a private const with no value to inline -- a string -- is emitted as
// its object and named where it is used
scope S {
    string<8> NAME <- "abc";

    public u32 length() {
        return NAME.value_char_count;
    }
}

u32 main() {
    u32 n <- S.length();
    if (n != 3) {
        return 1;
    }
    return 0;
}
