// test-error
// test-adr: 049
// E0919 (#2233) in a for-loop header: the loop variable's declaration
// carrying both atomic and mut is rejected as a local one is. The mut-only
// loop variable is a control that stays silent.
#pragma target stm32f4

void main() {
    mut u8 n <- 0;
    for (atomic mut u8 j <- 0; j < 3; n +<- 1) {}
    for (mut u8 k <- 0; k < 3; k +<- 1) {}
}
