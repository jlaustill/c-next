// test-error
// test-adr: 007
// Issue #1085 review, Finding 3: a slice longer than the source value width
// would bake in an out-of-range (undefined) shift. It must be a compile error.

// NEGATIVE CONTROL -- a length that exactly matches the source width. 8 bytes
// from a u32 is rejected; 4 bytes from a u32 is the normal case.
u32 exact() {
    u8[16] ok;
    u32 v <- 0x11223344;
    ok[0, 4] <- v;
    return 0;
}

u32 main() {
    u8[16] buffer;
    u32 value <- 0x11223344;
    buffer[0, 8] <- value;
    return 0;
}
