// Issue 1833, owner ruling of 2026-10-13: only a lowercase .cnx is cnx
// source (#2167 retired .cnext). An include naming Colors.CNX is E0518 at the
// directive.
// Before the ruling 1.1 Discover lowercased the extension while every
// output-naming site did not, so an in-place build wrote generated C over
// Colors.CNX and exited 0.
//
// Negative control: the lowercase include beside it must stay silent.

#include "colors-lower.cnx"
#include "Colors.CNX"

void test() {
    ELowerColor c <- ELowerColor.CYAN;
}
