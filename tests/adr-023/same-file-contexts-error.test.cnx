// test-error
// test-adr: 023
// ADR-023: E0603 rejects `sizeof` wherever it is written -- a global
// initializer, a scope member initializer, a scope method, a top-level
// function and a `for` header -- in a file that includes nothing.

u32 globalBad <- sizeof(u32);

scope Probe {
    u32 memberBad <- sizeof(u8);

    public u32 methodBad() {
        u32 local <- sizeof(u16);
        return local;
    }
}

u32 main() {
    u32 functionBad <- sizeof(u64);
    mut u32 total <- functionBad;
    for (mut u32 i <- sizeof(u8); i < 4; i +<- 1) {
        total +<- i;
    }
    return total;
}
