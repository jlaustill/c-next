// test-error
// ADR-013: Error - assigning to const i16 variable
// Tests: cannot assign to const variable
// test-adr: 013

// NEGATIVE CONTROL -- a mutable sibling assigned and passed the same way
// the const one is; only the const target below is reported.
mut u8 ctlMutable <- 0;
void ctlTake(mut u8 v) {
    v <- 1;
}
void ctlAssign() {
    ctlMutable <- 1;
    ctlMutable +<- 1;
    ctlTake(ctlMutable);
}
i16 ALTITUDE <- -500;

void main() {
    ALTITUDE <- 1000; // ERROR: cannot assign to const variable
}
