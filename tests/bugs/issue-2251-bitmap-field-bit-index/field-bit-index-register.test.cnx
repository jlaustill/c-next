#pragma target teensy41
// test-adr: 034
// #2251: a bit of a register member's bitmap field is a bit of the member.
// A write-1 member takes a plain store of the bit at the field's offset
// (5 for Mode[1]); an `rw` member a read-modify-write; an `atomic` bitmap's
// field bit the member's __LDREXB loop.
bitmap8 Pins {
    A,
    B,
    C,
    LED,
    Mode[3],
    R7
}

register GPIO @ 0x40000000 {
    DATA: Pins rw @ 0x00,
    SET: Pins wo @ 0x04,
}

atomic Pins ap;

void set(u8 i) {
    GPIO.SET.Mode[1] <- true;
    GPIO.SET.Mode[0, 2] <- 3;
    GPIO.DATA.Mode[i] <- true;
    ap.Mode[1] <- true;
}

u32 main() {
    set(1);
    bool b <- GPIO.DATA.Mode[2];
    if (b = true) {
        return 1;
    }
    return 0;
}
