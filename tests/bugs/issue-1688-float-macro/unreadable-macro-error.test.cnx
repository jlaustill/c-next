// test-error
// test-adr: 024
// #1688 (ADR-024, owner decision 2026-10-04): a macro whose replacement
// tokens are not a literal expression -- a call, a cast, a pointer
// dereference -- has no type C-Next can read. Combined with an integer it is
// E0811, asking for a cast; it never reaches the integer clamp helper untyped.
#include "unreadable_macros.h"

void main() {
    u32 i <- 3;
    u8 m <- 0x0F;

    // NEGATIVE CONTROL -- no integer operand beside it
    u32 a <- SCALED_CALL;

    // ERRORS -- a call, a cast, a dereference, and compound assignments with
    // the macro as value and as target
    u32 b <- i * SCALED_CALL;
    u32 c <- CAST_LIMIT + i;
    u8 d <- REG_BYTE & m;
    i +<- SCALED_CALL;
    REG_BYTE +<- m;
}
