// test-execution
// #1664 box 7, NEGATIVE CONTROL: the local const has another name, so
// nothing shadows the global `N`; this sized the array 8 before the fix too.
const u32 N <- 8;

u32 first() {
    const u32 M <- 2;
    u32 x <- M;
    return x;
}

u32 second() {
    u8[N] buf;
    buf[7] <- 7;
    u32 n <- buf.element_count;
    u32 last <- buf[7];
    return n + last;
}

u32 main() {
    u32 local <- first();
    if (local != 2) return 1;
    u32 n <- second();
    if (n != 15) return 2;
    return 0;
}
