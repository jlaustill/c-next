// test-error
// test-adr: 007
// #1620: E0856 and E0920 in every context a bit read or write can be written,
// E0888 in both file-scope contexts, and E0890 in both function contexts --
// matrix cells: same file. Each code gets its own matrix, so each must be
// asserted in each of its cells.

mut u8 flags <- 0;
f32 reading <- 1.5;
mut u8[4] arr;

u8 idx() {
    return 1;
}

// global variable
u8 depthGlobal <- flags[4][3];
bool widthGlobal <- flags[20];
u32 floatGlobal <- reading[0, 8];

scope Probe {
    // scope member
    u8 depthMember <- flags[4][3];
    bool widthMember <- flags[0, 9];
    u32 floatMember <- reading[8, 8];

    // scope method
    public void go() {
        flags[1][2] <- true;
        flags[12] <- true;
        arr[idx()][3] <- true;
    }
}

// top-level function, and the `for` header's declaration inside it
void main() {
    arr[1][2][3] <- true;
    bool b <- flags[8];
    arr[idx()][0, 2] <- 1;
    for (mut u8 i <- flags[4][3]; i < 3; i +<- 1) {}
    for (mut u8 j <- flags[6, 4]; j < 3; j +<- 1) {}
    // NEGATIVE CONTROL -- in range, one bit index, a literal subscript
    flags[7] <- true;
    arr[1][3] <- true;
}
