// test-execution
// test-c-only
// Tests .type_bit_length property for enum type (ADR-058)
// Enums are 32 bits by default (ADR-017)

enum Color {
    Red,
    Green,
    Blue
}
enum State {
    IDLE,
    RUNNING,
    STOPPED
}

Color globalColor <- Color.Red;

scope EnumBitLen {
    public struct TestStruct {
        State state;
    }
}

i32 main() {
    // A three-member enum's type length: the fewest bits for 0..2 (ADR-058)
    if (globalColor.type_bit_length != 2) {
        return 1;
    }

    // Test local enum
    State localState <- State.IDLE;
    if (localState.type_bit_length != 2) {
        return 2;
    }

    // Test struct member enum
    EnumBitLen.TestStruct ts;
    ts.state <- State.RUNNING;
    if (ts.state.type_bit_length != 2) {
        return 3;
    }

    return 0;
}
