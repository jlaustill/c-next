// test-execution
// #1668 review: a bit write through a local that shadows a global writes the
// local. The write rebuilt its target from the source spelling, `gs`, while
// the local is emitted as `f__gs`: the bits went to the global, and the
// program compiled clean.
struct S {
    u8 flags;
    u8[4] arr;
}

S gs;

u32 f() {
    S gs <- global.gs;
    gs.flags[2] <- true;
    gs.arr[1][3] <- true;
    gs.arr[2][0, 4] <- 5;
    if (global.gs.flags != 0) return 1;
    if (global.gs.arr[1] != 0) return 2;
    if (global.gs.arr[2] != 0) return 3;
    if (gs.flags != 4) return 4;
    if (gs.arr[1] != 8) return 5;
    if (gs.arr[2] != 5) return 6;
    return 0;
}

// NEGATIVE CONTROL: with no local in the way, the global is written
void g() {
    gs.flags[1] <- true;
}

u32 main() {
    u32 result <- f();
    g();
    if (gs.flags != 2) return 10;
    return result;
}
