// test-error
// test-adr: 024
// E0810, E0811 and E0812 across ONE include hop -- matrix cells: for header,
// imported direct. The integer (wideShared) and the float (floatShared) are
// declared elsewhere: a check reading only this file finds no category for
// them, and an unknown category never rejects. The macro's header is this
// file's own, because the macros a file sees are the ones C sees for it
// (ADR-024); a C header is not an include hop.
#include "conversion-declarations.cnx"
#include "float-declarations.cnx"
#include "unreadable_macros.h"

void loops() {
    // NEGATIVE CONTROL 1 -- the integer cast to the float's category.
    for (f32 okCategory <- (f32)wideShared * floatShared; okCategory < 9.0; okCategory +<- 1.0) {}
    // ASSERTION 1 -- E0810: an integer and a float under one operator.
    for (f32 mixed <- wideShared * floatShared; mixed < 9.0; mixed +<- 1.0) {}

    // NEGATIVE CONTROL 2 -- the macro cast to the type it has, under +.
    for (u32 okSum <- wideShared + (u32)SCALED_CALL; okSum < 9; okSum +<- 1) {}
    // ASSERTION 2 -- E0811: an integer beside an unreadable macro under +.
    for (u32 sum <- wideShared + SCALED_CALL; sum < 9; sum +<- 1) {}

    // NEGATIVE CONTROL 3 -- the macro cast to the type it has, under /.
    for (u32 okQuotient <- wideShared / (u32)SCALED_CALL; okQuotient < 9; okQuotient +<- 1) {}
    // ASSERTION 3 -- E0812: an integer beside an unreadable macro under /.
    for (u32 quotient <- wideShared / SCALED_CALL; quotient < 9; quotient +<- 1) {}
}
