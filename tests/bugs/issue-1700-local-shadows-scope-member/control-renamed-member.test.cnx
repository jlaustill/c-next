// test-execution
// #1700 NEGATIVE CONTROL: the same method with the member renamed -- nothing
// is shadowed, and the helper was always u8's.
scope S {
    u32 z <- 0;

    public u8 f() {
        u8 x <- 200;
        u8 y <- x + x;
        return y;
    }
}

u32 main() {
    u8 r <- S.f();
    if (r != 255) return 1;
    return 0;
}
