// test-c-only
// #1205 / MISRA C:2012 Rule 8.4: a struct with a callback field gets a generated
// <Struct>_init() (ADR-029). It is emitted with external linkage and no static,
// so it needs a visible declaration -- but it is generated rather than written,
// so it is not a symbol the header path filters and no prototype is emitted.
struct Message {
    u32 id;
}

void onReceive(const Message msg) {
}

struct Controller {
    onReceive handler;
}
