// test-error
// test-cpp-only
// test-adr: 014
// #1620: E0508 is decided by where the initializer stands, so a program that
// includes a cnx file two includes away, through a helper fires it at file scope and in a
// scope member as it does with no include. The included `Cfg` in the same
// positions and the C++ class inside a method are the controls.
#include "lib/struct-init-chain.cnx"
#include "CppTestClass.hpp"

CppTestClass atFileScope <- { value: 1 };
Cfg control <- { word: 1, f: 0 };

scope Holder {
    private CppTestClass member <- { value: 2 };
    private Cfg plain <- { word: 2, f: 0 };

    public void go() {
        CppTestClass inside <- { value: 3 };
    }
}

void main() {}
