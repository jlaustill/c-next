// test-execution
// Issue #1953: a block-local that shadows a global is renamed only inside its block
// The sizeof after the block measures the global, and a sibling block renames its own local

u8[4] buf <- [0, 0, 0, 0];
u8 count <- 7;

u32 main() {
    u32 flag <- 1;
    if (flag = 1) {
        u8[8] buf <- [0, 0, 0, 0, 0, 0, 0, 0];
        if (sizeof(buf) != 8) return 1;
    }
    if (sizeof(buf) != 4) return 2;
    if (flag = 1) {
        u8[2] buf <- [0, 0];
        if (sizeof(buf) != 2) return 3;
    }
    if (sizeof(buf) != 4) return 4;

    if (flag = 1) {
        u8 count <- 3;
        if (count != 3) return 5;
    }
    if (count != 7) return 6;

    u32 fresh <- 5;
    if (fresh != 5) return 7;
    return 0;
}
