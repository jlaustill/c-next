// test-execution
// Issue #1044: initializing a string from another string variable must use a
// bounded copy (cnx_string_copy, #1731), not an unbounded strcpy (CWE-120,
// flawfinder MS-banned). This must match the reassignment code path exactly.
i32 main() {
    string<32> small <- "Test";
    string<64> big <- small; // init from variable
    // big must hold an exact, null-terminated copy of small (proves the
    // bounded copy copied correctly rather than truncating or overrunning).
    if (big != "Test") {
        return 1;
    }
    if (big.value_char_count != 4) {
        return 2;
    }
    return 0;
}
