// test-execution
// test-no-warnings
// test-adr: 034
// #1651: a bitmap field assignment emitted a STRUCT member write when the
// bitmap-typed variable was declared in an included file.
//
//     shared.Active <- 1      same file  ->  shared = (shared & ~(1U << 0)) | ...
//     shared.Active <- 1      one hop    ->  shared.Active = 1
//
// `Flags` is a bitmap typedef -- a scalar -- so the cross-file form is a member
// access on an integer and gcc refuses it outright:
//
//     error: request for member 'Active' in something not a structure or union
//
// with the transpiler exiting 0.
//
// CAUSE. `AssignmentClassifier` decides bitmap-field-write from the target's
// type info, and the cross-file path built that info through
// `convertTSymbolToTypeInfo`, which did not set `isBitmap`. The classifier saw
// an ordinary member access and dispatched the struct handler.
//
// This is #1303 again -- *"ADR-044 clamp is silently dropped for a u8 declared
// in an included .cnx -- same statement clamps locally, wraps cross-file"* --
// and it has the same fix: carry the fact on the symbol instead of re-deriving
// it after the boundary. A second derivation that happens to agree same-file is
// what both bugs are made of.
//
// #1749: the same field reached through a chain -- an included struct's
// member, an element of its bitmap array, a member of an included struct
// array's element -- is one bit write too.
//
// `local` is the NEGATIVE CONTROL: a bitmap declared in THIS file, which was
// always correct and must stay correct. A fix that made the cross-file path
// work by breaking the local one fails here.
#include "lib/flags.cnx"

bitmap8 LocalFlags {
    On[1],
    Mode[3],
    Spare[4]
}

mut LocalFlags local <- 0;

u32 main() {
    // Cross-file bitmap: the case that emitted a struct member write.
    shared.Active <- 1;
    shared.Level <- 5;

    // Cross-file bitmap through a chain (#1749).
    sharedHolder.fl.Level <- 6;
    sharedHolder.fls[1].Ready <- 1;
    sharedHolders[1].fl.Active <- 1;

    // Same-file bitmap: the control.
    local.On <- 1;
    local.Mode <- 3;

    if (shared.Active != 1) {
        return 1;
    }
    if (shared.Level != 5) {
        return 2;
    }
    if (local.On != 1) {
        return 3;
    }
    if (local.Mode != 3) {
        return 4;
    }
    if (sharedHolder.fl.Level != 6) {
        return 5;
    }
    if (sharedHolder.fls[1].Ready != 1) {
        return 6;
    }
    if (sharedHolder.fls[0].Ready != 0) {
        return 7;
    }
    if (sharedHolders[1].fl.Active != 1) {
        return 8;
    }
    if (sharedHolders[0].fl.Active != 0) {
        return 9;
    }
    return 0;
}
