// test-cpp-only
// test-execution
// #1668 (box 3, S19): `choose` is a C++ overload set whose results disagree
// in category -- uint32_t and float -- so which one a call selects is C++'s
// decision, and the typer leaves it indeterminate. Integer saturation never
// applies to it: `u * choose(y)` is C++'s own arithmetic, 7.5. Before, it went
// through the u32 clamp helper, which converted 2.5 to 2 and gave 6.0.
#include "ovl.hpp"

u32 main() {
    u32 u <- 3;
    f32 y <- 2.5;
    f32 r <- u * choose(y);
    if (r != 7.5) return 1;
    return 0;
}
