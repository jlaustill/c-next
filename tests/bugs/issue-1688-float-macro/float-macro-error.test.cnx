// test-error
// test-adr: 024
// #1688 (ADR-024, owner decision 2026-10-04): a macro operand is typed from
// its replacement tokens, and a floating literal anywhere in them makes it
// floating. Combined with an integer it is E0810, as any int x float mix is.
// Before, a macro had no type, so `u32 i * SCALE_F` was routed into the
// integer clamp helper and 3 x 2.5 evaluated to 6.0, exit 0.
#include "float_macros.h"

void main() {
    u32 i <- 3;
    f32 k <- 1.0;

    // NEGATIVE CONTROLS -- no integer operand, and an integer macro
    f32 a <- k * SCALE_F;
    u32 b <- i + LIMIT;

    // ERRORS -- a float literal, one reached through another macro, either order
    f32 c <- i * SCALE_F;
    f32 d <- i * VREF_SCALED;
    f32 e <- SCALE_F * i;
}
