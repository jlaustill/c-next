// test-error
// Tests: the reserved-prefix rule is case-insensitive (E0202, ADR-063)
// Include guards are uppercase by C convention (CNX_<PATH>_H) while identifiers
// are not, so one case-insensitive rule covers both. It also forecloses the
// confusing near-miss: without it, `Cnx_state` would be legal, would read as
// transpiler output to every reviewer, and would be neither.

const u8 CNX_LIMIT <- 4;

u32 main() {
    return 0;
}
