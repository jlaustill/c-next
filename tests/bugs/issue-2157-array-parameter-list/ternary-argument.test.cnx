// test-execution
// test-adr: 014
// #2157: a ternary whose arms are both arrays is passed for an array
// parameter as it stands, the way each arm is on its own. It was emitted as
// a one-element compound literal of the element type, which C rejects.
#include "readers.cnx"

struct Gears {
    u8[4] low;
    u8[4] high;
}

u8 peak(u8[4] table) {
    return table[3];
}

u8 corner(u8[2][2] grid) {
    return grid[1][1];
}

u8 viaCallback(peak cb, u8[4] a, u8[4] b) {
    return cb((a[0] < b[0]) ? a : b);
}

u8[4] lowGear <- [10, 20, 30, 40];
u8[4] highGear <- [50, 60, 70, 80];
u8[2][4] table <- [[1, 2, 3, 4], [5, 6, 7, 8]];
u8[2][2] one <- [[1, 2], [3, 4]];
u8[2][2] two <- [[5, 6], [7, 8]];
Gears gears <- { low: [1, 1, 1, 9], high: [2, 2, 2, 8] };

u32 main() {
    u8 gear <- lowGear[0] / 5;
    // Each arm, at a named callee
    u8 high <- peak((gear > 1) ? highGear : lowGear);
    u8 low <- peak((gear > 5) ? highGear : lowGear);
    // A callee declared across an include
    u32 sum <- sumFour((gear > 5) ? highGear : lowGear);
    // Struct members and rows as arms
    u8 member <- peak((gear > 1) ? gears.high : gears.low);
    u8 row <- peak((gear > 1) ? table[1] : table[0]);
    // A two-dimensional parameter
    u8 square <- corner((gear > 1) ? two : one);
    // A callback, given its parameters as arms
    u8 called <- viaCallback(peak, lowGear, highGear);
    if (high != 80) {
        return 1;
    }
    if (low != 40) {
        return 2;
    }
    if (sum != 100) {
        return 3;
    }
    if (member != 8) {
        return 4;
    }
    if (row != 8) {
        return 5;
    }
    if (square != 8) {
        return 6;
    }
    if (called != 40) {
        return 7;
    }
    return 0;
}
