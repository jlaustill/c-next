// Helper (not a test): consts and a function with a non-const parameter, for
// the cross-file ADR-013 fixtures. Const-ness is a property of the
// DECLARATION, which lives here, so both rules have to reach across the include.
u8 LIMIT <- 10;
u8[4] TABLE <- [1, 2, 3, 4];

u8 consume(mut u8 v) {
    v <- 1;
    return v;
}

void keep(u8 v) {
    u8 copy <- v;
}
