// test-execution
// #1863 review: a const read a length property before 1.4 had sized the
// array (`K <- loc.type_element_count`), and a local was sized against 1.3's
// unsized global, so each had no value -- a false E0909. Consts and
// dimensions now settle together, and the frames read the sized symbols.
//
// NEGATIVE CONTROL: `direct`, sized by a literal.

u32 N <- 4;
u8[N] garr;
u32 FILE_K <- garr.type_element_count;
mut u8[FILE_K] other;

u32 main() {
    mut u8[garr.type_element_count] loc;
    u32 K <- loc.type_element_count;
    mut u8[K + 1] after;
    mut u8[2] direct;
    loc[0] <- 1;
    after[0] <- 1;
    other[0] <- 1;
    direct[0] <- 1;
    if (after.type_element_count != 5) {
        return 1;
    }
    if (other.type_element_count != 4) {
        return 2;
    }
    return 0;
}
