// test-error
// test-adr: 007
// #1760 review: a bit, bit-range or bitmap-field write reads its target and
// writes it back, so every subscript in the target is evaluated twice. A call
// or a volatile read there would run twice, and the write could land on a
// different element than the read (E0890). The silent lines are controls: a
// plain element write evaluates once, a write-1 register member is written
// without being read, and an index with no side effect is fine.
bitmap8 Mode {
    fast,
    slow,
    level[6]
}

register GPIO @ 0x40000000 {
    DR: u32 rw @ 0x00,
    DR_SET: u32 wo @ 0x04,
}

struct Pair {
    u8 lo;
    u32 bits;
}

u8[4] arr <- [0*];
Pair[2] pairs;
f32 level <- 0.0;
Mode[4] modes;
volatile u8 vidx <- 0;
u32 word <- 0;

u8 idx() {
    return 1;
}

void update() {
    u8 i <- 2;
    arr[idx()][3] <- true;
    word[idx()] <- true;
    arr[vidx][2, 4] <- 5;
    modes[idx()].fast <- true;
    GPIO.DR[idx()] <- true;
    pairs[idx()].bits[3] <- true;
    level[idx()] <- true;
    arr[idx()] <- 7;
    GPIO.DR_SET[idx()] <- true;
    arr[i][3] <- true;
    word[i] <- true;
    modes[i].slow <- true;
}
