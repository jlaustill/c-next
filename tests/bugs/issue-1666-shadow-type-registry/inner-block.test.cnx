// test-execution
// #1666: an inner block's `u8 v` does not change the enclosing `u32 v`'s type
// after the block closes. It emitted `uint32_t b = 8;`.
u32 probe(bool c) {
    u32 v <- 0;
    u32 inner <- 0;
    if (c = true) {
        u8 v <- 1;
        inner <- v.bit_length;
    }
    u32 b <- v.bit_length;
    return b + inner;
}

u32 main() {
    u32 widths <- probe(true);
    if (widths != 40) return 1;
    return 0;
}
