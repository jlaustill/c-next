// test-error
// ADR-013: Error - compound assignment to const u64
// Tests: cannot use compound subtraction on const u64 variable
// test-adr: 013

// NEGATIVE CONTROL -- a mutable sibling assigned and passed the same way
// the const one is; only the const target below is reported.
u8 ctlMutable <- 0;
void ctlTake(u8 v) {
    v <- 1;
}
void ctlAssign() {
    ctlMutable <- 1;
    ctlMutable +<- 1;
    ctlTake(ctlMutable);
}
const u64 TOTAL <- 1000000;

void main() {
    TOTAL -<- 1; // ERROR: cannot assign to const variable
}
