// test-error
// test-adr: 068
// E0705 and E0707 across ONE include hop -- matrix cells: imported direct,
// top-level function and scope method. The non-void return type is an enum
// declared in the included file.

#include "loop-declarations.cnx"

scope Motor {
    u32 ticks <- 0;

    // NEGATIVE CONTROL -- a void method may loop forever, and a condition on
    // an imported constant is not a literal comparison (#1076 owns it).
    public void spin() {
        while (this.ticks < global.LOOP_LIMIT) {
            this.ticks +<- 1;
        }
        forever {
            this.ticks +<- 1;
        }
    }

    // ASSERTION -- E0705 in a scope method returning an imported enum.
    public Mode wait() {
        forever {
            this.ticks +<- 1;
        }
    }

    // ASSERTIONS -- E0707, both forms, in a scope method.
    public void poll() {
        for (; ; ) {
            this.ticks +<- 1;
        }
        while (2 >= 1) {
            this.ticks +<- 1;
        }
    }
}

// ASSERTION -- E0705 in a top-level function returning an imported enum.
Mode run() {
    mut u8 n <- 0;
    forever {
        n +<- 1;
    }
}

// ASSERTIONS -- E0707, both forms, in a top-level function.
void main() {
    mut u8 n <- 0;
    for (; ; ) {
        n +<- 1;
    }
    while (1 = 1) {
        n +<- 1;
    }
}
