// test-execution
// #2010: a scalar parameter written only in a `for` header (init or update)
// is passed by reference, so the caller observes the write.
u32 sink <- 0;

void zeroInit(u32 n) {
    for (n <- 0; sink < 3; sink +<- 1) {}
}

void bumpUpdate(u32 n) {
    for (u32 i <- 0; i < 3; n +<- 1) {
        i +<- 1;
    }
}

// Control: a parameter only read in a `for` header stays unmodified.
u32 readOnly(u32 n) {
    u32 count <- 0;
    for (u32 i <- 0; i < n; i +<- 1) {
        count +<- 1;
    }
    return count;
}

u32 main() {
    u32 w <- 9;
    zeroInit(w);
    if (w != 0) {
        return 1;
    }
    u32 v <- 5;
    bumpUpdate(v);
    if (v != 8) {
        return 2;
    }
    u32 r <- 4;
    u32 counted <- readOnly(r);
    if (counted != 4) {
        return 3;
    }
    return 0;
}
