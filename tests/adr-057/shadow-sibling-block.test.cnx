// test-execution
// test-adr: 057
// #1668 (C7): a local that shadows a global is in scope only in its own
// block. After the block closes, the name is the global again. The emitter
// asked a per-function set of local names, so every later use in the
// function took the block local's renamed C name -- `main__x = 3U;` outside
// the block that declared it, which C rejects, with the transpile exiting 0.
u32 x <- 5;

u32 main() {
    {
        u8 x <- 1;
        x <- 2;
        if (x != 2) {
            return 1;
        }
    }

    // ASSERTIONS: the global, written and read after the block
    x <- 3;
    if (x != 3) {
        return 2;
    }
    if (global.x != 3) {
        return 3;
    }

    return 0;
}
