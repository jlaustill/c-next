// test-error
// Issue #2076: a header struct holding a pointer has no length (#1975, owner
// ruling: cnx has no pointers), so it cannot size an array either.
//
// NEGATIVE CONTROL: `Odd.i`, the struct's other field, sizes one.
#include "dims.h"

u8[Odd.i.type_byte_length] ok;
u8[Odd.type_byte_length] bad;

u32 main() {
    return ok.type_element_count + bad.type_element_count;
}
