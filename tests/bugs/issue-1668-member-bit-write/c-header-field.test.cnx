// test-execution
// #1668 (C12): a C header struct's integer field takes a bit write like a
// C-Next one. The write path knew only C-Next integer names, so `uint8_t`
// was not an integer to it and `cs.flags[3] <- true` was emitted
// `cs.flags[3] = true;`, which C rejects.
#include "cf.h"

cf_t cs;

u32 main() {
    // ASSERTION: a C header field
    cs.flags[3] <- true;
    u8 f <- cs.flags;
    if (f != 8) return 1;

    // NEGATIVE CONTROL: an element of a C array field is an element write
    cs.bytes[1] <- 7;
    u8 b <- cs.bytes[1];
    if (b != 7) return 2;
    return 0;
}
