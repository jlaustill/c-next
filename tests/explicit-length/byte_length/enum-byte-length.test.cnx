// test-execution
// test-c-only
// Tests .type_byte_length property for enum type (ADR-058)
// Enums are 4 bytes (32 bits) by default

enum Color {
    Red,
    Green,
    Blue
}
enum State {
    IDLE,
    RUNNING,
    STOPPED
}

Color globalColor <- Color.Red;

scope EnumByteLen {
    public struct TestStruct {
        State state;
    }
}

i32 main() {
    // A three-member enum's 2 bits, rounded up to a byte (ADR-058)
    if (globalColor.type_byte_length != 1) {
        return 1;
    }

    // Test local enum
    State localState <- State.IDLE;
    if (localState.type_byte_length != 1) {
        return 2;
    }

    // Test struct member enum
    EnumByteLen.TestStruct ts;
    ts.state <- State.RUNNING;
    if (ts.state.type_byte_length != 1) {
        return 3;
    }

    return 0;
}
