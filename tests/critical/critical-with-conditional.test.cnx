// test-c-only
#pragma target cortex-m7
// ADR-050: Critical section with conditional
// Tests: if/else inside critical section
mut u32 counter <- 0;

mut u32 overflows <- 0;

void safeIncrement() {
    critical {
        if (counter < 1000) {
            counter +<- 1;
        } else {
            overflows +<- 1;
            counter <- 0;
        }
    }
}
