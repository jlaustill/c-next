// test-error
// Issue #2076: a header struct holding a pointer has no length (#1975, owner
// ruling: C-Next has no pointers), so it cannot size an array either.
//
// NEGATIVE CONTROL: `Odd.i`, the struct's other field, sizes one.
#include "dims.h"

u8[Odd.i.byte_length] ok;
u8[Odd.byte_length] bad;

u32 main() {
    return ok.element_count + bad.element_count;
}
