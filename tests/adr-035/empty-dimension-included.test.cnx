// test-error
// test-adr: 035
// ADR-035, E0892 (#1822): the cross-file half. The included declaration is
// rejected at its own position, and its missing size is not invented. Before
// #1822 the read below was also a false E0854 ("2 >= 2 for 'rows[1]'"),
// because 1.3 gave the inner dimension the outer list's count.
#include "empty-dimension-lib.cnx"

u8 readRows() {
    return rows[1][2];
}
