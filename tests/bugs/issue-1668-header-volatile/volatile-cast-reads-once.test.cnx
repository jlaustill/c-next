// #1760 review: a saturating cast of a header volatile reads it once. The
// qualifier was dropped -- by the C collectors for a variable or a typedef,
// and by the typer for a struct field -- so the value had no side effect and
// the cast was inlined as a bounded ternary that reads it three times.
#include "sensor_regs.h"

void sample() {
    u8 a <- (u8)vf;
    u8 b <- (u8)tv;
    u8 c <- (u8)hw.level;
    // Control: a plain header float is read inline, as before
    u8 d <- (u8)nf;
}
