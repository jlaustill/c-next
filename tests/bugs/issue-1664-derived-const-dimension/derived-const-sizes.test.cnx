// test-execution
// test-no-warnings
// test-target-xfail: atmega328p c #1765 "initializer element is not constant"
// A const derived from another const sizes an array like a literal one does.
// 1.3 and 1.4 folded integer literals only, and render re-folded the rest
// itself. So `u8[B] table` was `table[4]` in the .c and `table[B]` in the .h,
// a struct field was `data[B]`, and a scope member was
// `Buffer__bytes[Buffer__C]`: variably modified at file scope, which C rejects
// and MISRA C:2012 Rule 18.8 forbids. The consts are aliases, not arithmetic:
// arithmetic in a file-scope const initializer is #1735.
const u32 A <- 4;
const u32 B <- A;

struct Packet {
    u8[B] data;
}

u8[B] table;
Packet packet;

scope Buffer {
    public const u32 C <- B;
    public u8[C] bytes;
}

// NEGATIVE CONTROL: a literal const sized arrays before this change too
const u32 L <- 3;
u8[L] literal;

u32 main() {
    u32 t <- table.element_count;
    if (t != 4) {
        return 1;
    }
    u32 p <- packet.data.element_count;
    if (p != 4) {
        return 2;
    }
    u32 c <- Buffer.bytes.element_count;
    if (c != 4) {
        return 3;
    }
    u8[B] local;
    local[3] <- 1;
    u32 last <- local[3];
    if (last != 1) {
        return 4;
    }
    u32 l <- literal.element_count;
    if (l != 3) {
        return 5;
    }
    return 0;
}
