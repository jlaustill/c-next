// test-adr: 004
// #2258, #2155 review 9: a register member typed by a C-Next enum is typed
// as that enum, so it compares with the enum's members and initializes an
// enum binding. Round 8 typed it as nothing (false E0434), and `main` typed
// it as an integer (false E0428).
enum EMode {
    IDLE,
    RUN,
    STOP
}

register DEV @ 0x40000000 {
    EM: EMode rw @ 0x04,
}

mut u8 sink;

void main() {
    u8 y <- (DEV.EM = EMode.IDLE) ? 1 : 2;
    bool b <- DEV.EM != EMode.STOP;
    EMode m <- DEV.EM;
    sink <- y;
    if (b = true) {
        sink <- 3;
    }
    if (m = EMode.RUN) {
        sink <- 4;
    }
}
