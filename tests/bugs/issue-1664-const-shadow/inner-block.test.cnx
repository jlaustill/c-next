// test-execution
// #1664 box 7: the same shadow reached from inside one function. The inner
// block's `const N <- 2` is out of scope after the block, where `N` is the
// global 8 again.
const u32 N <- 8;

u32 probe() {
    u32 x <- 0;
    {
        const u32 N <- 2;
        x <- N;
    }
    u8[N] buf;
    buf[7] <- 7;
    u32 n <- buf.element_count;
    u32 last <- buf[7];
    return n + last + x;
}

u32 main() {
    u32 n <- probe();
    if (n != 17) {
        return 1;
    }
    return 0;
}
