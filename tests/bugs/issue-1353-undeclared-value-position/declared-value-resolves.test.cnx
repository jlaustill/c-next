// NEGATIVE CONTROL for issue #1353 — this file must stay SILENT.
// REACHABLE_LIMIT is genuinely included here, so reading it must keep
// working. If this fixture starts erroring, the check is over-firing.
//
// The read is inside a function on purpose: a cross-file const in a
// FILE-SCOPE initializer emits a non-constant initializer (issue #1218),
// which is a separate defect and would make this control fail for a
// reason that has nothing to do with #1353.
#include <value-reachable.cnx>

u32 main() {
    u32 borrowedProperly <- REACHABLE_LIMIT;
    if (borrowedProperly != 99) {
        return 1;
    }
    return 0;
}
