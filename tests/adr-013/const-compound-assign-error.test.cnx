// test-error
// ADR-013: Error - compound assignment to const
// Tests: cannot use compound assignment on const variable
// test-adr: 013

// NEGATIVE CONTROL -- a mutable sibling assigned and passed the same way
// the const one is; only the const target below is reported.
u8 ctlMutable <- 0;
void ctlTake(u8 v) {
    v <- 1;
}
void ctlAssign() {
    ctlMutable <- 1;
    ctlMutable +<- 1;
    ctlTake(ctlMutable);
}
const u32 COUNTER <- 0;

void main() {
    COUNTER +<- 1; // ERROR: cannot assign to const variable
}
