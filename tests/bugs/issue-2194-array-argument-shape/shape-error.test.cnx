// test-error
// test-adr: 014
// #2194: an array argument is passed by reference, so the callee reads it
// with the parameter's shape. An array of another shape was accepted at
// exit 0, and the callee read past a shorter one.
#include "readers.cnx"

u8 third(u8[4] buf) {
    return buf[2];
}

u8 corner(u8[2][2] m) {
    return m[1][1];
}

u8 initial(string<8>[2] names) {
    return names[0][0];
}

u8[2] small <- [1, 2];
u8[6] wide <- [1, 2, 3, 4, 5, 6];
u8[4] exact <- [1, 2, 3, 4];
u8[2][3] wideRows <- [[1, 2, 3], [4, 5, 6]];
u8[2][2] square <- [[1, 2], [3, 4]];
string<8>[2] labels <- ["ab", "cd"];

void f() {
    // NEGATIVE CONTROL -- an array of the parameter's shape, at each callee.
    u8 ok <- third(exact);
    u8 okRows <- corner(square);
    u8 okIncluded <- fourth(exact);
    u8 okStrings <- initial(labels);

    // ASSERTION 1 -- a shorter array.
    u8 a <- third(small);
    // ASSERTION 2 -- a longer array.
    u8 b <- third(wide);
    // ASSERTION 3 -- a different inner size.
    u8 c <- corner(wideRows);
    // ASSERTION 4 -- a callee declared across an include.
    u8 d <- fourth(small);

    // NEGATIVE CONTROL -- a ternary whose arms both have the parameter's shape.
    u8 okTernary <- third((exact[0] = 1) ? exact : exact);
    // ASSERTION 5 -- a ternary's arm of a shorter shape.
    u8 e <- third((exact[0] = 1) ? exact : small);
    // ASSERTION 6 -- a ternary's arm that is a list, which is not passed as it stands.
    u8 g <- third((exact[0] = 1) ? [1, 2, 3, 4] : exact);
}
