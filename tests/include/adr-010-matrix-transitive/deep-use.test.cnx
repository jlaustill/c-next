// test-execution
// test-adr: 010
// ADR-010, the `imported transitive` row of its scope-context matrix.
//
// The same four contexts as `adr-010-matrix-direct`, one hop further away. Kept
// as a separate directory rather than another fixture beside the direct one
// because of #1402: the relationship axis measures the DEEPEST include chain
// reachable from a fixture, so a 2-hop fixture sharing a directory is fine but
// a 2-hop include added to the DIRECT fixture's closure would silently relabel
// every cell it occupies.
//
// This is the row that could not be written at all before #1508: an execution
// fixture reaching a function two hops away failed to LINK, so the context the
// transitive cells describe could not be constructed. CLAUDE.md records that no
// error code has a 2+hop fixture (#1219); this is one structural reason why.
#include "deep-mid.cnx"

DeepReading gDeep;

scope DeepConsumer {
    private DeepReading cached;

    public u32 read() {
        return deepValue();
    }
}

u32 main() {
    gDeep.value <- viaDeep();
    if (gDeep.value != 9) return 1;

    u32 direct <- DeepConsumer.read();
    if (direct != 9) return 2;

    return 0;
}
