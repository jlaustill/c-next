// test-execution
// #1302 / ADR-045: whole-string comparison compiles to strcmp, and the operator
// must come from the OPERATOR, not from a substring search of the whole
// expression's source text.
//
// BinaryExprGenerator did `node.getText().includes("!=")` where `node` is the
// entire comparison, so a string literal CONTAINING "!=" selected inequality.
// `t = "a!=b"` generated `strcmp(t, "a!=b") != 0` -- the condition inverted,
// compiling clean with no warning.
//
// Every case pairs a literal that contains "!=" with one that does not, so a
// fix keying on literal content rather than on the operator still fails here.

i32 main() {
    string<8> withOperator <- "a!=b";
    string<8> plain <- "aXXb";
    i32 hits <- 0;

    // 1: equality TRUE, literal contains "!=" -- the reported defect
    if (withOperator = "a!=b") {
        hits <- hits + 1;
    }
    if (hits != 1) {
        return 1;
    }

    // 2: negative control -- same shape, literal without "!=". Passes today.
    if (plain = "aXXb") {
        hits <- hits + 1;
    }
    if (hits != 2) {
        return 2;
    }

    // 3-4: equality FALSE when genuinely different
    if (withOperator = "different") {
        return 3;
    }
    if (plain = "different") {
        return 4;
    }

    // 5-6: inequality TRUE when genuinely different
    if (withOperator != "different") {
        hits <- hits + 1;
    }
    if (hits != 3) {
        return 5;
    }
    if (plain != "different") {
        hits <- hits + 1;
    }
    if (hits != 4) {
        return 6;
    }

    // 7-8: inequality FALSE when equal, both literal kinds
    if (withOperator != "a!=b") {
        return 7;
    }
    if (plain != "aXXb") {
        return 8;
    }

    return 0;
}
