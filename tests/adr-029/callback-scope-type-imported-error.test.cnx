// test-error
// test-adr: 029
// ADR-029: a callback type declared inside a scope, reached across an
// include, is still checked (#1619 defect 1).
#include "../include/callback-scope-type.cnx"

void notAClock(u32 n) {
    (void)n;
}

u32 aClock() {
    return 0;
}

// NEGATIVE CONTROL -- matching signature: silent.
Clock.Timer ok <- { dueEvery: 0, tick: aClock };

// ASSERTION 1 -- global initializer.
Clock.Timer bad <- { dueEvery: 0, tick: notAClock };

// ASSERTION 2 -- field assignment in a function body.
void main() {
    mut Clock.Timer t;
    t.tick <- notAClock;
}
