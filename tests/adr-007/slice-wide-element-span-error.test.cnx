// test-error
// test-adr: 007
// E0860 on a WIDE-element buffer, where a byte count and an element count are
// different numbers.
//
// ADR-007: "Bounds are checked as an element span: offset + length/elementSize
// <= capacity." Every other fixture here slices a `u8` buffer, where the
// element size is 1 and the two counts coincide -- so mutating the analyzer to
// compare BYTES against a capacity in ELEMENTS reddened nothing at all. That is
// the confusion #1085 was filed for, and it had no integration coverage.
//
// `u16[4]` is 4 elements and 8 bytes, so the two readings disagree here.

u16[4] arr16;

// NEGATIVE CONTROL -- 4 BYTES is 2 elements, and 2 + 2 = 4 is exactly the
// capacity. Read as bytes it would be 2 + 4 = 6 and wrongly rejected, which is
// the in-bounds wide-element slice #1085 found being refused.
u32 inBounds() {
    u32 v <- 0x11223344;
    arr16[2, 4] <- v;
    return 0;
}

u32 main() {
    // 8 bytes is 4 elements; 2 + 4 = 6 exceeds the capacity of 4.
    u64 w <- 0xDEADBEEFDEADBEEF;
    arr16[2, 8] <- w;
    return 0;
}
