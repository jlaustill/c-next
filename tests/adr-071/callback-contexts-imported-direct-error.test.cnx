// test-error
// test-adr: 071
// E0879 across ONE include hop(s), in a scope member initializer, a scope
// method and a top-level function: the callback type `onWrite` takes `mut`
// from its declaration in an included file, so a function whose parameter is
// read-only does not match it. CONTROL: each placement of `writes`, which
// declares `mut`, is silent.

#include "imported-lib.cnx"

void reads(u32 v) {}

void writes(mut u32 v) {
    v <- 1;
}

scope Board {
    Slot wrong <- { handler: reads };
    Slot right <- { handler: writes };
    mut Slot wired;

    public void wire() {
        this.wired.handler <- reads;
        this.wired.handler <- writes;
    }
}

void wire() {
    mut Slot s;
    s.handler <- reads;
    s.handler <- writes;
}
