// test-execution
// test-no-warnings
// test-adr: 030
// test-link: dev_impl.c
// ADR-029 makes a function a type; ADR-030 makes an opaque parameter a pointer.
// The callback typedef is that function's type, so it must say what the
// prototype says. It said `typedef void (*aPoke_fp)(Dev);` beside
// `void aPoke(Dev* d)`: every assignment of the function to its own type was an
// incompatible pointer type, and a call through it passed an incomplete type
// ("formal parameter 1 is incomplete"), while the transpiler exited 0.
//
// An array of handles is an array of pointers (#996), in the typedef too.
//
// Control: a COMPLETE struct parameter keeps ADR-006 reference semantics in its
// typedef -- `const Full*` in C, `const Full&` in C++ -- so the fix is keyed on
// the opaque-handle decision, not on struct-ness. It is checked by the
// assignment alone: under test-no-warnings an incompatible typedef fails the
// build. A call through a callback-typed value is issue-callback-call-args'.
#include "dev.h"
#include "full.h"

void aPoke(Dev d) {
    dev_poke(d);
}

void pokeBoth(Dev[2] ds) {
    dev_poke(ds[0]);
    dev_poke(ds[1]);
}

u32 fullPeek(Full f) {
    return f.pokes;
}

struct Handlers {
    aPoke onDev;
    pokeBoth onBoth;
    fullPeek onFull;
}

i32 main() {
    Handlers h;
    h.onDev <- aPoke;
    h.onBoth <- pokeBoth;
    h.onFull <- fullPeek;

    Dev d <- dev_create();
    h.onDev(d);
    i32 viaHandle <- dev_pokes(d);
    if (viaHandle != 1) {
        return 1;
    }

    Dev[2] pair;
    pair[0] <- dev_create();
    pair[1] <- dev_create();
    h.onBoth(pair);
    i32 first <- dev_pokes(pair[0]);
    if (first != 1) {
        return 2;
    }
    i32 second <- dev_pokes(pair[1]);
    if (second != 1) {
        return 3;
    }

    return 0;
}
