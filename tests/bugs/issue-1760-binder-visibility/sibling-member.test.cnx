// test-execution
// #1760 second review: the binder found a scope member by its C name in the
// whole run, so a member declared in a file this one never includes beat the
// global it does see. `u8[N]` was sized 2 by the sibling's `S.N`, and
// `loc[7]` was a false E0854. A member binds only where its file is visible.
#include "scope-member.cnx"
#include "sees-global.cnx"
#include "sees-member.cnx"

u32 main() {
    u32 fromGlobal <- S.sized();
    if (fromGlobal != 7) {
        return 1;
    }
    u32 fromMember <- S.count();
    if (fromMember != 2) {
        return 2;
    }
    return 0;
}
