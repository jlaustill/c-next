// test-error
// test-adr: 058
// E0897 inside a `for` header's declaration -- the for-header /
// imported-transitive cell of E0897's matrix (#1620): a chain that names a type,
// declared TWO includes away, ends in no length property (`L.Cfg.zz` is no field).

#include "length-scope-struct-relay.cnx"

void loops() {
    // NEGATIVE CONTROL -- a field the type declares has a length.
    for (mut u32 ok <- L.Cfg.data.type_byte_length; ok < 8; ok +<- 1) {}

    // ASSERTION 1 -- E0897: the loop variable's initializer.
    for (mut u32 i <- L.Cfg.zz.type_byte_length; i < 8; i +<- 1) {}
}

u32 main() {
    loops();
    return 0;
}
