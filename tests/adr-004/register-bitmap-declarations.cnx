// Helper (not a test): a PUBLIC scoped register whose member is typed by a
// PRIVATE bitmap. The register's accessor names the bitmap's C typedef, so the
// header that exports the register has to define the bitmap too -- a public
// declaration drags the private type it names into the interface, the same
// way a public function's signature does (#1300).
scope Chip {
    bitmap8 Pins {
        LED,
        BUTTON,
        Reserved[6]
    }

    public register R @ 0x40000000 {
        DR: Pins rw @ 0x00,
        DIR: u8 rw @ 0x04,
    }
}

const u32 CHIP_MARKER <- 1;
