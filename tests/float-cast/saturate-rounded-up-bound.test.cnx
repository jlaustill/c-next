// test-execution
// #1760 review: a float-to-integer saturating cast compares the upper bound
// with `>=`. `(float)UINT32_MAX` rounds up to exactly 2^32, so under `>` a
// value of 2^32 passed the test and reached the raw cast, which is undefined
// behaviour; at an exactly representable maximum both branches give MAX.
f32 edgeU32 <- 4294967296.0;
f32 edgeI32 <- 2147483648.0;

// Negative controls: the largest f32 below each bound converts exactly
f32 belowU32 <- 4294967040.0;
f32 belowI32 <- 2147483520.0;
f32 f255 <- 255.0;

// A call is evaluated once, through the helper form of the same rule
f32 edge() {
    return 4294967296.0;
}

u32 main() {
    u32 a <- (u32)edgeU32;
    if (a != 0xFFFFFFFF) return 1;
    i32 b <- (i32)edgeI32;
    if (b != 2147483647) return 2;
    u32 c <- (u32)belowU32;
    if (c != 4294967040) return 3;
    i32 d <- (i32)belowI32;
    if (d != 2147483520) return 4;
    u8 e <- (u8)f255;
    if (e != 255) return 5;
    u32 h <- (u32)edge();
    if (h != 0xFFFFFFFF) return 6;
    return 0;
}
