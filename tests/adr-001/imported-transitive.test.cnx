// test-execution
// test-adr: 001
// ADR-001: `<-` assigns and `=` compares, exercised in all four structural
// contexts at include depth 2 (two hops).
//
// Falsifiability: every `=` here is a comparison that must evaluate FALSE, and
// each is followed by a check that its left operand is unchanged. Left as C's
// assignment, the branch would be truthy AND would overwrite the target, so a
// regression fails both ways instead of reading as a pass.

#include "adr-001-relay.cnx"

// The two file-scope initializers below use a LOCAL pair, not the imported one.
// A cross-file const emits `extern const`, which is not a constant expression
// in C, so a file-scope initializer built from it does not compile (#1218).
// That is orthogonal to ADR-001, and the imported consts are still exercised by
// the same `=` decision inside the function bodies, where C allows it.
const u8 LOCAL_FIVE <- 5;
const u8 LOCAL_ALSO_FIVE <- 5;

// global-variable context.
bool gEqual <- LOCAL_FIVE = LOCAL_ALSO_FIVE;

scope Cfg {
    // scope-member context.
    public bool mEqual <- LOCAL_FIVE = LOCAL_ALSO_FIVE;

    // scope-method context, comparing a value that crossed the boundary.
    public u32 check() {
        u8 seen <- 0;
        seen <- FIVE;
        u32 i <- 0;
        for (i <- 0; i < 1; i +<- 1) {
            seen <- seen + FIVE;
        }
        if (seen = SIX) return 8;
        if (seen != 10) return 9;
        return 0;
    }
}

// top-level-function context. `ALSO_FIVE` crossed two hops, `SIX` one.
u32 main() {
    u8 count <- 0;
    count <- ALSO_FIVE;
    count +<- ALSO_FIVE;

    if (gEqual != true) return 1;
    if (Cfg.mEqual != true) return 2;

    if (count = SIX) return 3;
    if (count != 10) return 4;

    u32 checked <- Cfg.check();
    if (checked != 0) return 5;
    return 0;
}
