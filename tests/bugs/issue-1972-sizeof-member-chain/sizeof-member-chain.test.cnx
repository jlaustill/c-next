// test-execution
// Issue #1972: a dotted member access is measured the way the same expression
// reads everywhere else. `sizeof`'s resolver once rebuilt it from its first
// two names (`shared.inner` for `shared.inner.x`, `w.v` for a pointer local,
// `S__cfg__b`, `GPIO.DR`); since #1975 the size is ADR-058's `.type_byte_length`,
// read from the same chain as the value. Each is checked against the width
// of the type the ordinary expression reads.
#include "widget.h"

struct Inner {
    u8 x;
    u32 y;
}

struct Outer {
    u8 tag;
    Inner inner;
}

struct Pair {
    u8 a;
    u32 b;
}

register GPIO @ 0x40000000 {
    DR: u32 rw @ 0x00,
}

scope S {
    public Pair cfg;
}

Outer shared;

u32 main() {
    u32 nested <- shared.inner.x.type_byte_length;
    if (nested != u8.type_byte_length) {
        return 1;
    }
    u8 nestedValue <- shared.inner.x;
    if (nestedValue != 0) {
        return 2;
    }

    widget_t w <- widget_get();
    u32 pointed <- w.v.type_byte_length;
    if (pointed != u32.type_byte_length) {
        return 3;
    }
    u32 pointedValue <- w.v;
    if (pointedValue != 5) {
        return 4;
    }

    u32 scoped <- S.cfg.b.type_byte_length;
    if (scoped != u32.type_byte_length) {
        return 5;
    }
    u32 scopedValue <- S.cfg.b;
    if (scopedValue != 0) {
        return 6;
    }

    u32 registerSize <- GPIO.DR.type_byte_length;
    if (registerSize != u32.type_byte_length) {
        return 7;
    }
    return 0;
}
