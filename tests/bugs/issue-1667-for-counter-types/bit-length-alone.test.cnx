// test-execution
// #1667 probe 1: a `for` counter's width is its own declaration. It was never
// recorded, so `.bit_length` on it found no type and code generation failed
// at 1:0 with an internal error.
u32 probe() {
    u32 w <- 0;
    for (u8 k <- 0; k < 3; k <- k + 1) {
        w <- k.bit_length;
    }
    return w;
}

u32 main() {
    u32 width <- probe();
    if (width != 8) {
        return 1;
    }
    return 0;
}
