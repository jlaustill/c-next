// test-error
// test-adr: 004
// #1514 negative control: a bitmap is a bitmap where its file is included.
// `Deep` is declared in lib/deep.cnx, which nothing here includes (periph
// includes only bitmaps), so a register member cannot be typed by it.

#include "lib/periph.cnx"

register OREG @ 0x40008000 {
    D: Deep rw @ 0x00,
}

void main() {
    OREG.D.A <- true;
}
