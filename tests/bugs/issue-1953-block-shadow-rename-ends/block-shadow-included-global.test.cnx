// test-execution
// test-adr: 057
// Issue #1953: a block-local that shadows a global declared in an INCLUDED file
// is renamed only inside its block, and the global stays reachable after it

#include "outer-buf.cnx"

u32 main() {
    u32 flag <- 1;
    if (flag = 1) {
        u8[8] shared <- [0, 0, 0, 0, 0, 0, 0, 0];
        if (sizeof(shared) != 8) return 1;
        if (global.shared[0] != 1) return 2;
    }
    if (sizeof(shared) != 4) return 3;
    if (shared[3] != 4) return 4;
    return 0;
}
