// test-execution
// Tests .type_bit_length property for bool type (ADR-058)
// Bool storage size is 8 bits (1 byte)

bool globalBool <- true;

scope BoolBitLen {
    public struct TestStruct {
        bool flag;
    }
}

i32 main() {
    // A bool's type length is 1 bit; its storage is the memory row (ADR-058)
    if (globalBool.memory_bit_length != 8) {
        return 10;
    }
    if (globalBool.type_bit_length != 1) {
        return 1;
    }

    // Test local bool
    bool localBool <- false;
    if (localBool.type_bit_length != 1) {
        return 2;
    }

    // Test struct member
    BoolBitLen.TestStruct ts;
    ts.flag <- true;
    if (ts.flag.type_bit_length != 1) {
        return 3;
    }

    return 0;
}
