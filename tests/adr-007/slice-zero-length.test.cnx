// test-error
// test-adr: 007
// Tests: Issue #234 - Zero-length slice assignment is a compile-time error
// Slice assignment length must be positive.

// NEGATIVE CONTROL -- the smallest length a slice may have. 0 is rejected; 1
// is the boundary and must be accepted.
u32 oneByte() {
    u8[8] ok;
    ok[0, 1] <- 1;
    return 0;
}

u32 main() {
    u8[64] buffer;

    // Zero-length copy should fail at compile time
    u32 dummy <- 0xAABBCCDD;
    buffer[0, 0] <- dummy;

    return 0;
}
