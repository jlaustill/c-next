// test-error
// test-adr: 017
// Tests: Unqualified enum value in non-enum return type should error

enum Color {
    RED <- 0,
    GREEN <- 1,
    BLUE <- 2
}

// NEGATIVE CONTROL -- returned from a function OF the enum's type.
Color pick() {
    return RED;
}

// Return type is u8, not Color - unqualified enum should be rejected
u8 getColorValue() {
    return RED;
}
