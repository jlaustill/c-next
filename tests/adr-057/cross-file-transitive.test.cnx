// test-execution
// test-adr: 057, 016
// ADR-057 resolution two hops from the provider (imported transitive).
//
// The companion to cross-file-direct: same rule, one include deeper. The
// relationship axis takes the DEEPEST chain reachable from the fixture, so this
// file must reach `cross-file-provider.cnx` through `cross-file-middle.cnx`
// rather than including it directly -- an include added here would collapse the
// chain and silently move the fixture back into the `direct` column.

#include "cross-file-middle.cnx"

scope Report {
    u32 tally <- 0;
    u32 weight <- 5;

    // #1241: a scope MEMBER declaration whose initializer resolves a bare name
    // (scope-member context, as distinct from the scope-method cases above).
    const u32 SEED <- 3;
    u32 primed <- SEED;

    u32 factor() {
        return weight;
    }

    public void add(u32 sample) {
        // Bare `tally`, `weight` and `factor()` resolving scope-first, in a
        // fixture two includes away from where `Sensor` is declared.
        tally <- tally + factor() + sample;
    }

    public u32 readTally() {
        return tally;
    }
}

// A top-level function with a shadowing local: ADR-057 with no enclosing scope,
// in a fixture that reaches another file. `shadow-outside-any-scope` covers this
// same-file; the include boundary is a separate matrix column.
u32 spare <- 40;

u32 detached() {
    u32 spare <- 6;
    return spare;
}

u32 main() {
    // Only the DIRECT include is called: the two-hop provider is reached by the
    // include graph, which is what places this fixture on the relationship axis,
    // not by a call. Calling through it would need the harness to link a
    // transitive translation unit, which is a separate concern from ADR-057.
    u32 smoothed <- Filter.smooth(1);
    if (smoothed != 3) return 1;

    Report.add(2);
    u32 tally <- Report.readTally();
    if (tally != 7) return 2;

    u32 detachedValue <- detached();
    if (detachedValue != 6) return 3;
    if (spare != 40) return 4;

    return 0;
}
