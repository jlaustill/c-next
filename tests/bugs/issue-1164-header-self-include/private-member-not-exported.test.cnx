// test-execution
// Issue #1164: the fix must not over-expose.
//
// PublicInterface excludes scope containers, which emit no header content of
// their own, so a scope contributes to the header only through its members.
// A private member must stay out of it and keep internal linkage, while a
// public one is exported -- the visibility filter still decides, and only the
// container-vs-declaration question changed.
//
// (A scope whose members are ALL private, which produced a header holding only
// include guards, is covered in HeaderEmissionDecision.test.ts -- such a scope
// is unreachable from main, so it cannot be an execution test.)
scope Internal {
    private u8 helper() {
        return 7;
    }

    public u8 callHelper() {
        return this.helper();
    }
}

u32 main() {
    u8 result <- Internal.callHelper();
    if (result != 7) return 1;
    return 0;
}
