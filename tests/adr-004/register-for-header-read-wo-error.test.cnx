// test-error
// test-adr: 004
// ADR-004, E0870: a write-only (`wo`) register member read in a `for` header's
// declaration -- the `for header` / `same file` cell of ADR-004's matrix.
//
// The loop variable's initializer is an expression like any other, so a read
// of a `wo` member there returns nothing meaningful just as it would in the
// loop's body.

register LOOP_REG @ 0x40000000 {
    CTRL: u32 rw @ 0x00,
    STATUS: u32 ro @ 0x04,
    COMMAND: u32 wo @ 0x08,
}

// NEGATIVE CONTROL -- the same `for` header reading the rw and ro members.
void okReads() {
    for (mut u32 i <- LOOP_REG.CTRL; i < 3; i <- i + 1) {}
    for (mut u32 j <- LOOP_REG.STATUS; j < 3; j <- j + 1) {}
}

// ASSERTION 1 -- a `for` header in a top-level function.
void main() {
    for (mut u32 i <- LOOP_REG.COMMAND; i < 3; i <- i + 1) {}
}

scope Board {
    // ASSERTION 2 -- a `for` header in a scope method.
    public void scan() {
        for (mut u32 i <- global.LOOP_REG.COMMAND; i < 3; i <- i + 1) {}
    }
}
