// test-execution
// #1660: a write through `this.<member>.<field>[i]` writes that field. It
// dropped `.field` and wrote the whole struct -- a bit write on `S__local`,
// which gcc rejects -- and turned the element write into a bit write too.
// Fixed on #1668's branch: the target's final subscript is the typer's kind
// (C12b), and a bit write's base is rendered by the target's own renderer.
struct Cfg {
    u8[4] data;
    u32 flags;
}

scope S {
    Cfg local;

    public void run() {
        this.local.flags[4] <- true;
        this.local.data[1] <- 3;
    }

    public bool flag() {
        bool v <- this.local.flags[4];
        return v;
    }

    public u8 element() {
        return this.local.data[1];
    }
}

u32 main() {
    S.run();
    bool f <- S.flag();
    if (f != true) {
        return 1;
    }
    u8 e <- S.element();
    if (e != 3) {
        return 2;
    }
    return 0;
}
