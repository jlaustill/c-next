// test-execution
// test-adr: 014
// ADR-014 / #895 (#1530 review): a cnx function used as a C callback whose
// typedef takes the struct by value has a by-value parameter in C as well, so
// a struct argument goes to it by value -- a literal as `(VPt){ ... }`, not
// `&(VPt){ ... }`, and a variable as itself, not `&a`. The call reads the
// typedef's answer, the one the signature is written from. A call through an
// ADR-029 `vhandler` value does not: `vhandler_fp` is built from the
// declaration, so it takes a pointer and the argument goes by address.

#include "lib/struct-literal-callback-types.h"

u32 vhandler(VPt p) {
    return p.x + p.y;
}

u32 other(VPt p) {
    return p.x * p.y;
}

u32 fire(vhandler cb) {
    VPt a <- { x: 3, y: 4 };
    u32 byVariable <- cb(a);
    u32 byLiteral <- cb({ x: 5, y: 6 });
    return byVariable + byLiteral;
}

u32 main() {
    global.set_vcb(vhandler);

    // A literal argument to a by-value callback parameter
    u32 w <- vhandler({ x: 3, y: 4 });
    if (w != 7) {
        return 1;
    }

    // A variable argument to a by-value callback parameter
    VPt a <- { x: 10, y: 20 };
    u32 v <- vhandler(a);
    if (v != 30) {
        return 2;
    }

    // Through a callback value: other(3,4) + other(5,6) = 12 + 30
    u32 f <- fire(other);
    if (f != 42) {
        return 3;
    }

    return 0;
}
