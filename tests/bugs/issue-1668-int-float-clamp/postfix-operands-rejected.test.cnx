// test-error
// test-adr: 024
// Issue #1668, folding in #1092 item 1: E0810 classifies an operand by its
// declared type whatever the path to it -- a struct field, an array element, a
// call result (a member after a call, an ADR-029 callback), a scope member, a
// cast, and a ternary's value arms. Before, each of these contributed no
// category and the mix compiled; the integer x float ones also reached an
// integer clamp helper, and `u8 x <- arr[0] * 2.5` was rejected only by
// accident, as "Cannot assign u32 to u8".
// The functions after the flagged ones are negative controls and must stay silent.

struct Sample {
    f32 v;
    i32 offset;
    u32 count;
}

struct Scaler {
    scaleFn fn;
}

f32 half() {
    return 2.5;
}

i32 minusOne() {
    return -1;
}

f32 scaleFn() {
    return 2.5;
}

Sample makeSample() {
    Sample s <- { v: 2.5, offset: -1, count: 3 };
    return s;
}

atomic u32 counter <- 3;

scope Gauge {
    u32 value <- 3;

    public f32 scaled() {
        return this.value * 2.5;
    }

    public void scaleBy(f32 k) {
        this.value *<- k;
    }
}

u8 elementTimesLiteral() {
    u32[1] arr <- [3];
    u8 x <- arr[0] * 2.5;
    return x;
}

u8 unsignedTimesField(Sample p) {
    u32 i <- 3;
    u8 x <- i * p.v;
    return x;
}

f32 unsignedTimesCall() {
    u32 i <- 3;
    f32 x <- i * half();
    return x;
}

f32 unsignedTimesMemberAfterCall() {
    u32 i <- 3;
    f32 x <- i * makeSample().v;
    return x;
}

f32 unsignedTimesCallback(Scaler s) {
    u32 i <- 3;
    f32 x <- i * s.fn();
    return x;
}

f32 castTimesUnsigned(u32 j) {
    u32 i <- 3;
    f32 x <- (f32)i * j;
    return x;
}

f32 ternaryFloatArm(f32 k) {
    u32 i <- 3;
    f32 x <- ((i > 0) ? k : k) * i;
    return x;
}

u32 compoundIntoElement() {
    u32[1] arr <- [3];
    arr[0] *<- 2.5;
    return arr[0];
}

u32 compoundSignedIntoField() {
    Sample s <- { v: 2.5, offset: -1, count: 3 };
    s.count +<- s.offset;
    return s.count;
}

void atomicTimesField(Sample p) {
    counter *<- p.v;
}

u32 unsignedPlusSignedElement() {
    i32[2] sarr <- [1, 2];
    u32 a <- 5;
    u32 r <- a + sarr[0];
    return r;
}

u32 unsignedPlusSignedField(Sample p) {
    u32 a <- 5;
    u32 r <- a + p.offset;
    return r;
}

u32 unsignedPlusSignedCall() {
    u32 a <- 5;
    u32 r <- a + minusOne();
    return r;
}

u32 bitExtraction(i32 b) {
    u32 a <- 5;
    u32 r <- a + b[0, 32];
    return r;
}

u32 sameCategoryElement() {
    u32[1] arr <- [3];
    u32 a <- 5;
    u32 r <- a + arr[0];
    return r;
}

f32 floatFieldTimesLiteral(Sample p) {
    f32 x <- p.v * 2.5;
    return x;
}

f32 castThenField(Sample p) {
    u32 i <- 3;
    f32 x <- (f32)i * p.v;
    return x;
}

u32 signedOnlyInCondition(i32 s) {
    u32 i <- 3;
    u32 j <- 4;
    u32 x <- ((s > 0) ? i : j) + i;
    return x;
}
