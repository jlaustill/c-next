// test-execution
// test-no-warnings
// Tests: #2239 - a concatenation or a substring passed to a string<N> parameter is built into a string<N> first; a whole-string argument is the control
scope S {
    string<4> m <- "mn";
    public u32 take(string<8> s) {
        if (s = "abcd") {
            return 1;
        }
        if (s = "b") {
            return 2;
        }
        if (s = "mnab") {
            return 3;
        }
        return 0;
    }
    public u32 run() {
        string<4> a <- "ab";
        string<4> b <- "cd";
        u32 r1 <- this.take(a + b);
        if (r1 != 1) {
            return 1;
        }
        u32 r2 <- this.take(a[1, 1]);
        if (r2 != 2) {
            return 2;
        }
        u32 r3 <- this.take(this.m + a);
        if (r3 != 3) {
            return 3;
        }
        u32 r4 <- this.take(a);
        if (r4 != 0) {
            return 4;
        }
        return 0;
    }
}
u32 main() {
    return S.run();
}
